<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>nl2protocol report — {{ timestamp }}</title>
<style>
  /* ───────── Layout ───────── */
  :root {
    --col-instruction: #e63946;   /* vivid red, arrow color */
    --col-config:      #9d4edd;   /* purple, reserved for labware-resolver viz */
    --col-domain:      #ffb703;   /* gold */
    --col-inferred:    #fb8500;   /* orange */
    --bg:              #fdf6e3;   /* warm off-white */
    --panel:           #ffffff;
    --ink:             #1a1a1a;
    --dim:             #6b6b6b;
    --grid:            #e5e0d4;

    /* Per-citation palette (8 vivid, distinguishable hues). Each unique
       cited_text in the instruction hashes to one slot; both the cite
       span (instruction column) and the atomic value span (spec column)
       share the hue. Saturated for legibility against the off-white
       background — designed to be picked out at a glance. */
    --palette-0: #c1272d;   /* deep red */
    --palette-1: #e76f1c;   /* burnt orange */
    --palette-2: #c79100;   /* mustard */
    --palette-3: #4f8a2b;   /* leaf green */
    --palette-4: #168a8a;   /* teal */
    --palette-5: #1f5fa6;   /* deep blue */
    --palette-6: #5d3fa8;   /* indigo */
    --palette-7: #b62f7a;   /* magenta */
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", sans-serif;
  }
  header {
    padding: 24px 32px 16px;
    border-bottom: 1px solid var(--grid);
  }
  header h1 {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 600;
  }
  header .meta {
    color: var(--dim);
    font-size: 13px;
  }
  .legend {
    display: flex; gap: 18px; margin-top: 12px; flex-wrap: wrap;
    font-size: 12px;
  }
  .legend .swatch {
    display: inline-block; width: 12px; height: 12px;
    border-radius: 2px; margin-right: 6px; vertical-align: middle;
  }

  /* ───────── 5-column grid ─────────
     Per ADR-0011 Phase 2a, the report renders five columns matching the
     pipeline's user-visible transformation milestones:
       1. Instruction
       2. Extracted Spec (post-extraction, immutable LLM output)
       3. Resolved Spec  (post-orchestrator gap resolution)
       4. Validated Spec (post-stage-5 CompleteProtocolSpec promotion)
       5. Generated Python
     Column 3 + column 4 are visually similar — both render provenanced
     spec values — but encode different stages of the pipeline. Phase 2b
     adds cross-column arrows showing each value's resolution journey. */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1.15fr 1.15fr 1.4fr;
    gap: 14px;
    padding: 24px 32px;
    min-height: calc(100vh - 200px);
  }
  .col {
    background: var(--panel);
    border: 1px solid var(--grid);
    border-radius: 6px;
    padding: 16px;
    overflow-y: auto;
    max-height: 80vh;
  }
  .col h2 {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
    border-bottom: 1px solid var(--grid);
    padding-bottom: 8px;
  }

  /* ───────── Provenance color spans ─────────
     Two visual languages must NOT compete:
       - per-citation color → atomic instruction-sourced values; the same
                              hue lights both the cite span in the instruction
                              and the value span in the spec, so readers
                              connect them by hue rather than by arrow.
       - dotted underline   → values filled in by the model (domain_default
                              / inferred / config). Color stays categorical
                              by source kind. The underline tells readers
                              "this isn't a literal lift from the user."
       - arrow              → composite (step-existence) grounding only. */
  .prov-instruction    { font-weight: 500; cursor: help; /* hue comes from .palette-N */ }
  .prov-config         { color: var(--col-config);      font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }
  .prov-domain_default { color: var(--col-domain);      font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }
  .prov-inferred       { color: var(--col-inferred);    font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }

  /* ▴ marker prepended to non-instruction atomic values, repeated in the
     legend. Visual at-a-glance shorthand: "this value isn't a literal lift
     from the user — the model filled it in." Sized large enough to spot
     at column-scan distance, colored with --col-inferred so it reads as
     "model-filled" without any palette context. */
  .non-instr-marker {
    display: inline-block;
    margin-right: 4px;
    font-size: 14px;
    line-height: 1;
    color: var(--col-inferred);
    transform: translateY(1px);
  }

  /* ───────── Review-lifecycle badges (ADR-0009) ─────────
     The Provenance carries `review_status` (original / reviewed_agree /
     reviewed_disagree / user_confirmed / user_edited /
     user_accepted_suggestion / user_skipped). Only the two
     attention-worthy states get an inline badge; everything else surfaces
     in the tooltip.

       reviewed_disagree → red ⚠ superscript ("the reviewer pushed back here")
       user_edited       → blue ✎ marker     ("the user touched this value")

     Other non-default states (reviewed_agree, user_accepted_suggestion,
     user_confirmed, user_skipped) get the prov-review-* class for tooltip
     consumers but no inline glyph — they're positive/passive states and
     don't deserve column-scan attention. */
  .prov-review-reviewed-disagree::after {
    content: "⚠";
    margin-left: 3px;
    font-size: 10px;
    color: var(--col-instruction);
    vertical-align: super;
    font-weight: 700;
  }
  .prov-review-user-edited::after {
    content: "✎";
    margin-left: 3px;
    font-size: 11px;
    color: #1f5fa6;
    vertical-align: baseline;
  }

  /* ───────── Per-citation palette ─────────
     `.palette-N` paints the text for both:
       - .cite-marker.cite-atomic-color in the instruction column
       - .prov-instruction value spans in the spec column
     Same hue on both sides == same cited_text on both sides. */
  .palette-0 { color: var(--palette-0); }
  .palette-1 { color: var(--palette-1); }
  .palette-2 { color: var(--palette-2); }
  .palette-3 { color: var(--palette-3); }
  .palette-4 { color: var(--palette-4); }
  .palette-5 { color: var(--palette-5); }
  .palette-6 { color: var(--palette-6); }
  .palette-7 { color: var(--palette-7); }

  /* Hover-flip: when a cite-marker becomes "cite-active" (because the
     reader is hovering its matching value-span in the spec column), the
     cite span fills with its palette color and the text flips to a
     hardcoded contrast shade (white for dark hues, ink for light hues).
     The flip is done by overriding text color and adding a strong bg
     of the same palette hue. Per-palette contrast is hardcoded — chosen
     once for legibility, not computed. */
  .cite-marker.cite-atomic-color.palette-0.cite-active { background: var(--palette-0); color: #fff; }
  .cite-marker.cite-atomic-color.palette-1.cite-active { background: var(--palette-1); color: #fff; }
  .cite-marker.cite-atomic-color.palette-2.cite-active { background: var(--palette-2); color: #1a1a1a; }
  .cite-marker.cite-atomic-color.palette-3.cite-active { background: var(--palette-3); color: #fff; }
  .cite-marker.cite-atomic-color.palette-4.cite-active { background: var(--palette-4); color: #fff; }
  .cite-marker.cite-atomic-color.palette-5.cite-active { background: var(--palette-5); color: #fff; }
  .cite-marker.cite-atomic-color.palette-6.cite-active { background: var(--palette-6); color: #fff; }
  .cite-marker.cite-atomic-color.palette-7.cite-active { background: var(--palette-7); color: #fff; }

  /* ───────── Instruction column ───────── */
  .instruction-text {
    white-space: pre-wrap;
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: 14px;
    line-height: 1.6;
  }

  /* ───────── Spec / step rendering ───────── */
  .step {
    margin-bottom: 14px;
    padding: 10px 12px;
    border-left: 3px solid transparent;
    background: rgba(0, 0, 0, 0.015);
    border-radius: 0 4px 4px 0;
  }
  .step.step-orphan { border-left-color: var(--col-inferred); background: rgba(251, 133, 0, 0.05); }
  .step.step-grounded-instruction { border-left-color: var(--col-instruction); }
  .step.step-grounded-mixed { border-left-color: var(--col-domain); }
  .step-header {
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 6px;
    font-style: italic;
    cursor: help;
  }
  .step-action {
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--ink);
  }
  .step-detail {
    margin-left: 12px;
    font-size: 13px;
    color: #333;
  }
  .step-detail .label { color: var(--dim); margin-right: 4px; }
  /* Footnote inside a step block — used for the `note` field on
     pause/comment steps so the body isn't empty. Small, dim, italic. */
  .step-note {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px dashed var(--grid);
    font-size: 11px;
    font-style: italic;
    color: var(--dim);
    line-height: 1.4;
  }
  /* Step blocks are themselves hoverable — the JS tooltip surfaces
     the justification + optional domain expansion. */
  .step { cursor: help; }

  /* ───────── Code column ───────── */
  pre.code {
    margin: 0;
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, "Courier New", monospace;
    font-size: 12px;
    line-height: 1.45;
    white-space: pre;
    overflow-x: auto;
    color: #1a1a1a;
  }

  /* ───────── Cite markers in instruction ─────────
     Three cite kinds, three treatments:
       composite-step  → arrow ANCHOR. Subtle underline (muted red) at
                         rest, brightens on hover; pairs with the SVG
                         arrow into the step block. Multiple step cites
                         can share one anchor (fan-out arrows).
       atomic-color    → COLOR MATCH. The .palette-N class on the same
                         span paints the substring the same hue as the
                         atomic value in the spec column — no arrow.
       q2-cohesion     → ON-HOVER hint. Invisible at rest; tints when
                         its step block is hovered, showing which
                         instruction fragments answer "why these
                         parameters cohere as one step." */
  .cite-marker {
    cursor: pointer;
    padding: 0 1px;
    transition: background 0.12s, border-color 0.12s;
  }
  .cite-composite-step {
    background: rgba(184, 68, 79, 0.05);
    border-bottom: 2px solid rgba(184, 68, 79, 0.45);
  }
  .cite-composite-step:hover,
  .cite-composite-step.cite-active {
    background: rgba(184, 68, 79, 0.18);
    border-bottom-color: rgba(184, 68, 79, 0.85);
  }
  .cite-atomic-color {
    /* color comes from the .palette-N class on the same span */
    font-weight: 500;
  }
  .cite-atomic-color:hover,
  .cite-atomic-color.cite-active {
    background: rgba(0, 0, 0, 0.06);
    border-radius: 2px;
  }
  .cite-q2-cohesion {
    /* deliberately unstyled at rest — reads as plain prose */
    transition: background 0.15s;
  }
  .cite-q2-cohesion.q2-active {
    background: rgba(184, 68, 79, 0.10);
    border-radius: 2px;
  }
  .step.step-active {
    background: rgba(184, 68, 79, 0.06);
    border-left-color: var(--col-instruction);
  }
  span[data-prov-id]:hover,
  span[data-prov-id].prov-active {
    outline: 1px solid currentColor;
    outline-offset: 1px;
    border-radius: 2px;
  }

  /* ───────── ADR-0011 Phase 2b/4 polish: hover-flip on value cells ─────────
     Mirrors the cite-side `.cite-marker.cite-atomic-color.palette-N.cite-active`
     pattern from above. When a value cell is hovered (or panel-row hover
     marks it .prov-active), the cell fills with its color and the text
     flips to white/black for contrast. Same visual language on both
     sides of the cite ↔ value pair. */
  span.palette-0.prov-active, span.palette-0[data-prov-id]:hover { background: var(--palette-0); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-1.prov-active, span.palette-1[data-prov-id]:hover { background: var(--palette-1); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-2.prov-active, span.palette-2[data-prov-id]:hover { background: var(--palette-2); color: #1a1a1a;  outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-3.prov-active, span.palette-3[data-prov-id]:hover { background: var(--palette-3); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-4.prov-active, span.palette-4[data-prov-id]:hover { background: var(--palette-4); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-5.prov-active, span.palette-5[data-prov-id]:hover { background: var(--palette-5); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-6.prov-active, span.palette-6[data-prov-id]:hover { background: var(--palette-6); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-7.prov-active, span.palette-7[data-prov-id]:hover { background: var(--palette-7); color: #fff;     outline: none; text-decoration: none; border-radius: 2px; }

  /* Non-instruction sources without palette: use their categorical hue. */
  span.prov-config.prov-active,         span.prov-config[data-prov-id]:hover         { background: var(--col-config);      color: #fff;    outline: none; text-decoration: none; border-radius: 2px; }
  span.prov-domain_default.prov-active, span.prov-domain_default[data-prov-id]:hover { background: var(--col-domain);      color: #1a1a1a; outline: none; text-decoration: none; border-radius: 2px; }
  span.prov-inferred.prov-active,       span.prov-inferred[data-prov-id]:hover       { background: var(--col-inferred);    color: #fff;    outline: none; text-decoration: none; border-radius: 2px; }

  /* Instruction-sourced spans WITHOUT a palette (cite not recoverable):
     fall back to instruction-red. Spans WITH a palette take the palette
     rules above (later in the cascade with the same specificity, so
     palette wins by source order). */
  span.prov-instruction.prov-active,    span.prov-instruction[data-prov-id]:hover    { background: var(--col-instruction); color: #fff;    outline: none; text-decoration: none; border-radius: 2px; }

  /* ───────── ADR-0011 Phase 2b/4 polish: ✗ placeholder cells ─────────
     For action-expected fields that are null on the step, the renderer
     emits a placeholder carrying a matching data-prov-id. This gives
     resolution arrows their origin anchor (extracted column has the ✗,
     resolved column has the filled value, arrow draws between them)
     and gives panel-row hover a target in both columns. */
  .cell-empty {
    color: var(--dim);
    font-style: italic;
    font-size: 11px;
    cursor: help;
    padding: 0 2px;
  }
  .cell-empty em {
    font-size: 10px;
  }
  .cell-empty.prov-active,
  .cell-empty[data-prov-id]:hover {
    background: rgba(184, 68, 79, 0.08);
    border-radius: 2px;
    outline: 1px solid rgba(184, 68, 79, 0.35);
    outline-offset: 1px;
  }

  /* ───────── JS hover tooltip (replaces native title=) ───────── */
  #hover-tip {
    position: fixed;
    z-index: 100;
    max-width: 360px;
    padding: 10px 12px;
    background: #2a2a2a;
    color: #f5f5f5;
    font-size: 12px;
    line-height: 1.45;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s ease;
    white-space: normal;
  }
  #hover-tip.visible { opacity: 1; }
  #hover-tip .tip-meta {
    color: #b8b8b8;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  #hover-tip .tip-cite {
    font-style: italic;
    color: #ffd9c2;
    margin-bottom: 6px;
  }
  #hover-tip .tip-reasoning { color: #f0f0f0; }
  #hover-tip .tip-section { margin-top: 8px; }
  /* Indented blockquote of the step's cited text. The left bar uses the
     step-trigger color (vivid red for instruction grounding) so readers
     see "this is the literal phrase that triggered the step" without
     needing the inline cite-id attr. */
  #hover-tip .tip-quote {
    margin: 8px 0 0;
    padding: 4px 0 4px 10px;
    border-left: 3px solid var(--col-instruction);
    color: #ffd9c2;
    font-style: italic;
    line-height: 1.4;
  }
  /* When step_palette_class is set, the left bar takes that hue. */
  #hover-tip .tip-quote.palette-0 { border-left-color: var(--palette-0); }
  #hover-tip .tip-quote.palette-1 { border-left-color: var(--palette-1); }
  #hover-tip .tip-quote.palette-2 { border-left-color: var(--palette-2); }
  #hover-tip .tip-quote.palette-3 { border-left-color: var(--palette-3); }
  #hover-tip .tip-quote.palette-4 { border-left-color: var(--palette-4); }
  #hover-tip .tip-quote.palette-5 { border-left-color: var(--palette-5); }
  #hover-tip .tip-quote.palette-6 { border-left-color: var(--palette-6); }
  #hover-tip .tip-quote.palette-7 { border-left-color: var(--palette-7); }
  /* Reviewer-objection box uses the instruction-red bar to signal "flagged
     concern, attention needed" — distinct from the step-blockquote palettes. */
  #hover-tip .tip-objection {
    margin: 8px 0 0;
    padding: 4px 0 4px 10px;
    border-left: 3px solid var(--col-instruction);
    color: #ffd9c2;
    font-style: italic;
    line-height: 1.4;
  }

  /* ───────── SVG arrow overlay ─────────
     The overlay hosts TWO arrow categories:
       - Composite-step arrows (instruction → extracted spec block).
         Reserved for step-existence grounding; existing pre-Phase-2b
         language. Default red (--col-instruction).
       - Resolution arrows (extracted spec atomic value → resolved
         spec atomic value). One per gap_resolved event with a
         drawable resolution_kind. Per ADR-0011 Phase 2b. Color-coded
         per resolution kind. */
  #arrow-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 50;
  }
  #arrow-overlay path {
    fill: none;
    stroke: var(--col-instruction);
    stroke-opacity: 0.32;
    stroke-width: 2.5;
    transition: stroke-opacity 0.12s, stroke-width 0.12s;
  }
  #arrow-overlay path.arrow-active {
    stroke-opacity: 0.9;
    stroke-width: 3.5;
  }

  /* Resolution arrows (extracted → resolved column).
     Color encodes how the gap was resolved:
       auto_accepted             → subtle green   (no human attention needed)
       user_accepted_suggestion  → gray-green     (human confirmed the suggester)
       user_edited               → blue           (human typed a new value)
       user_confirmed            → soft gray      (human confirmed without change)
     Stroke width slightly thinner than composite-step arrows so the
     two categories visually separate. */
  #arrow-overlay path.resolution-arrow {
    stroke-width: 2;
    stroke-opacity: 0.35;
  }
  #arrow-overlay path.resolution-arrow.arrow-active {
    stroke-opacity: 0.9;
    stroke-width: 3;
  }
  #arrow-overlay path.res-auto_accepted            { stroke: #4f8a2b; }  /* leaf green */
  #arrow-overlay path.res-user_accepted_suggestion { stroke: #6b8e3d; }  /* gray-green */
  #arrow-overlay path.res-user_edited              { stroke: #1f5fa6; }  /* deep blue */
  #arrow-overlay path.res-user_confirmed           { stroke: #6b6b6b; }  /* dim gray */

  /* ───────── ADR-0011 Phase 2c: confirmation summary panels ─────────
     Two read-only audit tables rendered below the 5-col grid:
       Lab state  (initial_contents + prefilled_labware as a flat table)
       Labware    (description → resolved_label deduped mapping)
     Replay-mode static surfaces. Live mode (Phase 3) replaces these
     with the editable bottom-right floating panel; same data shape,
     different positioning + interactivity. */
  .panels {
    padding: 0 32px 24px;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 18px;
  }
  .panel {
    background: var(--panel);
    border: 1px solid var(--grid);
    border-radius: 6px;
    padding: 14px 16px;
  }
  .panel h3 {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
    border-bottom: 1px solid var(--grid);
    padding-bottom: 6px;
  }
  .panel table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .panel th, .panel td {
    text-align: left;
    padding: 4px 8px;
    border-bottom: 1px dotted var(--grid);
  }
  .panel th {
    color: var(--dim);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .panel td.col-volume {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    text-align: right;
    color: #1a1a1a;
  }
  .panel td.col-substance,
  .panel td.col-description {
    font-style: italic;
    color: #1a1a1a;
  }
  .panel td.col-label {
    font-weight: 500;
    color: #1a1a1a;
  }
  .panel .empty {
    color: var(--dim);
    font-style: italic;
    padding: 4px 0;
  }
  /* Phase 4 polish: row hover for cross-column highlighting. The row
     becomes a hover target that lights up cells in the spec columns
     via the existing data-prov-id system. */
  .panel tbody tr[data-target-cells]:hover,
  .panel tbody tr.row-active {
    background: rgba(184, 68, 79, 0.06);
    cursor: help;
  }

  /* ───────── Footer ───────── */
  footer {
    padding: 16px 32px 24px;
    border-top: 1px solid var(--grid);
    color: var(--dim);
    font-size: 12px;
    display: flex;
    justify-content: space-between;
  }
  footer a { color: var(--dim); }
</style>
</head>
<body>

<header>
  <h1>nl2protocol report</h1>
  <div class="meta">
    Generated {{ timestamp }} ·
    Status: {% if success %}<strong style="color:#2a9d8f">success</strong>{% else %}<strong style="color:var(--col-instruction)">failed</strong>{% endif %}
    {% if prov_stats and prov_stats.total %}
      · <span title="Atomic values whose provenance is NOT a literal lift from the instruction (i.e. domain default / inferred / config). Higher = more was filled in by the model.">{{ prov_stats.total }} atomic values · <strong>{{ "%.0f"|format(prov_stats.non_instr_pct) }}%</strong> non-instruction (model-filled)</span>
    {% endif %}
  </div>
  {% if live_mode %}
  <!-- ADR-0013 Phase 3b-1: live-mode control bar. Only shown when the
       template renders for the FastAPI server's GET /. The static
       HTMLReporter path doesn't set live_mode so this stays hidden. -->
  <div class="live-controls" style="margin-top: 10px; display: flex; gap: 12px; align-items: center;">
    <button id="live-start-btn" style="font: 14px -apple-system, sans-serif; padding: 6px 14px; border: 1px solid #c0c0c0; background: white; cursor: pointer; border-radius: 4px;">▶ Start pipeline</button>
    <span id="live-status" style="display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 12px; background: #d4edda; color: #155724;">idle</span>
    <span style="color: var(--dim); font-size: 12px; font-style: italic;">live mode · events stream as the pipeline runs · static report archived to <code>output/</code> at end-of-run</span>
  </div>
  <!-- ADR-0013 Phase 3e: small Y/N modal for stand-alone binary
       confirmations (inferred-source containers, hardware-error
       proceed). Center-screen overlay, but visually lighter than the
       assignments modal — typically just a list + 2 buttons. -->
  <div id="live-binary-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.30); z-index: 1050; align-items: center; justify-content: center;">
    <div style="background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 10px 32px rgba(0,0,0,0.22); width: min(520px, 92vw); max-height: 80vh; overflow-y: auto; font-size: 13px;">
      <div id="live-binary-title" style="padding: 12px 18px; border-bottom: 1px solid var(--grid); background: #faf6e8; font-weight: 600;"></div>
      <div id="live-binary-body" style="padding: 14px 18px;"></div>
      <div style="padding: 10px 18px; border-top: 1px solid var(--grid); display: flex; gap: 8px; justify-content: flex-end;">
        <button id="live-binary-no" style="padding: 6px 14px; border: 1px solid #c0c0c0; background: white; color: var(--ink); border-radius: 4px; cursor: pointer; font-size: 13px;">No</button>
        <button id="live-binary-yes" style="padding: 6px 14px; border: 1px solid #2a9d8f; background: #2a9d8f; color: white; border-radius: 4px; cursor: pointer; font-size: 13px;">Yes</button>
      </div>
    </div>
  </div>
  <!-- ADR-0013 Phase 3d: labware-assignments confirmation modal.
       Hidden until a labware_assignments_request arrives. Center-screen
       overlay (different from the per-Gap bottom-right panel) — the
       table can be tall (one row per unique LocationRef description)
       and benefits from being the user's only focus.
       JS in initLiveMode wires up populate + submit. -->
  <div id="live-assignments-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 1100; align-items: center; justify-content: center;">
    <div style="background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 12px 40px rgba(0,0,0,0.25); width: min(720px, 92vw); max-height: 86vh; overflow-y: auto; font-size: 13px;">
      <div style="padding: 12px 18px; border-bottom: 1px solid var(--grid); background: #faf6e8; font-weight: 600;">
        Confirm labware assignments
        <span style="float: right; font-size: 11px; color: var(--dim); font-weight: 500;">change any row, or confirm to accept all</span>
      </div>
      <div id="live-assignments-body" style="padding: 14px 18px;"></div>
      <div style="padding: 10px 18px; border-top: 1px solid var(--grid); display: flex; gap: 8px; justify-content: flex-end;">
        <button id="live-assignments-abort" style="padding: 6px 14px; border: 1px solid #c0c0c0; background: white; color: var(--ink); border-radius: 4px; cursor: pointer; font-size: 13px;">Quit</button>
        <button id="live-assignments-confirm" style="padding: 6px 14px; border: 1px solid #2a9d8f; background: #2a9d8f; color: white; border-radius: 4px; cursor: pointer; font-size: 13px;">Confirm</button>
      </div>
    </div>
  </div>
  <!-- ADR-0013 Phase 3c: gap-prompt modal. Hidden until a panel_request
       arrives over the WebSocket. Anchored bottom-right per ADR-0013. -->
  <div id="live-panel" style="display: none; position: fixed; right: 24px; bottom: 24px; width: 380px; max-height: 70vh; overflow-y: auto; background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 6px 24px rgba(0,0,0,0.18); z-index: 1000; font-size: 13px;">
    <div style="padding: 10px 14px; border-bottom: 1px solid var(--grid); background: #faf6e8; font-weight: 600;">
      <span id="live-panel-title">Confirm gap</span>
      <span id="live-panel-severity" style="float: right; font-size: 11px; padding: 1px 8px; border-radius: 3px; background: #f0e6d2; color: var(--dim); font-weight: 500;"></span>
    </div>
    <div style="padding: 12px 14px;">
      <div id="live-panel-description" style="margin-bottom: 8px;"></div>
      <div id="live-panel-current" style="margin-bottom: 8px; color: var(--dim); font-size: 12px;"></div>
      <div id="live-panel-suggestion" style="margin-bottom: 10px;"></div>
      <div id="live-panel-reasoning" style="font-size: 12px; color: var(--dim); font-style: italic; margin-bottom: 10px;"></div>
      <!-- Reviewer objection. Populated by showPanel() when the
           gap.metadata.reviewer_objection field is non-empty. Orange-tinted
           to match the legend's "⚠ reviewer disagreed" marker. Hidden by
           default; showPanel toggles display. -->
      <div id="live-panel-objection" style="display: none; margin-bottom: 10px; padding: 8px 10px; border-left: 3px solid var(--col-instruction); background: #fff4e6; font-size: 12px;"></div>
    </div>
    <div id="live-panel-buttons" style="padding: 10px 14px; border-top: 1px solid var(--grid); display: flex; gap: 8px; flex-wrap: wrap;">
      <!-- buttons injected per-gap by JS (accept / skip / override / abort) -->
    </div>
  </div>
  {% endif %}
  <div class="legend">
    <span><span class="swatch" style="background: var(--col-instruction)"></span>→ arrow = step decomposition (instruction phrase → spec step)</span>
    <span style="color: var(--dim); font-style: italic;">instruction-sourced atoms: per-citation hue (same hue on cite + value)</span>
    <span><span class="non-instr-marker">▴</span> non-instruction atom (filled in by model — domain default / inferred / config)</span>
    <span style="color: var(--col-instruction); font-weight: 700;">⚠</span><span style="margin-left: 4px;"> reviewer disagreed (hover for objection)</span>
    <span style="color: #1f5fa6;">✎</span><span style="margin-left: 4px;"> user-edited during gap resolution</span>
  </div>
</header>

<div class="grid">

  <!-- ───────── Column 1: Instruction ───────── -->
  <div class="col">
    <h2>Instruction</h2>
    <div class="instruction-text">{{ instruction_html|safe }}</div>
  </div>

  <!-- ───────── Column 2: Extracted Spec ─────────
       Step blocks no longer print "triggered by:" — the arrow communicates
       the same thing. Hover the block for justification + reasoning. -->
  <div class="col col-extracted-spec">
    <h2>Extracted Spec</h2>
    {% if spec_steps %}
      {% for step in spec_steps %}
        <div class="step {{ step.step_class }}"
             data-prov-id="{{ step.step_trigger_prov_id }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(extraction did not produce a spec)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 3: Resolved Spec (post-orchestrator) ─────────
       The spec AFTER the orchestrator's gap-resolution loop converges.
       Every Gap that was resolvable is filled; every Provenance carries
       the review_status from ADR-0009. Distinct from column 4 (Validated
       Spec) — column 3 is the orchestrator's output; column 4 is the
       same spec after stage-3.5's labware confirmation panel + stage-4's
       constraint check pass. ADR-0011 Phase 2a introduces the split. -->
  <div class="col col-resolved-spec">
    <h2>Resolved Spec</h2>
    {% if resolved_steps %}
      {% for step in resolved_steps %}
        <div class="step {{ step.step_class }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(orchestrator stage not reached)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 4: Validated Spec (post-CompleteProtocolSpec) ─────────
       The spec after the stage-3.5 labware-confirm panel (legacy
       _confirm_labware_assignments still serves this until ADR-0011
       Phase 5) AND the stage-4 ConstraintChecker.check_all pass. This
       is the spec that becomes CompleteProtocolSpec at the type-system
       level. Visually similar to column 3 today; Phase 2b's arrows will
       show what changed (labware re-mappings + any constraint clips). -->
  <div class="col col-validated-spec">
    <h2>Validated Spec</h2>
    {% if validated_steps %}
      {% for step in validated_steps %}
        <div class="step {{ step.step_class }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(validation stage not reached)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 5: Generated Code ───────── -->
  <div class="col">
    <h2>Generated Python</h2>
    {% if generated_script %}
      <pre class="code">{{ generated_script|e }}</pre>
    {% else %}
      <p style="color: var(--dim)">(script-generation stage not reached)</p>
    {% endif %}
  </div>

</div>

<!-- ───────── ADR-0011 Phase 2c: confirmation summary panels ─────────
     Two read-only audit tables — what was confirmed during the run.
     The lab-state panel surfaces initial_contents + prefilled_labware
     (today's sequential CLI prompts collapsed into one bulk panel per
     ADR-0011's surface unification of CLI surfaces 1+2). The labware
     panel surfaces description → resolved_label assignments (today's
     surface 3). Both render only when their underlying data exists. -->
<section class="panels">
  <div class="panel">
    <h3>Lab state before run</h3>
    {% if lab_state_rows %}
      <table>
        <thead>
          <tr>
            <th>labware</th>
            <th>well</th>
            <th>substance</th>
            <th>volume</th>
          </tr>
        </thead>
        <tbody>
          {% for row in lab_state_rows %}
            <tr data-target-cells="{{ row.target_prov_ids|e }}">
              <td class="col-label">{{ row.labware|e }}</td>
              <td>{{ row.well|e if row.kind == "well" else "(all wells)" }}</td>
              <td class="col-substance">{{ row.substance|e }}</td>
              <td class="col-volume">{{ row.volume_ul|round(0)|int ~ " uL" if row.volume_ul is not none else "—" }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">(no initial-state entries)</div>
    {% endif %}
  </div>

  <div class="panel">
    <h3>Labware assignments</h3>
    {% if labware_mapping_rows %}
      <table>
        <thead>
          <tr>
            <th>user wording</th>
            <th>config label</th>
          </tr>
        </thead>
        <tbody>
          {% for row in labware_mapping_rows %}
            <tr data-target-cells="{{ row.target_prov_ids|e }}">
              <td class="col-description">"{{ row.description|e }}"</td>
              <td class="col-label">{{ row.resolved_label|e if row.resolved_label else "(unresolved)" }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="empty">(no labware references)</div>
    {% endif %}
  </div>
</section>

<footer>
  <span>nl2protocol · provenance-traced protocol generation</span>
  <span>Hover any colored value or step block for the original cite + reasoning.</span>
</footer>

<!-- JS hover tooltip — replaces native title= for richer formatting and fade. -->
<div id="hover-tip" role="tooltip"></div>

<!-- SVG overlay for arrows from instruction-cite spans to spec-step blocks.
     The clipPath is rebuilt on every render to match the spec column's
     visible rect — arrows that would extend above/below the column box
     are clipped, preserving their bezier shape but hiding the overflow. -->
<svg id="arrow-overlay" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="arrow-clip"><rect id="arrow-clip-rect" x="0" y="0" width="0" height="0"/></clipPath>
  </defs>
  <!-- Composite-step arrows (instruction → extracted spec). Clipped to the
       extracted-spec column so off-screen segments don't visually escape. -->
  <g clip-path="url(#arrow-clip)" id="arrow-paths"></g>
  <!-- Resolution arrows (extracted → resolved spec, ADR-0011 Phase 2b).
       NOT clipped — the relevant region spans columns 2 and 3, both
       always in view at desktop widths. -->
  <g id="resolution-arrow-paths"></g>
</svg>

<!-- ADR-0011 Phase 2b: resolution-arrow data embedded as JSON.
     One entry per drawable gap_resolved event. The JS at the end of
     this document parses this on init + on every layout-affecting
     event, then draws an SVG path per entry. -->
<script id="resolution-arrows-data" type="application/json">{{ resolution_arrows_json|default('[]')|safe }}</script>

<script>
(function () {
  // Visual wiring for the report:
  //   1. Composite-step arrows — one SVG bezier per (step, anchor) pair.
  //      A single instruction cite-span can carry MULTIPLE step-trigger
  //      ids (space-separated in data-cite-id) when two step cites
  //      overlap; in that case we draw N arrows fanning out from the
  //      same anchor, producing the "<"-shaped attribution.
  //   2. Hover emphasis — hovering a cite OR a prov target outlines the
  //      pair across all DOM segments sharing the id, and brightens the
  //      matching arrow(s).
  //   3. Q2 cohesion hover — hovering a step block tints every
  //      .cite-q2-cohesion span tagged with that step's id; lit-up
  //      state is the only time Q2 cites become visible.
  //   4. Hover tooltip — replaces native title=. Reads provenance from
  //      data-prov-* attrs on value spans and data-step-* / data-params-*
  //      on step blocks; positions near the cursor with a fade.

  const overlay = document.getElementById("arrow-overlay");
  const tip = document.getElementById("hover-tip");
  if (!overlay) return;

  // Token-match selector: a span's data-cite-id may carry multiple
  // ids ("s0-step-trigger s1-step-trigger") so use the ~= attribute
  // selector for whitespace-separated tokens.
  const sel = (attr, token) => `[${attr}~="${CSS.escape(token)}"]`;

  function bezierPath(srcRect, dstRect) {
    // Right edge of source → left edge of destination, smooth horizontal sweep.
    const x1 = srcRect.right;
    const y1 = srcRect.top + srcRect.height / 2;
    const x2 = dstRect.left;
    const y2 = dstRect.top + dstRect.height / 2;
    const dx = Math.max(40, (x2 - x1) * 0.5);
    return `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  }

  function renderArrows() {
    const arrowGroup = document.getElementById("arrow-paths");
    if (arrowGroup) {
      while (arrowGroup.firstChild) arrowGroup.removeChild(arrowGroup.firstChild);
    }
    // Update the clip-path rect to match the spec column's visible bounds.
    // Arrows that would extend above/below the column get clipped without
    // changing their bezier shape.
    const specCol = document.querySelector(".col-extracted-spec");
    const clipRect = document.getElementById("arrow-clip-rect");
    if (specCol && clipRect) {
      const r = specCol.getBoundingClientRect();
      // Extend left toward the instruction column so the arrow's starting
      // bezier sweep remains visible — only the destination side needs clipping.
      const leftExtend = window.innerWidth;
      clipRect.setAttribute("x", String(r.left - leftExtend));
      clipRect.setAttribute("y", String(r.top));
      clipRect.setAttribute("width", String(r.right - r.left + leftExtend));
      clipRect.setAttribute("height", String(r.bottom - r.top));
    }
    // Dedupe by step-trigger id: one arrow per (cite-anchor, step) pair.
    // When the same step-trigger id appears across multiple DOM segments
    // (because of overlap segmentation), pick the leftmost segment as anchor.
    const anchorByStepId = new Map();
    document.querySelectorAll(".cite-composite-step[data-cite-id]").forEach((citeEl) => {
      const ids = (citeEl.getAttribute("data-cite-id") || "").split(/\s+/).filter(Boolean);
      const r = citeEl.getBoundingClientRect();
      if (!r.width) return;
      ids.forEach((id) => {
        if (!id.endsWith("-step-trigger")) return;
        const prev = anchorByStepId.get(id);
        if (!prev || r.left < prev.rect.left) {
          anchorByStepId.set(id, { rect: r });
        }
      });
    });
    anchorByStepId.forEach(({ rect: srcRect }, id) => {
      const target = document.querySelector(`.step${sel("data-prov-id", id)}`);
      if (!target) return;
      const dstRect = target.getBoundingClientRect();
      if (!dstRect.width) return;
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", bezierPath(srcRect, dstRect));
      path.dataset.citeId = id;
      (arrowGroup || overlay).appendChild(path);
    });
  }

  function setPairActive(id, active) {
    // Toggle highlight on every cite-segment, prov-target, and arrow sharing one id.
    document.querySelectorAll(sel("data-cite-id", id)).forEach((e) =>
      e.classList.toggle("cite-active", active)
    );
    document.querySelectorAll(sel("data-prov-id", id)).forEach((e) => {
      if (e.classList.contains("step")) {
        e.classList.toggle("step-active", active);
      } else {
        e.classList.toggle("prov-active", active);
      }
    });
    overlay.querySelectorAll(`path[data-cite-id="${CSS.escape(id)}"]`).forEach((p) =>
      p.classList.toggle("arrow-active", active)
    );
  }

  function setQ2Active(stepId, active) {
    document.querySelectorAll(sel("data-q2-step-id", stepId)).forEach((e) =>
      e.classList.toggle("q2-active", active)
    );
  }

  // ────────── Hover tooltip ──────────
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c]));
  }

  function showTip(html, evt) {
    if (!tip) return;
    tip.innerHTML = html;
    tip.classList.add("visible");
    moveTip(evt);
  }
  function hideTip() {
    if (!tip) return;
    tip.classList.remove("visible");
  }
  function moveTip(evt) {
    if (!tip || !tip.classList.contains("visible")) return;
    const pad = 14;
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    let x = evt.clientX + pad;
    let y = evt.clientY + pad;
    if (x + w > window.innerWidth - 8) x = evt.clientX - pad - w;
    if (y + h > window.innerHeight - 8) y = evt.clientY - pad - h;
    tip.style.left = `${Math.max(8, x)}px`;
    tip.style.top = `${Math.max(8, y)}px`;
  }

  function tooltipHtmlForValueSpan(el) {
    // Atomic value tooltip:
    //   header line:  "SOURCE: <kind> · CONFIDENCE: <pct> · REVIEW: <state-glyph>"
    //   for instruction-sourced values: cited substring as a quoted line.
    //   for non-instruction values: TWO labeled rows:
    //     [WHY THIS VALUE]      positive_reasoning
    //     [WHY NOT IN INSTR]    why_not_in_instruction
    //   when review_status == 'reviewed_disagree': boxed reviewer objection.
    const source = el.getAttribute("data-prov-source") || "unknown";
    const conf = el.getAttribute("data-prov-confidence") || "";
    const cited = el.getAttribute("data-prov-cited");
    const positiveReasoning = el.getAttribute("data-prov-positive-reasoning")
                              || el.getAttribute("data-prov-reasoning");
    const whyNotInInstruction = el.getAttribute("data-prov-why-not-in-instruction");
    const reviewStatus = el.getAttribute("data-prov-review-status") || "original";
    const reviewerObjection = el.getAttribute("data-prov-reviewer-objection");
    const confPct = conf ? `${Math.round(parseFloat(conf) * 100)}%` : "";

    // Compact glyph + label per review state. 'original' is the default
    // state and gets no extra meta — the source/confidence pair is enough.
    const reviewGlyph = ({
      reviewed_agree:           "✓ reviewer agreed",
      reviewed_disagree:        "✗ reviewer disagreed",
      user_confirmed:           "✓ confirmed",
      user_edited:              "✎ edited by user",
      user_accepted_suggestion: "→ accepted suggestion",
      user_skipped:             "↷ skipped",
    })[reviewStatus] || "";

    let parts = [
      `<div class="tip-meta">source: ${escapeHtml(source)}${confPct ? ` · confidence: ${confPct}` : ""}${reviewGlyph ? ` · ${escapeHtml(reviewGlyph)}` : ""}</div>`,
    ];
    if (cited) {
      parts.push(`<div class="tip-cite">"${escapeHtml(cited)}"</div>`);
    }
    if (positiveReasoning) {
      parts.push(`<div class="tip-section"><div class="tip-meta">why this value</div><div class="tip-reasoning">${escapeHtml(positiveReasoning)}</div></div>`);
    }
    if (whyNotInInstruction) {
      parts.push(`<div class="tip-section"><div class="tip-meta">why not in instruction</div><div class="tip-reasoning">${escapeHtml(whyNotInInstruction)}</div></div>`);
    }
    if (reviewerObjection) {
      parts.push(`<div class="tip-section"><div class="tip-meta">reviewer objection</div><blockquote class="tip-objection">${escapeHtml(reviewerObjection)}</blockquote></div>`);
    }
    return parts.join("");
  }

  function tooltipHtmlForStepBlock(el) {
    // Step block tooltip:
    //   header: "WHY THIS STEP, WITH THESE PARAMS? · <confidence>"
    //   reasoning paragraph (parameters_reasoning)
    //   indented blockquote of step_cited_text with palette-colored left bar
    //   optional "DOMAIN EXPANSION" section when step_reasoning is present
    const cited = el.getAttribute("data-step-cited") || "";
    const paletteCls = el.getAttribute("data-step-palette") || "";
    const stepReasoning = el.getAttribute("data-step-reasoning");
    const paramsReasoning = el.getAttribute("data-params-reasoning");
    const conf = el.getAttribute("data-confidence") || "";
    let parts = [`<div class="tip-meta">why this step, with these params?${conf ? ` · ${escapeHtml(conf)}` : ""}</div>`];
    if (paramsReasoning) {
      parts.push(`<div class="tip-reasoning">${escapeHtml(paramsReasoning)}</div>`);
    }
    if (cited) {
      parts.push(`<blockquote class="tip-quote ${escapeHtml(paletteCls)}">${escapeHtml(cited)}</blockquote>`);
    }
    if (stepReasoning) {
      parts.push(`<div class="tip-section"><div class="tip-meta">domain expansion</div><div class="tip-reasoning">${escapeHtml(stepReasoning)}</div></div>`);
    }
    return parts.join("");
  }

  function wireHover() {
    // Cite ↔ prov pair highlight + cite-segment tooltip (if cite carries
    // any prov metadata via the value side, which it doesn't directly —
    // tooltip wiring lives on prov-id targets and step blocks below).
    document.querySelectorAll("[data-cite-id]").forEach((el) => {
      const ids = (el.getAttribute("data-cite-id") || "").split(/\s+/).filter(Boolean);
      el.addEventListener("mouseenter", () => ids.forEach((id) => setPairActive(id, true)));
      el.addEventListener("mouseleave", () => ids.forEach((id) => setPairActive(id, false)));
    });

    // Atomic value spans (carry data-prov-source) — pair highlight + tooltip.
    document.querySelectorAll("[data-prov-source]").forEach((el) => {
      const id = el.getAttribute("data-prov-id");
      el.addEventListener("mouseenter", (e) => {
        if (id) setPairActive(id, true);
        showTip(tooltipHtmlForValueSpan(el), e);
      });
      el.addEventListener("mousemove", moveTip);
      el.addEventListener("mouseleave", () => {
        if (id) setPairActive(id, false);
        hideTip();
      });
    });

    // Step blocks — Q2 cohesion lighting + step-trigger pair highlight + tooltip.
    document.querySelectorAll(".step[data-prov-id]").forEach((stepEl) => {
      const provId = stepEl.getAttribute("data-prov-id");
      const stepId = provId.replace(/-step-trigger$/, "");
      stepEl.addEventListener("mouseenter", (e) => {
        setPairActive(provId, true);
        setQ2Active(stepId, true);
        showTip(tooltipHtmlForStepBlock(stepEl), e);
      });
      stepEl.addEventListener("mousemove", moveTip);
      stepEl.addEventListener("mouseleave", () => {
        setPairActive(provId, false);
        setQ2Active(stepId, false);
        hideTip();
      });
    });

    // Complete-spec column step blocks (no data-prov-id but still hover tooltip).
    document.querySelectorAll(".step:not([data-prov-id])[data-step-cited]").forEach((stepEl) => {
      stepEl.addEventListener("mouseenter", (e) => showTip(tooltipHtmlForStepBlock(stepEl), e));
      stepEl.addEventListener("mousemove", moveTip);
      stepEl.addEventListener("mouseleave", hideTip);
    });

    // Reverse Q2 wiring: hovering a Q2 cite-span surfaces its step.
    document.querySelectorAll(".cite-q2-cohesion[data-q2-step-id]").forEach((citeEl) => {
      const stepIds = (citeEl.getAttribute("data-q2-step-id") || "").split(/\s+/).filter(Boolean);
      citeEl.addEventListener("mouseenter", () => stepIds.forEach((sid) => {
        setQ2Active(sid, true);
        setPairActive(`${sid}-step-trigger`, true);
      }));
      citeEl.addEventListener("mouseleave", () => stepIds.forEach((sid) => {
        setQ2Active(sid, false);
        setPairActive(`${sid}-step-trigger`, false);
      }));
    });

    // Phase 4 polish: bulk-panel row hover lights up corresponding spec cells.
    // Each row carries `data-target-cells` (space-separated prov-ids); on
    // hover we toggle .prov-active across all cells with matching ids in
    // the spec columns. Reuses the existing setPairActive helper that
    // already drives the cite ↔ value pair highlight.
    document.querySelectorAll(".panel tbody tr[data-target-cells]").forEach((rowEl) => {
      const ids = (rowEl.getAttribute("data-target-cells") || "").split(/\s+/).filter(Boolean);
      if (ids.length === 0) return;
      rowEl.addEventListener("mouseenter", () => ids.forEach((id) => setPairActive(id, true)));
      rowEl.addEventListener("mouseleave", () => ids.forEach((id) => setPairActive(id, false)));
    });
  }

  // ────────── ADR-0011 Phase 2b: resolution arrows ──────────
  // Read the embedded JSON, draw one bezier path per drawable
  // gap_resolved event from extracted-spec column to resolved-spec
  // column. Color encodes resolution_kind via CSS class.
  function readResolutionArrowData() {
    const el = document.getElementById("resolution-arrows-data");
    if (!el) return [];
    try {
      const data = JSON.parse(el.textContent || "[]");
      return Array.isArray(data) ? data : [];
    } catch (e) {
      return [];
    }
  }

  function renderResolutionArrows() {
    const group = document.getElementById("resolution-arrow-paths");
    if (!group) return;
    while (group.firstChild) group.removeChild(group.firstChild);
    const arrows = readResolutionArrowData();
    if (arrows.length === 0) return;
    const extractedCol = document.querySelector(".col-extracted-spec");
    const resolvedCol  = document.querySelector(".col-resolved-spec");
    if (!extractedCol || !resolvedCol) return;
    arrows.forEach((arrow) => {
      const pid = arrow.prov_id;
      // Source: the value cell in the extracted-spec column with the
      // matching data-prov-id. Destination: the value cell in the
      // resolved-spec column with the same id. Per-column scoping
      // keeps the cross-column lookup unambiguous (same prov_id appears
      // once per column).
      const src = extractedCol.querySelector(sel("data-prov-id", pid));
      const dst = resolvedCol.querySelector(sel("data-prov-id", pid));
      if (!src || !dst) return;
      const srcRect = src.getBoundingClientRect();
      const dstRect = dst.getBoundingClientRect();
      if (!srcRect.width || !dstRect.width) return;
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", bezierPath(srcRect, dstRect));
      path.setAttribute("class", `resolution-arrow res-${arrow.resolution_kind}`);
      path.dataset.provId = pid;
      path.dataset.resolutionKind = arrow.resolution_kind;
      group.appendChild(path);
    });
  }

  function scheduleRender() {
    requestAnimationFrame(() => {
      renderArrows();
      renderResolutionArrows();
    });
  }

  function init() {
    renderArrows();
    renderResolutionArrows();
    wireHover();
    // Re-render on every layout-affecting event so arrows track their anchors.
    window.addEventListener("resize", scheduleRender);
    window.addEventListener("scroll", scheduleRender, { passive: true });
    document.querySelectorAll(".col").forEach((c) =>
      c.addEventListener("scroll", scheduleRender, { passive: true })
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // ────────── ADR-0013 Phase 3b-1: live-mode WebSocket consumer ──────────
  // When the server renders this template with `live_mode=True`, this
  // block opens a WebSocket to /events and dispatches incoming events
  // to DOM-update handlers. Static HTMLReporter renders don't include
  // the live-controls div above, so this code's getElementById calls
  // simply find no button and the WebSocket never opens.
  function initLiveMode() {
    const startBtn = document.getElementById("live-start-btn");
    const status = document.getElementById("live-status");
    if (!startBtn || !status) return;   // not in live mode

    let activeWS = null;   // populated by connectWS so panel button clicks can reach it

    function setStatus(text, bg, fg) {
      status.textContent = text;
      status.style.background = bg;
      status.style.color = fg;
    }

    // ADR-0013 Phase 3c: gap-prompt modal helpers.
    // Mirrors CLIConfirmationHandler._render_gap + _action_prompt — same
    // information density, same action options, same severity labels.
    const panel = document.getElementById("live-panel");
    let activeReq = null;       // the currently-shown panel_request (drives keyboard)
    let activeKeyHandler = null;

    // Severity → (label, bg, fg). Keys must match GapSeverity literals
    // ("blocker"/"suggestion"/"quality"); CLI maps these same three.
    const SEVERITY_TAG = {
      "blocker":    { label: "BLOCKER",     bg: "#f8d7da", fg: "#721c24" },
      "suggestion": { label: "needs review", bg: "#fff3cd", fg: "#856404" },
      "quality":    { label: "optional",    bg: "#f0e6d2", fg: "#6b6b6b" },
    };

    function showPanel(req) {
      if (!panel) return;
      activeReq = req;
      const gap = req.gap || {};
      const sug = req.suggestion;
      document.getElementById("live-panel-title").textContent =
        gap.kind ? "Gap: " + gap.kind : "Confirm gap";
      const sev = document.getElementById("live-panel-severity");
      const sevTag = SEVERITY_TAG[gap.severity]
                     || { label: gap.severity || "", bg: "#f0e6d2", fg: "#6b6b6b" };
      sev.textContent = sevTag.label;
      sev.style.background = sevTag.bg;
      sev.style.color = sevTag.fg;
      document.getElementById("live-panel-description").textContent =
        gap.description || "";
      const cur = document.getElementById("live-panel-current");
      cur.textContent = gap.current_value
        ? "Current: " + gap.current_value : "";
      // Suggestion block: value + provenance_source + reasoning +
      // why_not_in_instruction + confidence (CLI _render_gap parity).
      const sugDiv = document.getElementById("live-panel-suggestion");
      const reasoningDiv = document.getElementById("live-panel-reasoning");
      if (sug) {
        sugDiv.innerHTML = '<strong>Suggested:</strong> '
          + escapeHtml(String(sug.value_repr || ""))
          + (sug.provenance_source
              ? ' <span style="color:var(--dim);font-size:11px">('
                + escapeHtml(sug.provenance_source) + ')</span>'
              : "");
        let r = "";
        if (sug.positive_reasoning) {
          r += '<div><strong>Reasoning:</strong> '
            + escapeHtml(sug.positive_reasoning) + '</div>';
        }
        if (sug.why_not_in_instruction) {
          r += '<div style="margin-top:4px"><strong>Why not from instruction:</strong> '
            + escapeHtml(sug.why_not_in_instruction) + '</div>';
        }
        if (typeof sug.confidence === "number") {
          r += '<div style="margin-top:4px"><strong>Confidence:</strong> '
            + Math.round(sug.confidence * 100) + '%</div>';
        }
        reasoningDiv.innerHTML = r;
        reasoningDiv.style.fontStyle = "normal";
      } else {
        sugDiv.innerHTML = '<em style="color:var(--dim)">(no suggestion available)</em>';
        reasoningDiv.innerHTML = "";
      }
      // Reviewer objection. Stamped onto gap.metadata by the orchestrator
      // after the reviewer pass; populated only when the reviewer
      // disagreed with the suggester. Mirrors the CLI handler line
      // "reviewer pushed back: <objection>".
      const objDiv = document.getElementById("live-panel-objection");
      const objection = gap.metadata && gap.metadata.reviewer_objection;
      if (objection) {
        objDiv.innerHTML = '<strong style="color:var(--col-instruction)">⚠ reviewer pushed back:</strong> '
          + escapeHtml(String(objection));
        objDiv.style.display = "block";
      } else {
        objDiv.style.display = "none";
      }
      // Build the per-gap button row. Mirrors CLI _action_prompt:
      //   - Accept only when a suggestion exists (default action — Enter).
      //   - Edit always shown.
      //   - Override only on kind="fabricated" (ADR-0012).
      //   - Skip only on severity="quality".
      //   - Quit always shown.
      // Keyboard shortcut letters in parens match CLI single-key tokens.
      const btnRow = document.getElementById("live-panel-buttons");
      btnRow.innerHTML = "";
      const buttons = [];
      if (sug) buttons.push({ label: "Accept (a)", action: "accept", primary: true, key: "a" });
      buttons.push({ label: "Edit (e)", action: "edit", key: "e" });
      if (gap.kind === "fabricated") buttons.push({ label: "Override (o)", action: "override", key: "o" });
      if (gap.severity === "quality") buttons.push({ label: "Skip (s)", action: "skip", key: "s" });
      buttons.push({ label: "Quit (q)", action: "abort", key: "q" });
      buttons.forEach((b) => {
        const el = document.createElement("button");
        el.textContent = b.label;
        el.style.cssText = b.primary
          ? "padding:6px 14px;border:1px solid #2a9d8f;background:#2a9d8f;color:white;border-radius:4px;cursor:pointer;font-size:13px;"
          : "padding:6px 14px;border:1px solid #c0c0c0;background:white;color:var(--ink);border-radius:4px;cursor:pointer;font-size:13px;";
        el.addEventListener("click", () => triggerAction(b.action));
        btnRow.appendChild(el);
      });
      panel.style.display = "block";
      installKeyboardHandler(buttons, !!sug);
    }
    function triggerAction(action) {
      if (!activeReq) return;
      if (action === "edit") {
        showEditInput(activeReq);
      } else {
        sendPanelResponse(activeReq.request_id, action);
      }
    }
    function installKeyboardHandler(buttons, hasSuggestion) {
      // Single-keystroke shortcuts. Enter = accept (CLI default action)
      // when a suggestion exists. Listener is rebound per-gap so the
      // available shortcuts always match the visible buttons.
      removeKeyboardHandler();
      const allowed = new Set(buttons.map((b) => b.key));
      activeKeyHandler = (ev) => {
        // Don't hijack typing inside the edit input.
        const tag = (ev.target && ev.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        const k = ev.key.toLowerCase();
        if (k === "enter" && hasSuggestion && allowed.has("a")) {
          ev.preventDefault();
          triggerAction("accept");
          return;
        }
        const match = buttons.find((b) => b.key === k);
        if (match) {
          ev.preventDefault();
          triggerAction(match.action);
        }
      };
      document.addEventListener("keydown", activeKeyHandler);
    }
    function removeKeyboardHandler() {
      if (activeKeyHandler) {
        document.removeEventListener("keydown", activeKeyHandler);
        activeKeyHandler = null;
      }
    }
    function showEditInput(req) {
      // Mirrors CLI sub-prompt: "  new value for <field_path>: ".
      // Shows the field_path so the user knows what they're editing.
      // Pre-fills the suggestion (or current value) for cheap small tweaks.
      // Detach the gap-level keyboard handler — the input owns keyboard
      // until the user submits or cancels.
      removeKeyboardHandler();
      const btnRow = document.getElementById("live-panel-buttons");
      btnRow.innerHTML = "";
      btnRow.style.flexDirection = "column";
      btnRow.style.alignItems = "stretch";
      const sug = req.suggestion;
      const gap = req.gap || {};
      const initial = (sug && sug.value_repr) || gap.current_value || "";
      const label = document.createElement("div");
      label.textContent = "new value for " + (gap.field_path || "<field>") + ":";
      label.style.cssText = "font-size:11px;color:var(--dim);margin-bottom:4px;";
      const inputRow = document.createElement("div");
      inputRow.style.cssText = "display:flex;gap:8px;flex-wrap:wrap;";
      const input = document.createElement("input");
      input.type = "text";
      input.value = String(initial);
      input.style.cssText = "flex:1;min-width:0;padding:6px 8px;border:1px solid #c0c0c0;border-radius:4px;font-size:13px;";
      const save = document.createElement("button");
      save.textContent = "Save";
      save.style.cssText = "padding:6px 14px;border:1px solid #2a9d8f;background:#2a9d8f;color:white;border-radius:4px;cursor:pointer;font-size:13px;";
      const cancel = document.createElement("button");
      cancel.textContent = "Cancel";
      cancel.style.cssText = "padding:6px 14px;border:1px solid #c0c0c0;background:white;color:var(--ink);border-radius:4px;cursor:pointer;font-size:13px;";
      function submit() {
        if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
        activeWS.send(JSON.stringify({
          kind: "panel_response",
          request_id: req.request_id,
          action: "edit",
          new_value: input.value,
        }));
        // Restore button row layout for the next gap before hiding.
        btnRow.style.flexDirection = "row";
        btnRow.style.alignItems = "";
        hidePanel();
      }
      function restore() {
        // Bring the button row back without losing the panel.
        btnRow.style.flexDirection = "row";
        btnRow.style.alignItems = "";
        showPanel(req);
      }
      save.addEventListener("click", submit);
      input.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") { ev.preventDefault(); submit(); }
        if (ev.key === "Escape") { ev.preventDefault(); restore(); }
      });
      cancel.addEventListener("click", restore);
      inputRow.appendChild(input);
      inputRow.appendChild(save);
      inputRow.appendChild(cancel);
      btnRow.appendChild(label);
      btnRow.appendChild(inputRow);
      input.focus();
      input.select();
    }
    function hidePanel() {
      if (panel) panel.style.display = "none";
      activeReq = null;
      removeKeyboardHandler();
    }
    function sendPanelResponse(requestId, action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      activeWS.send(JSON.stringify({
        kind: "panel_response",
        request_id: requestId,
        action: action,
      }));
      hidePanel();
    }

    function appendStepBlocks(colSelector, stepDicts) {
      // Replace the column's "(stage not reached)" placeholder with
      // step blocks. Mirrors the Jinja loop's HTML structure exactly
      // so all existing CSS + hover JS apply unchanged.
      const col = document.querySelector(colSelector);
      if (!col || !stepDicts) return;
      // Drop any "(...) not reached" placeholder paragraph.
      col.querySelectorAll("p").forEach((p) => p.remove());
      // Drop any existing step blocks (so re-runs don't duplicate).
      col.querySelectorAll(".step").forEach((s) => s.remove());
      stepDicts.forEach((step) => {
        const div = document.createElement("div");
        div.className = "step " + (step.step_class || "");
        div.dataset.stepCited = step.step_cited_text || "";
        div.dataset.stepPalette = step.step_palette_class || "";
        if (step.step_reasoning) div.dataset.stepReasoning = step.step_reasoning;
        if (step.parameters_reasoning) div.dataset.paramsReasoning = step.parameters_reasoning;
        if (step.confidence) div.dataset.confidence = step.confidence;
        if (step.step_trigger_prov_id) div.dataset.provId = step.step_trigger_prov_id;
        let html = `<div class="step-action">Step ${step.order}: ${escapeHtml(step.action || "")}</div>`;
        (step.detail_lines || []).forEach((line) => {
          html += `<div class="step-detail">${line}</div>`;
        });
        if (step.note_line) html += step.note_line;
        div.innerHTML = html;
        col.appendChild(div);
      });
      // Re-wire hover handlers so newly-added cells get listeners.
      // The existing wireHover function is idempotent at the listener
      // level for our use case (extra mouseenter listeners on the same
      // element are harmless cosmetically; minor memory overhead is
      // acceptable for v1 — Phase 3b-2 can refactor to event delegation).
      try { wireHover(); } catch (e) { /* defensive */ }
    }

    // ────────── ADR-0013 Phase 3e: binary-confirm modal ──────────
    let activeBinaryRid = null;
    function showBinaryModal(req) {
      const overlay = document.getElementById("live-binary-overlay");
      const title = document.getElementById("live-binary-title");
      const body = document.getElementById("live-binary-body");
      const yes = document.getElementById("live-binary-yes");
      const no = document.getElementById("live-binary-no");
      if (!overlay || !title || !body || !yes || !no) return;
      activeBinaryRid = req.request_id;
      title.textContent = req.title || "Confirm";
      body.innerHTML = "";
      const ul = document.createElement("ul");
      ul.style.cssText = "margin: 0 0 4px 0; padding-left: 18px;";
      (req.items || []).forEach((item) => {
        const li = document.createElement("li");
        li.style.cssText = "margin: 2px 0;";
        li.textContent = String(item);
        ul.appendChild(li);
      });
      body.appendChild(ul);
      yes.textContent = req.yes_label || "Yes";
      no.textContent = req.no_label || "No";
      overlay.style.display = "flex";
    }
    function hideBinaryModal() {
      const overlay = document.getElementById("live-binary-overlay");
      if (overlay) overlay.style.display = "none";
      activeBinaryRid = null;
    }
    function sendBinaryResponse(action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      if (!activeBinaryRid) return;
      activeWS.send(JSON.stringify({
        kind: "binary_confirm_response",
        request_id: activeBinaryRid,
        action: action,
      }));
      hideBinaryModal();
    }

    // ────────── ADR-0013 Phase 3d: labware-assignments modal ──────────
    // Single in-flight request per pipeline run, so this just tracks the
    // current request_id + a {description: <select-element>} map for
    // reading user picks at submit time.
    let activeAssignmentsRid = null;
    let activeAssignmentsSelects = null;

    function showAssignmentsModal(req) {
      const overlay = document.getElementById("live-assignments-overlay");
      const body = document.getElementById("live-assignments-body");
      if (!overlay || !body) return;
      activeAssignmentsRid = req.request_id;
      activeAssignmentsSelects = {};
      body.innerHTML = "";
      const table = document.createElement("table");
      table.style.cssText = "width: 100%; border-collapse: collapse;";
      const thead = document.createElement("thead");
      thead.innerHTML = '<tr style="text-align: left; border-bottom: 1px solid var(--grid);">'
        + '<th style="padding: 6px 8px; font-weight: 600;">Description (from instruction)</th>'
        + '<th style="padding: 6px 8px; font-weight: 600;">Config label</th>'
        + '</tr>';
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      (req.assignments || []).forEach((row) => {
        const tr = document.createElement("tr");
        tr.style.cssText = "border-bottom: 1px solid var(--grid);";
        const descCell = document.createElement("td");
        descCell.style.cssText = "padding: 8px 8px; vertical-align: top;";
        descCell.textContent = row.description;
        const labelCell = document.createElement("td");
        labelCell.style.cssText = "padding: 6px 8px; vertical-align: top;";
        const select = document.createElement("select");
        select.style.cssText = "width: 100%; padding: 4px 6px; font-size: 13px; border: 1px solid #c0c0c0; border-radius: 4px;";
        // Empty option for unresolved; only used when no candidates match.
        if (!row.suggested_label) {
          const opt = document.createElement("option");
          opt.value = "";
          opt.textContent = "??? (no match)";
          opt.selected = true;
          select.appendChild(opt);
        }
        (row.candidates || []).forEach((label) => {
          const opt = document.createElement("option");
          opt.value = label;
          opt.textContent = label;
          if (label === row.suggested_label) opt.selected = true;
          select.appendChild(opt);
        });
        labelCell.appendChild(select);
        tr.appendChild(descCell);
        tr.appendChild(labelCell);
        tbody.appendChild(tr);
        activeAssignmentsSelects[row.description] = select;
      });
      table.appendChild(tbody);
      body.appendChild(table);
      overlay.style.display = "flex";
    }
    function hideAssignmentsModal() {
      const overlay = document.getElementById("live-assignments-overlay");
      if (overlay) overlay.style.display = "none";
      activeAssignmentsRid = null;
      activeAssignmentsSelects = null;
    }
    function sendAssignmentsResponse(action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      if (!activeAssignmentsRid) return;
      const assignments = {};
      if (action === "confirm" && activeAssignmentsSelects) {
        // Block confirm if any row is still unresolved (empty value).
        for (const [desc, sel] of Object.entries(activeAssignmentsSelects)) {
          if (!sel.value) {
            alert("Assign every row before confirming. \"" + desc + "\" is unresolved.");
            return;
          }
          assignments[desc] = sel.value;
        }
      }
      activeWS.send(JSON.stringify({
        kind: "labware_assignments_response",
        request_id: activeAssignmentsRid,
        action: action,
        assignments: assignments,
      }));
      hideAssignmentsModal();
    }

    function updateInstructionColumn(html) {
      // Phase 3b-2: replace the instruction column's content with the
      // server-rendered cite-marked HTML. Anchor spans (data-cite-id)
      // are now in the DOM so step-trigger arrows have something to
      // point from. Re-wires hover handlers since we mutated the
      // listeners' targets.
      const el = document.querySelector(".col .instruction-text");
      if (!el || !html) return;
      el.innerHTML = html;
      try { wireHover(); } catch (e) { /* defensive */ }
    }

    function updateResolutionArrows(arrows) {
      // Phase 3b-2: replace the embedded JSON the static path uses so
      // the existing renderResolutionArrows() reads the new set on the
      // next scheduleRender() tick.
      const el = document.getElementById("resolution-arrows-data");
      if (!el || !Array.isArray(arrows)) return;
      el.textContent = JSON.stringify(arrows);
    }

    function handleEvent(e) {
      switch (e.kind) {
        case "raw_instruction":
          // Plain-text preview while we wait for the first spec event.
          // Once the spec arrives, updateInstructionColumn replaces this
          // with the cite-marked HTML.
          const instrCol = document.querySelector(".col .instruction-text");
          if (instrCol && e.data && e.data.instruction) {
            instrCol.textContent = e.data.instruction;
          }
          break;
        case "extracted_spec":
          appendStepBlocks(".col-extracted-spec", e.data && e.data.steps);
          if (e.data && e.data.instruction_html) {
            updateInstructionColumn(e.data.instruction_html);
          }
          break;
        case "resolved_spec":
          appendStepBlocks(".col-resolved-spec", e.data && e.data.steps);
          if (e.data && e.data.instruction_html) {
            updateInstructionColumn(e.data.instruction_html);
          }
          break;
        case "completed_spec":
          appendStepBlocks(".col-validated-spec", e.data && e.data.steps);
          if (e.data && e.data.instruction_html) {
            updateInstructionColumn(e.data.instruction_html);
          }
          break;
        case "gap_resolved":
          if (e.data && Array.isArray(e.data.resolution_arrows)) {
            updateResolutionArrows(e.data.resolution_arrows);
          }
          break;
        case "generated_script":
          // Replace the placeholder paragraph in column 5 with a <pre>.
          const codeCol = document.querySelectorAll(".col")[4];
          if (codeCol && e.data && e.data.script) {
            codeCol.querySelectorAll("p").forEach((p) => p.remove());
            codeCol.querySelectorAll("pre.code").forEach((p) => p.remove());
            const pre = document.createElement("pre");
            pre.className = "code";
            pre.textContent = e.data.script;
            codeCol.appendChild(pre);
          }
          break;
        case "panel_request":
          if (e.data) showPanel(e.data);
          break;
        case "labware_assignments_request":
          if (e.data) showAssignmentsModal(e.data);
          break;
        case "binary_confirm_request":
          if (e.data) showBinaryModal(e.data);
          break;
        case "pipeline_done":
          setStatus("done", "#d4edda", "#155724");
          startBtn.disabled = false;
          hidePanel();
          break;
        case "error":
          setStatus("error", "#f8d7da", "#721c24");
          break;
      }
      // After any DOM mutation, re-render arrows so existing red
      // composite-step arrows track their new anchors.
      try { scheduleRender(); } catch (err) { /* defensive */ }
    }

    function connectWS() {
      const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
      const url = proto + "//" + window.location.host + "/events";
      const ws = new WebSocket(url);
      activeWS = ws;
      ws.onopen = () => { /* connection established; no-op */ };
      ws.onmessage = (msg) => {
        try {
          handleEvent(JSON.parse(msg.data));
        } catch (err) { /* parse error — skip */ }
      };
      ws.onerror = () => { setStatus("ws error", "#f8d7da", "#721c24"); };
      ws.onclose = () => { activeWS = null; };
    }

    // Assignments-modal button handlers (set up once; the buttons live
    // for the lifetime of the page).
    const assignConfirm = document.getElementById("live-assignments-confirm");
    const assignAbort = document.getElementById("live-assignments-abort");
    if (assignConfirm) assignConfirm.addEventListener("click", () => sendAssignmentsResponse("confirm"));
    if (assignAbort) assignAbort.addEventListener("click", () => sendAssignmentsResponse("abort"));
    // Binary-confirm button handlers (also set up once).
    const binYes = document.getElementById("live-binary-yes");
    const binNo = document.getElementById("live-binary-no");
    if (binYes) binYes.addEventListener("click", () => sendBinaryResponse("yes"));
    if (binNo) binNo.addEventListener("click", () => sendBinaryResponse("no"));

    startBtn.addEventListener("click", async () => {
      startBtn.disabled = true;
      setStatus("starting...", "#fff3cd", "#856404");
      try {
        const r = await fetch("/start", { method: "POST" });
        const j = await r.json();
        if (j.status === "started") {
          setStatus("running", "#fff3cd", "#856404");
        } else if (j.status === "already_running") {
          setStatus("already running", "#fff3cd", "#856404");
        } else {
          setStatus("start failed", "#f8d7da", "#721c24");
          startBtn.disabled = false;
        }
      } catch (err) {
        setStatus("network error", "#f8d7da", "#721c24");
        startBtn.disabled = false;
      }
    });

    connectWS();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLiveMode);
  } else {
    initLiveMode();
  }
})();
</script>

</body>
</html>
