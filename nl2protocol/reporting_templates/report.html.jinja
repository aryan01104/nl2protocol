<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>nl2protocol report — {{ timestamp }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=JetBrains+Mono:wght@400;500;700&display=swap">
<style>
  /* ───────── Layout ───────── */
  :root {
    /* ───────── Semantic provenance hues ─────────
       Aligned with website palette (cool slate + Tailwind 600s).
       Mapping:
         instruction → blue-600   (was red — semantic moved to disagree)
         config      → indigo-600 (kept distinct from domain)
         domain      → amber-600
         inferred    → orange-600
       Red now carries one meaning project-wide: reviewer-disagree. */
    --col-instruction: #2563eb;
    --col-config:      #4f46e5;
    --col-domain:      #d97706;
    --col-inferred:    #ea580c;

    /* ───────── Surfaces (Notion off-white + slate ink, per website) ───────── */
    --bg:              #f7f6f3;
    --panel:           #ffffff;
    --ink:             #0f172a;   /* slate-900                       */
    --dim:             #475569;   /* slate-600                       */
    --grid:            #e2e8f0;   /* slate-200 — borders             */
    --rule:            #cbd5e1;   /* slate-300 — stronger separators */

    /* ───────── Typography (IBM Plex Sans body, JetBrains Mono code) ───────── */
    --font-body:  "IBM Plex Sans", -apple-system, BlinkMacSystemFont,
                  "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-mono:  "JetBrains Mono", ui-monospace, "SF Mono", Menlo,
                  Consolas, monospace;

    /* ───────── Action buttons (slate-ink primary, slate-300 outline) ───────── */
    --btn-primary:           #0f172a;   /* matches --ink              */
    --btn-primary-fg:        #ffffff;
    --btn-secondary-border:  #cbd5e1;   /* slate-300                  */

    /* ───────── Status pills (Tailwind 100 bg / 800 fg pairs) ───────── */
    --status-success-bg:  #dcfce7;
    --status-success-fg:  #166534;
    --status-error-bg:    #fee2e2;
    --status-error-fg:    #991b1b;
    --status-warn-bg:     #fef3c7;
    --status-warn-fg:     #92400e;
    --status-neutral-bg:  #f1f5f9;
    --status-neutral-fg:  #475569;

    /* ───────── Modal / panel chrome (slate-100 header, slate-200 hover) ───────── */
    --modal-header-bg:        #f1f5f9;
    --panel-header-hover-bg:  #e2e8f0;
    --panel-empty-text:       #94a3b8;   /* slate-400                 */

    /* ───────── Warning chrome (amber family) ───────── */
    --warning-bg:        #fef3c7;   /* amber-100                     */
    --warning-text:      #78350f;   /* amber-900                     */
    --warning-accent:    #d97706;   /* amber-600 (= --col-domain)    */

    /* ───────── Live-mode stage indicator (amber working, green done) ───────── */
    --indicator-tan:     #d97706;
    --indicator-done:    #16a34a;

    /* ───────── Reviewer-disagree wash (red-100) ───────── */
    --disagree-bg:       #fee2e2;

    /* ───────── Resolution-arrow colors ───────── */
    --res-auto-accepted:        #16a34a;   /* green-600  */
    --res-user-accepted:        #15803d;   /* green-700  */
    --res-user-edited:          #2563eb;   /* blue-600   */
    --res-user-confirmed:       #94a3b8;   /* slate-400  */

    /* ───────── Inline-check pill (green family) ───────── */
    --check-pill-fg:     #166534;   /* green-800                      */
    --check-pill-glyph:  #16a34a;   /* green-600                      */

    /* ───────── Hover tooltip (slate-950 surface) ───────── */
    --tip-bg:            #020617;   /* slate-950                     */
    --tip-fg:            #f8fafc;   /* slate-50                      */
    --tip-dim:           #cbd5e1;   /* slate-300                     */
    --tip-cite-quote:    #fbbf24;   /* amber-400 (warm on dark)      */
    --tip-reasoning:     #e2e8f0;   /* slate-200                     */

    /* ───────── Per-citation palette (8 hues, Tailwind 600 family) ─────────
       Each unique cited_text in the instruction hashes to one slot;
       both the cite span (instruction column) and the atomic value
       span (spec column) share the hue. Uniform saturation level
       across the family for visual coherence. */
    --palette-0: #dc2626;   /* red-600     */
    --palette-1: #ea580c;   /* orange-600  */
    --palette-2: #d97706;   /* amber-600   */
    --palette-3: #16a34a;   /* green-600   */
    --palette-4: #0d9488;   /* teal-600    */
    --palette-5: #2563eb;   /* blue-600    */
    --palette-6: #7c3aed;   /* violet-600  */
    --palette-7: #db2777;   /* pink-600    */
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 14px/1.55 var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  header {
    padding: 24px 32px 16px;
    border-bottom: 1px solid var(--grid);
  }
  header h1 {
    margin: 0 0 4px;
    font-size: 20px;
    font-weight: 600;
  }
  header .meta {
    color: var(--dim);
    font-size: 13px;
  }
  .legend {
    display: flex; gap: 18px; margin-top: 12px; flex-wrap: wrap;
    font-size: 12px;
  }
  .legend .swatch {
    display: inline-block; width: 12px; height: 12px;
    border-radius: 2px; margin-right: 6px; vertical-align: middle;
  }

  /* ───────── 5-column grid ─────────
     Per ADR-0011 Phase 2a, the report renders five columns matching the
     pipeline's user-visible transformation milestones:
       1. Instruction
       2. Extracted Spec (post-extraction, immutable LLM output)
       3. Resolved Spec  (post-orchestrator gap resolution)
       4. Validated Spec (post-stage-5 CompleteProtocolSpec promotion)
       5. Generated Python
     Column 3 + column 4 are visually similar — both render provenanced
     spec values — but encode different stages of the pipeline. Phase 2b
     adds cross-column arrows showing each value's resolution journey. */
  .grid {
    display: grid;
    /* Each column is capped so the report stays scannable at wide
       viewports — column lines are unread above ~640px (prose) /
       ~600px (spec) / ~720px (code). Without the caps, on a 2K
       monitor the extracted spec would span the entire width of
       what should be a 5-column comparison view (CARRY-F2, PDF
       p.1). Mins keep each column readable when the viewport
       is narrow; defaults below get applied for each cols-N
       variant the live-mode gating reveals incrementally. */
    grid-template-columns:
      minmax(420px, 640px)
      minmax(340px, 600px) minmax(340px, 600px) minmax(340px, 600px)
      minmax(380px, 720px);
    gap: 14px;
    padding: 24px 32px;
    min-height: calc(100vh - 200px);
  }
  /* Phase 3g (Group B): live-mode column gating. Static reports always
     show all 5 columns; live mode starts with only column 1 (Instruction)
     visible and reveals each subsequent column as its stage's first
     event arrives. The grid template adapts to the visible column count
     so hidden columns don't leave empty tracks. The instruction-column
     cap is preserved in every reveal state. */
  .grid.cols-1 { grid-template-columns: minmax(420px, 640px); }
  .grid.cols-2 { grid-template-columns: minmax(420px, 640px) minmax(340px, 600px); }
  .grid.cols-3 { grid-template-columns: minmax(420px, 640px) minmax(340px, 600px) minmax(340px, 600px); }
  .grid.cols-4 { grid-template-columns: minmax(420px, 640px) minmax(340px, 600px) minmax(340px, 600px) minmax(340px, 600px); }
  .grid.cols-5 { grid-template-columns: minmax(420px, 640px) minmax(340px, 600px) minmax(340px, 600px) minmax(340px, 600px) minmax(380px, 720px); }
  .col.is-pending { display: none; }
  .col {
    background: var(--panel);
    border: 1px solid var(--grid);
    border-radius: 6px;
    padding: 16px;
    overflow-y: auto;
    max-height: 80vh;
  }
  .col h2 {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
    border-bottom: 1px solid var(--grid);
    padding-bottom: 8px;
  }

  /* ───────── Provenance color spans ─────────
     Two visual languages must NOT compete:
       - per-citation color → atomic instruction-sourced values; the same
                              hue lights both the cite span in the instruction
                              and the value span in the spec, so readers
                              connect them by hue rather than by arrow.
       - dotted underline   → values filled in by the model (domain_default
                              / inferred / config). Color stays categorical
                              by source kind. The underline tells readers
                              "this isn't a literal lift from the user."
       - arrow              → composite (step-existence) grounding only. */
  .prov-instruction    { font-weight: 500; cursor: help; /* hue comes from .palette-N */ }
  .prov-config         { color: var(--col-config);      font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }
  .prov-domain_default { color: var(--col-domain);      font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }
  .prov-inferred       { color: var(--col-inferred);    font-weight: 500; cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }

  /* ▴ marker prepended to non-instruction atomic values, repeated in the
     legend. Visual at-a-glance shorthand: "this value isn't a literal lift
     from the user — the model filled it in." Sized large enough to spot
     at column-scan distance, colored with --col-inferred so it reads as
     "model-filled" without any palette context. */
  .non-instr-marker {
    display: inline-block;
    margin-right: 4px;
    font-size: 14px;
    line-height: 1;
    color: var(--col-inferred);
    transform: translateY(1px);
  }

  /* ───────── Review-lifecycle badges (ADR-0009) ─────────
     The Provenance carries `review_status` (original / reviewed_agree /
     reviewed_disagree / user_confirmed / user_edited /
     user_accepted_suggestion / user_skipped). Only the two
     attention-worthy states get an inline badge; everything else surfaces
     in the tooltip.

       reviewed_disagree → red ⚠ superscript ("the reviewer pushed back here")
       user_edited       → blue ✎ marker     ("the user touched this value")

     Other non-default states (reviewed_agree, user_accepted_suggestion,
     user_confirmed, user_skipped) get the prov-review-* class for tooltip
     consumers but no inline glyph — they're positive/passive states and
     don't deserve column-scan attention. */
  .prov-review-reviewed-disagree::after {
    content: "⚠";
    margin-left: 3px;
    font-size: 10px;
    color: var(--col-instruction);
    vertical-align: super;
    font-weight: 700;
  }
  .prov-review-user-edited::after {
    content: "✎";
    margin-left: 3px;
    font-size: 11px;
    color: var(--res-user-edited);
    vertical-align: baseline;
  }

  /* ───────── Per-citation palette ─────────
     `.palette-N` paints the text for both:
       - .cite-marker.cite-atomic-color in the instruction column
       - .prov-instruction value spans in the spec column
     Same hue on both sides == same cited_text on both sides. */
  .palette-0 { color: var(--palette-0); }
  .palette-1 { color: var(--palette-1); }
  .palette-2 { color: var(--palette-2); }
  .palette-3 { color: var(--palette-3); }
  .palette-4 { color: var(--palette-4); }
  .palette-5 { color: var(--palette-5); }
  .palette-6 { color: var(--palette-6); }
  .palette-7 { color: var(--palette-7); }

  /* Hover-flip: when a cite-marker becomes "cite-active" (because the
     reader is hovering its matching value-span in the spec column), the
     cite span fills with its palette color and the text flips to a
     hardcoded contrast shade (white for dark hues, ink for light hues).
     The flip is done by overriding text color and adding a strong bg
     of the same palette hue. Per-palette contrast is hardcoded — chosen
     once for legibility, not computed. */
  .cite-marker.cite-atomic-color.palette-0.cite-active { background: var(--palette-0); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-1.cite-active { background: var(--palette-1); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-2.cite-active { background: var(--palette-2); color: var(--ink); }
  .cite-marker.cite-atomic-color.palette-3.cite-active { background: var(--palette-3); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-4.cite-active { background: var(--palette-4); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-5.cite-active { background: var(--palette-5); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-6.cite-active { background: var(--palette-6); color: var(--panel); }
  .cite-marker.cite-atomic-color.palette-7.cite-active { background: var(--palette-7); color: var(--panel); }

  /* ───────── Instruction column ───────── */
  .instruction-text {
    white-space: pre-wrap;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ───────── Spec / step rendering ───────── */
  .step {
    margin-bottom: 14px;
    padding: 10px 12px;
    border-left: 3px solid transparent;
    background: rgba(0, 0, 0, 0.015);
    border-radius: 0 4px 4px 0;
  }
  .step.step-orphan { border-left-color: var(--col-inferred); background: rgba(251, 133, 0, 0.05); }
  .step.step-grounded-instruction { border-left-color: var(--col-instruction); }
  .step.step-grounded-mixed { border-left-color: var(--col-domain); }
  .step-header {
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 6px;
    font-style: italic;
    cursor: help;
  }
  .step-action {
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--ink);
  }
  .step-detail {
    margin-left: 12px;
    font-size: 13px;
    color: var(--ink);
  }
  .step-detail .label { color: var(--dim); margin-right: 4px; }
  /* Footnote inside a step block — used for the `note` field on
     pause/comment steps so the body isn't empty. Small, dim, italic. */
  .step-note {
    margin-top: 6px;
    padding-top: 5px;
    border-top: 1px dashed var(--grid);
    font-size: 11px;
    font-style: italic;
    color: var(--dim);
    line-height: 1.4;
  }
  /* Step blocks are themselves hoverable — the JS tooltip surfaces
     the justification + optional domain expansion. */
  .step { cursor: help; }

  /* P1-8: inline constraint-check tag, placed right beside the value
     it verifies (e.g. "volume: 2.0 uL ✓ within p20 range (1–20 µL)").
     Green pill matches the WARNING legend's complement — tan = "look
     at this", green = "this was verified." The column-level toggle
     (.col.checks-hidden) below hides all of these in one click for
     users who've built trust and want a cleaner view. */
  .inline-check {
    display: inline;
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--check-pill-glyph) 8%, transparent);
    color: var(--check-pill-fg);
    font-size: 11px;
    font-style: normal;
    white-space: nowrap;
    vertical-align: middle;
  }
  .inline-check::before {
    content: "\2713 ";   /* ✓ */
    color: var(--check-pill-glyph);
    font-weight: 700;
  }
  .col.checks-hidden .inline-check { display: none; }

  /* P1-8 toggle button — sits above the step list in the validated-spec
     column. Clicking it toggles the `.checks-hidden` class on the
     column (handled by JS at the end of the template). State is
     persisted in localStorage so a returning visitor gets their last
     choice automatically. */
  .checks-toggle-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    font-size: 11px;
    color: var(--dim);
  }
  .checks-toggle-btn {
    background: color-mix(in srgb, var(--check-pill-glyph) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--check-pill-glyph) 40%, transparent);
    color: var(--check-pill-fg);
    padding: 3px 9px;
    border-radius: 3px;
    font: inherit;
    cursor: pointer;
  }
  .checks-toggle-btn:hover { background: color-mix(in srgb, var(--check-pill-glyph) 15%, transparent); }

  /* P1-9: per-step constraint warning, rendered inline at the bottom
     of the step row in the validated-spec column. Tan left-border +
     subtle background tint matches the WARNING legend color added
     in Task #8. Slightly larger font than the global summary list
     to address the "very small text" feedback. */
  .step-warning {
    margin-top: 8px;
    padding: 6px 10px;
    border-left: 3px solid var(--warning-accent);
    background: var(--warning-bg);
    font-size: 13px;
    line-height: 1.45;
    color: var(--warning-text);
    border-radius: 2px;
  }
  .step-warning-line {
    /* Preserve the multi-line "Why: / Suggestion:" structure that
       constraints.py emits — without `pre-wrap` the indentation that
       carries those sub-claims would collapse. */
    white-space: pre-wrap;
  }
  .step-warning-line + .step-warning-line {
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid color-mix(in srgb, var(--warning-accent) 25%, transparent);
  }

  /* ───────── Code column ───────── */
  pre.code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
    white-space: pre;
    overflow-x: auto;
    color: var(--ink);
  }
  /* Phase 3i (#72): per-line spans inside <pre.code>. Each <span> ends
     in a literal newline so the <pre> still wraps line-by-line. The
     spans get [data-script-step="s{idx}"] when their line was emitted
     by a spec step's command — these participate in the hover-pair
     handler. Lines with no step tag (prelude — module/labware loads)
     stay neutral. */
  pre.code .code-line {
    display: inline;
    transition: background 0.12s ease;
  }
  pre.code .code-line[data-script-step]:hover,
  pre.code .code-line.is-script-linked {
    background: rgba(184, 68, 79, 0.10);
  }
  /* Validated-spec block highlight when matching code lines are hovered. */
  .col-validated-spec .step.is-script-linked {
    background: rgba(184, 68, 79, 0.06);
    border-left-color: var(--col-instruction);
  }

  /* ───────── Cite markers in instruction ─────────
     Three cite kinds, three treatments:
       composite-step  → arrow ANCHOR. Subtle underline (muted red) at
                         rest, brightens on hover; pairs with the SVG
                         arrow into the step block. Multiple step cites
                         can share one anchor (fan-out arrows).
       atomic-color    → COLOR MATCH. The .palette-N class on the same
                         span paints the substring the same hue as the
                         atomic value in the spec column — no arrow.
       q2-cohesion     → ON-HOVER hint. Invisible at rest; tints when
                         its step block is hovered, showing which
                         instruction fragments answer "why these
                         parameters cohere as one step." */
  .cite-marker {
    cursor: pointer;
    padding: 0 1px;
    transition: background 0.12s, border-color 0.12s;
  }
  .cite-composite-step {
    background: rgba(184, 68, 79, 0.05);
    border-bottom: 2px solid rgba(184, 68, 79, 0.45);
  }
  .cite-composite-step:hover,
  .cite-composite-step.cite-active {
    background: rgba(184, 68, 79, 0.18);
    border-bottom-color: rgba(184, 68, 79, 0.85);
  }
  .cite-atomic-color {
    /* color comes from the .palette-N class on the same span */
    font-weight: 500;
  }
  .cite-atomic-color:hover,
  .cite-atomic-color.cite-active {
    background: rgba(0, 0, 0, 0.06);
    border-radius: 2px;
  }
  .cite-q2-cohesion {
    /* deliberately unstyled at rest — reads as plain prose */
    transition: background 0.15s;
  }
  .cite-q2-cohesion.q2-active {
    background: rgba(184, 68, 79, 0.10);
    border-radius: 2px;
  }
  .step.step-active {
    background: rgba(184, 68, 79, 0.06);
    border-left-color: var(--col-instruction);
  }

  /* ───────── Phase 3h (#68) + 2026-05-06 polish: fade-in for live-mode blocks ─────────
     Live-mode appendStepBlocks adds .fade-in (opacity 0) to each new
     step, then schedules .is-visible with a per-index stagger so blocks
     reveal one-by-one in step order rather than all at once. Static
     reports never apply .fade-in — the Jinja loop renders blocks
     without these classes, so archived reports have no opacity tricks.

     Per ADR-0011 animation-timing addendum (2026-05-06): opacity-only.
     The previous translateY(2px) slide caused arrow tips captured
     mid-slide to land 2px below the block's settled position. Block
     positions are now stable from frame 1; only opacity transitions. */
  .step.fade-in {
    opacity: 0;
    transition: opacity 0.605s ease;
  }
  .step.fade-in.is-visible {
    opacity: 1;
  }

  /* ───────── Phase 3i (#72): validated-spec constraint summary banner ─────────
     Small status block above the validated-spec column's blocks
     showing what the constraint checker found. Three states:
     all-clear (green), has-warnings (tan), has-errors (red).
     Hidden when empty (no event captured yet — typical during early
     live-mode load). */
  .validated-summary {
    margin-bottom: 12px;
    padding: 8px 10px;
    border-radius: 4px;
    border: 1px solid var(--grid);
    background: rgba(0, 0, 0, 0.015);
    font-size: 12px;
    line-height: 1.4;
  }
  .validated-summary.is-empty { display: none; }
  .validated-summary-line { color: var(--ink); }
  .validated-summary-line.all-clear { border-left: 3px solid var(--check-pill-glyph); padding-left: 6px; }
  .validated-summary-line.has-warnings { border-left: 3px solid var(--warning-accent); padding-left: 6px; }
  .validated-summary-line.has-errors { border-left: 3px solid var(--col-instruction); padding-left: 6px; }
  .validated-summary-warnings {
    margin: 6px 0 0;
    padding-left: 18px;
    color: var(--dim);
    font-size: 11px;
  }
  .validated-summary-warnings li { margin: 1px 0; }
  span[data-prov-id]:hover,
  span[data-prov-id].prov-active,
  span[data-prov-id].prov-spotlight {
    outline: 1px solid currentColor;
    outline-offset: 1px;
    border-radius: 2px;
  }

  /* ───────── Phase 3j (#73): gap modal attach arrows ─────────
     Dotted SVG paths from the gap-prompt modal to each cell the gap
     is about. Lives in #arrow-overlay alongside the static path's
     composite-step arrows + resolution arrows; cleared when the
     modal closes. The "flowing dashes" animation communicates which
     direction the attachment runs (modal → target). */
  .modal-attach-arrow {
    fill: none;
    stroke: var(--col-instruction);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
    stroke-linecap: round;
    opacity: 0.7;
    animation: modal-attach-flow 0.6s linear infinite;
    pointer-events: none;
  }
  @keyframes modal-attach-flow {
    to { stroke-dashoffset: -14; }
  }

  /* ───────── ADR-0013 Phase 3b-3 (Group C): modal spotlight ─────────
     When a gap modal pops asking the user about an initial-contents
     volume (or similar field that has cross-column anchor cells), the
     server stamps the relevant prov-ids onto gap.metadata.spotlight_prov_ids;
     the browser adds .prov-spotlight to those cells for the duration of
     the modal. Visually identical to the hover/active fill+flip — same
     palette/source rules apply (see selectors below). Distinct CLASS
     from .prov-active so hover-leave handlers don't accidentally clear
     the spotlight while the user is exploring other cells. */

  /* ───────── ADR-0011 Phase 2b/4 polish: hover-flip on value cells ─────────
     Mirrors the cite-side `.cite-marker.cite-atomic-color.palette-N.cite-active`
     pattern from above. When a value cell is hovered (or panel-row hover
     marks it .prov-active), the cell fills with its color and the text
     flips to white/black for contrast. Same visual language on both
     sides of the cite ↔ value pair. */
  span.palette-0.prov-active, span.palette-0.prov-spotlight, span.palette-0[data-prov-id]:hover { background: var(--palette-0); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-1.prov-active, span.palette-1.prov-spotlight, span.palette-1[data-prov-id]:hover { background: var(--palette-1); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-2.prov-active, span.palette-2.prov-spotlight, span.palette-2[data-prov-id]:hover { background: var(--palette-2); color: var(--ink);   outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-3.prov-active, span.palette-3.prov-spotlight, span.palette-3[data-prov-id]:hover { background: var(--palette-3); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-4.prov-active, span.palette-4.prov-spotlight, span.palette-4[data-prov-id]:hover { background: var(--palette-4); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-5.prov-active, span.palette-5.prov-spotlight, span.palette-5[data-prov-id]:hover { background: var(--palette-5); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-6.prov-active, span.palette-6.prov-spotlight, span.palette-6[data-prov-id]:hover { background: var(--palette-6); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.palette-7.prov-active, span.palette-7.prov-spotlight, span.palette-7[data-prov-id]:hover { background: var(--palette-7); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }

  /* Non-instruction sources without palette: use their categorical hue. */
  span.prov-config.prov-active,         span.prov-config.prov-spotlight,         span.prov-config[data-prov-id]:hover         { background: var(--col-config);      color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }
  span.prov-domain_default.prov-active, span.prov-domain_default.prov-spotlight, span.prov-domain_default[data-prov-id]:hover { background: var(--col-domain);      color: var(--ink);   outline: none; text-decoration: none; border-radius: 2px; }
  span.prov-inferred.prov-active,       span.prov-inferred.prov-spotlight,       span.prov-inferred[data-prov-id]:hover       { background: var(--col-inferred);    color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }

  /* Instruction-sourced spans WITHOUT a palette (cite not recoverable):
     fall back to instruction-red. Spans WITH a palette take the palette
     rules above (later in the cascade with the same specificity, so
     palette wins by source order). */
  span.prov-instruction.prov-active,    span.prov-instruction.prov-spotlight,    span.prov-instruction[data-prov-id]:hover    { background: var(--col-instruction); color: var(--panel); outline: none; text-decoration: none; border-radius: 2px; }

  /* ───────── ADR-0011 Phase 2b/4 polish: ✗ placeholder cells ─────────
     For action-expected fields that are null on the step, the renderer
     emits a placeholder carrying a matching data-prov-id. This gives
     resolution arrows their origin anchor (extracted column has the ✗,
     resolved column has the filled value, arrow draws between them)
     and gives panel-row hover a target in both columns. */
  .cell-empty {
    color: var(--dim);
    font-style: italic;
    font-size: 11px;
    cursor: help;
    padding: 0 2px;
  }
  .cell-empty em {
    font-size: 10px;
  }
  .cell-empty.prov-active,
  .cell-empty.prov-spotlight,
  .cell-empty[data-prov-id]:hover {
    background: color-mix(in srgb, var(--col-instruction) 8%, transparent);
    border-radius: 2px;
    outline: 1px solid color-mix(in srgb, var(--col-instruction) 35%, transparent);
    outline-offset: 1px;
  }

  /* ───────── JS hover tooltip (replaces native title=) ───────── */
  #hover-tip {
    position: fixed;
    z-index: 100;
    max-width: 360px;
    padding: 10px 12px;
    background: var(--tip-bg);
    color: var(--tip-fg);
    font-size: 12px;
    line-height: 1.45;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s ease;
    white-space: normal;
  }
  #hover-tip.visible { opacity: 1; }
  #hover-tip .tip-meta {
    color: var(--tip-dim);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  #hover-tip .tip-cite {
    font-style: italic;
    color: var(--tip-cite-quote);
    margin-bottom: 6px;
  }
  #hover-tip .tip-reasoning { color: var(--tip-reasoning); }
  #hover-tip .tip-section { margin-top: 8px; }
  /* Indented blockquote of the step's cited text. The left bar uses the
     step-trigger color (vivid red for instruction grounding) so readers
     see "this is the literal phrase that triggered the step" without
     needing the inline cite-id attr. */
  #hover-tip .tip-quote {
    margin: 8px 0 0;
    padding: 4px 0 4px 10px;
    border-left: 3px solid var(--col-instruction);
    color: var(--tip-cite-quote);
    font-style: italic;
    line-height: 1.4;
  }
  /* When step_palette_class is set, the left bar takes that hue. */
  #hover-tip .tip-quote.palette-0 { border-left-color: var(--palette-0); }
  #hover-tip .tip-quote.palette-1 { border-left-color: var(--palette-1); }
  #hover-tip .tip-quote.palette-2 { border-left-color: var(--palette-2); }
  #hover-tip .tip-quote.palette-3 { border-left-color: var(--palette-3); }
  #hover-tip .tip-quote.palette-4 { border-left-color: var(--palette-4); }
  #hover-tip .tip-quote.palette-5 { border-left-color: var(--palette-5); }
  #hover-tip .tip-quote.palette-6 { border-left-color: var(--palette-6); }
  #hover-tip .tip-quote.palette-7 { border-left-color: var(--palette-7); }
  /* Reviewer-objection box uses the instruction-red bar to signal "flagged
     concern, attention needed" — distinct from the step-blockquote palettes. */
  #hover-tip .tip-objection {
    margin: 8px 0 0;
    padding: 4px 0 4px 10px;
    border-left: 3px solid var(--col-instruction);
    color: var(--tip-cite-quote);
    font-style: italic;
    line-height: 1.4;
  }

  /* ───────── SVG arrow overlay ─────────
     The overlay hosts TWO arrow categories:
       - Composite-step arrows (instruction → extracted spec block).
         Reserved for step-existence grounding; existing pre-Phase-2b
         language. Default red (--col-instruction).
       - Resolution arrows (extracted spec atomic value → resolved
         spec atomic value). One per gap_resolved event with a
         drawable resolution_kind. Per ADR-0011 Phase 2b. Color-coded
         per resolution kind. */
  #arrow-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 50;
  }
  #arrow-overlay path {
    fill: none;
    stroke: var(--col-instruction);
    stroke-opacity: 0.32;
    stroke-width: 2.5;
    transition: stroke-opacity 0.12s, stroke-width 0.12s;
  }
  #arrow-overlay path.arrow-active {
    stroke-opacity: 0.9;
    stroke-width: 3.5;
  }

  /* Resolution arrows (extracted → resolved column).
     Color encodes how the gap was resolved:
       auto_accepted             → subtle green   (no human attention needed)
       user_accepted_suggestion  → gray-green     (human confirmed the suggester)
       user_edited               → blue           (human typed a new value)
       user_confirmed            → soft gray      (human confirmed without change)
     Stroke width slightly thinner than composite-step arrows so the
     two categories visually separate. */
  #arrow-overlay path.resolution-arrow {
    stroke-width: 2;
    stroke-opacity: 0.35;
  }
  #arrow-overlay path.resolution-arrow.arrow-active {
    stroke-opacity: 0.9;
    stroke-width: 3;
  }
  #arrow-overlay path.res-auto_accepted            { stroke: var(--res-auto-accepted); }
  #arrow-overlay path.res-user_accepted_suggestion { stroke: var(--res-user-accepted); }
  #arrow-overlay path.res-user_edited              { stroke: var(--res-user-edited); }
  #arrow-overlay path.res-user_confirmed           { stroke: var(--res-user-confirmed); }

  /* ───────── ADR-0011 Phase 2c: confirmation summary panels ─────────
     Two read-only audit tables rendered below the 5-col grid:
       Lab state  (initial_contents + prefilled_labware as a flat table)
       Labware    (description → resolved_label deduped mapping)
     Replay-mode static surfaces. Live mode (Phase 3) replaces these
     with the editable bottom-right floating panel; same data shape,
     different positioning + interactivity. */
  .panels {
    padding: 16px 32px 0;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 18px;
  }
  .panel {
    background: var(--panel);
    border: 1px solid var(--grid);
    border-radius: 6px;
    overflow: hidden;
  }
  .panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 10px 14px;
    user-select: none;
    background: var(--modal-header-bg);
    border-bottom: 1px solid var(--grid);
    transition: background 0.15s;
  }
  .panel-header:hover { background: var(--panel-header-hover-bg); }
  .panel-chevron {
    font-size: 11px;
    color: var(--dim);
    width: 12px;
    transition: transform 0.18s ease;
    transform-origin: 50% 50%;
  }
  .panel.is-collapsed .panel-chevron {
    transform: rotate(-90deg);
  }
  .panel-count {
    margin-left: auto;
    font-size: 11px;
    color: var(--dim);
    font-weight: 500;
  }
  .panel.is-empty .panel-count { color: var(--panel-empty-text); }
  .panel-body {
    padding: 12px 16px 14px;
    max-height: 400px;
    overflow-y: auto;
    transition: max-height 0.2s ease, padding 0.2s ease, opacity 0.18s ease;
  }
  .panel.is-collapsed .panel-body {
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    overflow: hidden;
  }
  .panel-header h3 {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--dim);
    padding: 0;
    border-bottom: none;
  }
  .panel table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .panel th, .panel td {
    text-align: left;
    padding: 4px 8px;
    border-bottom: 1px dotted var(--grid);
  }
  .panel th {
    color: var(--dim);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .panel td.col-volume {
    font-family: var(--font-mono);
    text-align: right;
    color: var(--ink);
  }
  .panel td.col-substance,
  .panel td.col-description {
    font-style: italic;
    color: var(--ink);
  }
  .panel td.col-label {
    font-weight: 500;
    color: var(--ink);
  }
  .panel .empty {
    color: var(--dim);
    font-style: italic;
    padding: 4px 0;
  }
  /* Phase 4 polish: row hover for cross-column highlighting. The row
     becomes a hover target that lights up cells in the spec columns
     via the existing data-prov-id system. */
  .panel tbody tr[data-target-cells]:hover,
  .panel tbody tr.row-active {
    background: color-mix(in srgb, var(--col-instruction) 6%, transparent);
    cursor: help;
  }

  /* ───────── ADR-0013 Phase 3g (Group B): live-mode stage indicator ─────────
     Top-right floating progress badge. Plain tan text on the page bg —
     no pill, no dark surface. Two lines: stage label + sub-action. A
     small leading dot pulses while the pipeline is working; freezes to
     a static "✓" tick when the run completes. Static reports never
     instantiate this (#live-stage-indicator is rendered only when the
     server template flag live_mode=True). */
  #live-stage-indicator {
    position: fixed;
    top: 18px;
    right: 22px;
    z-index: 1100;
    font: 13px/1.35 var(--font-body);
    color: var(--indicator-tan);
    text-align: right;
    user-select: none;
    max-width: 320px;
  }
  #live-stage-indicator .indicator-line-main {
    font-weight: 600;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }
  #live-stage-indicator .indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--indicator-tan);
    animation: indicator-pulse 1.1s ease-in-out infinite;
  }
  #live-stage-indicator.is-done .indicator-dot {
    animation: none;
    background: var(--indicator-done);
  }
  #live-stage-indicator .indicator-line-sub {
    font-size: 12px;
    font-style: italic;
    margin-top: 2px;
    opacity: 0.85;
    min-height: 14px;
    transition: opacity 0.18s ease;
  }
  @keyframes indicator-pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.85); }
    50%      { opacity: 1.0;  transform: scale(1.0);  }
  }

  /* ───────── Footer ───────── */
  footer {
    padding: 16px 32px 24px;
    border-top: 1px solid var(--grid);
    color: var(--dim);
    font-size: 12px;
    display: flex;
    justify-content: space-between;
  }
  footer a { color: var(--dim); }
</style>
</head>
<body>

<header>
  {# Upper-left header block — only rendered for the static post-run report.
     In live serve mode, the upper-right `#live-stage-indicator` (below) is
     the single source of truth for run status; the "Generated <time> ·
     Status: failed" pre-render here was grandfathered from when this
     template was a post-run-only artifact and misled live-mode visitors. #}
  {% if not live_mode %}
  {# P2-1: header copy after Task #2 deleted the block from live mode.
     User flagged "generated" / "status" / "report" as useless or unnecessary
     for the static-artifact use case. Each word is removed where it doesn't
     carry information the surrounding context already gives:
       - drop "report" from the title (filename + content already signal it)
       - drop "Generated" prefix (the timestamp speaks for itself)
       - drop "Status:" label (the colored success/failed token speaks for itself) #}
  <h1>nl2protocol</h1>
  <div class="meta">
    {{ timestamp }} ·
    {% if success %}<strong style="color:var(--status-success-fg)">success</strong>{% else %}<strong style="color:var(--col-instruction)">failed</strong>{% endif %}
    {% if prov_stats and prov_stats.total %}
      · <span title="Atomic values whose provenance is NOT a literal lift from the instruction (i.e. domain default / inferred / config). Higher = more was filled in by the model.">{{ prov_stats.total }} atomic values · <strong>{{ "%.0f"|format(prov_stats.non_instr_pct) }}%</strong> non-instruction (model-filled)</span>
    {% endif %}
  </div>
  {% endif %}
  {% if live_mode %}
  <!-- ADR-0013 Phase 3g (Group B): top-right stage indicator. Floats
       above the page; tracks the pipeline's current stage + plain-
       language sub-action. JS in initLiveMode wires it to stage_started
       and pipeline_progress events. -->
  <div id="live-stage-indicator">
    <div class="indicator-line-main">
      <span class="indicator-dot"></span>
      <span id="indicator-stage-text">idle</span>
    </div>
    <div id="indicator-substep" class="indicator-line-sub"></div>
  </div>
  <!-- ADR-0013 Phase 3b-1 + hosted-deploy form: live-mode control bar.
       Only shown when the template renders for the FastAPI server's GET /.
       The static HTMLReporter path doesn't set live_mode so this stays
       hidden. User picks an example OR uploads their own files, supplies
       their Anthropic API key, then submits. /start receives JSON. -->
  <div class="live-controls" style="margin-top: 10px; padding: 12px 14px; border: 1px solid var(--grid); border-radius: 6px; background: var(--panel); display: flex; flex-direction: column; gap: 10px;">
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <label for="live-example-select" style="font-size: 13px; color: var(--ink);">Protocol:</label>
      <select id="live-example-select" style="font: 13px var(--font-body); padding: 5px 8px; border: 1px solid var(--btn-secondary-border); border-radius: 4px; min-width: 220px;">
        <option value="">— choose —</option>
      </select>
      <span style="color: var(--dim); font-size: 12px;">or</span>
      <button type="button" id="live-upload-toggle" style="font: 13px var(--font-body); padding: 5px 10px; border: 1px solid var(--btn-secondary-border); background: var(--panel); cursor: pointer; border-radius: 4px;">Upload your own…</button>
    </div>
    <div id="live-upload-group" style="display: none; gap: 10px; align-items: center; flex-wrap: wrap; padding: 8px 10px; background: var(--modal-header-bg); border-radius: 4px;">
      <label style="font-size: 12px; color: var(--ink);">Instruction (.txt): <input type="file" id="live-instruction-file" accept=".txt,.md,text/plain" style="font-size: 12px;"></label>
      <label style="font-size: 12px; color: var(--ink);">Config (.json): <input type="file" id="live-config-file" accept=".json,application/json" style="font-size: 12px;"></label>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <label for="live-api-key" style="font-size: 13px; color: var(--ink);">Anthropic key:</label>
      <input type="password" id="live-api-key" placeholder="{% if local_dev_mode %}(local dev — leave empty to use env key){% else %}sk-ant-…{% endif %}" autocomplete="off" style="font: 13px var(--font-mono); padding: 5px 8px; border: 1px solid var(--btn-secondary-border); border-radius: 4px; min-width: 280px;">
      <button id="live-start-btn" style="font: 14px var(--font-body); padding: 6px 14px; border: 1px solid var(--btn-primary); background: var(--btn-primary); color: var(--btn-primary-fg); cursor: pointer; border-radius: 4px;">▶ Start pipeline</button>
      <span id="live-status" style="display: inline-block; padding: 2px 10px; border-radius: 3px; font-size: 12px; background: var(--status-success-bg); color: var(--status-success-fg);">idle</span>
    </div>
    <div style="color: var(--dim); font-size: 11px; line-height: 1.5;">
      Your key is used only for this request and never stored. Events stream as the pipeline runs; a static report is archived to <code>output/</code> at end-of-run.
    </div>
  </div>
  <!-- ADR-0013 Phase 3e: small Y/N modal for stand-alone binary
       confirmations (inferred-source containers, hardware-error
       proceed). Center-screen overlay, but visually lighter than the
       assignments modal — typically just a list + 2 buttons. -->
  <div id="live-binary-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.30); z-index: 1050; align-items: center; justify-content: center;">
    <div style="background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 10px 32px rgba(0,0,0,0.22); width: min(520px, 92vw); max-height: 80vh; overflow-y: auto; font-size: 13px;">
      <div id="live-binary-title" style="padding: 12px 18px; border-bottom: 1px solid var(--grid); background: var(--modal-header-bg); font-weight: 600;"></div>
      <div id="live-binary-body" style="padding: 14px 18px;"></div>
      <div style="padding: 10px 18px; border-top: 1px solid var(--grid); display: flex; gap: 8px; justify-content: flex-end;">
        <button id="live-binary-no" style="padding: 6px 14px; border: 1px solid var(--btn-secondary-border); background: var(--panel); color: var(--ink); border-radius: 4px; cursor: pointer; font-size: 13px;">No</button>
        <button id="live-binary-yes" style="padding: 6px 14px; border: 1px solid var(--btn-primary); background: var(--btn-primary); color: var(--btn-primary-fg); border-radius: 4px; cursor: pointer; font-size: 13px;">Yes</button>
      </div>
    </div>
  </div>
  <!-- ADR-0013 Phase 3f (Group D): initial-contents batch modal.
       Hidden until an initial_contents_request arrives. Center-screen
       overlay; one row per IC entry with an editable volume cell.
       Replaces N per-Gap orchestrator modals with one batch table —
       user accepts defaults wholesale or edits any row inline. Step
       1 of 3 in the post-extraction confirmation sequence. -->
  <div id="live-ic-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 1100; align-items: center; justify-content: center;">
    <div style="background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 12px 40px rgba(0,0,0,0.25); width: min(720px, 92vw); max-height: 86vh; overflow-y: auto; font-size: 13px;">
      <div style="padding: 12px 18px; border-bottom: 1px solid var(--grid); background: var(--modal-header-bg); font-weight: 600;">
        Confirm initial contents
        <span style="float: right; font-size: 11px; color: var(--dim); font-weight: 500;">step 1 of 3 · accept defaults or edit any row</span>
      </div>
      <div style="padding: 10px 18px; border-bottom: 1px solid var(--grid); font-size: 13px; color: var(--ink); line-height: 1.55;">
        Pre-fill these wells before running the protocol. <em>Italic</em> volumes are defaults the system filled in for you; <strong>normal weight</strong> volumes came from your instruction. Click any number to edit before confirming.
      </div>
      <div id="live-ic-body" style="padding: 14px 18px;"></div>
      <div style="padding: 10px 18px; border-top: 1px solid var(--grid); display: flex; gap: 8px; justify-content: flex-end;">
        <button id="live-ic-abort" style="padding: 6px 14px; border: 1px solid var(--btn-secondary-border); background: var(--panel); color: var(--ink); border-radius: 4px; cursor: pointer; font-size: 13px;">Quit</button>
        <button id="live-ic-confirm" style="padding: 6px 14px; border: 1px solid var(--btn-primary); background: var(--btn-primary); color: var(--btn-primary-fg); border-radius: 4px; cursor: pointer; font-size: 13px;">Confirm</button>
      </div>
    </div>
  </div>
  <!-- ADR-0013 Phase 3d: labware-assignments confirmation modal.
       Hidden until a labware_assignments_request arrives. Center-screen
       overlay (different from the per-Gap bottom-right panel) — the
       table can be tall (one row per unique LocationRef description)
       and benefits from being the user's only focus.
       JS in initLiveMode wires up populate + submit. -->
  <div id="live-assignments-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 1100; align-items: center; justify-content: center;">
    <div style="background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 12px 40px rgba(0,0,0,0.25); width: min(720px, 92vw); max-height: 86vh; overflow-y: auto; font-size: 13px;">
      <div style="padding: 12px 18px; border-bottom: 1px solid var(--grid); background: var(--modal-header-bg); font-weight: 600;">
        Confirm labware assignments
        <span style="float: right; font-size: 11px; color: var(--dim); font-weight: 500;">step 3 of 3 · change any row, or confirm to accept all</span>
      </div>
      <div id="live-assignments-body" style="padding: 14px 18px;"></div>
      <div style="padding: 10px 18px; border-top: 1px solid var(--grid); display: flex; gap: 8px; justify-content: flex-end;">
        <button id="live-assignments-abort" style="padding: 6px 14px; border: 1px solid var(--btn-secondary-border); background: var(--panel); color: var(--ink); border-radius: 4px; cursor: pointer; font-size: 13px;">Quit</button>
        <button id="live-assignments-confirm" style="padding: 6px 14px; border: 1px solid var(--btn-primary); background: var(--btn-primary); color: var(--btn-primary-fg); border-radius: 4px; cursor: pointer; font-size: 13px;">Confirm</button>
      </div>
    </div>
  </div>
  <!-- ADR-0013 Phase 3c: gap-prompt modal. Hidden until a panel_request
       arrives over the WebSocket. Anchored bottom-right per ADR-0013. -->
  <div id="live-panel" style="display: none; position: fixed; right: 24px; bottom: 24px; width: 380px; max-height: 70vh; overflow-y: auto; background: var(--panel); border: 1px solid var(--grid); border-radius: 6px; box-shadow: 0 6px 24px rgba(0,0,0,0.18); z-index: 1000; font-size: 13px;">
    <div style="padding: 10px 14px; border-bottom: 1px solid var(--grid); background: var(--modal-header-bg); font-weight: 600;">
      <span id="live-panel-title">Confirm gap</span>
      <span id="live-panel-severity" style="float: right; font-size: 11px; padding: 1px 8px; border-radius: 3px; background: var(--status-neutral-bg); color: var(--dim); font-weight: 500;"></span>
    </div>
    <div style="padding: 12px 14px;">
      <div id="live-panel-description" style="margin-bottom: 8px;"></div>
      <div id="live-panel-current" style="margin-bottom: 8px; color: var(--dim); font-size: 12px;"></div>
      <div id="live-panel-suggestion" style="margin-bottom: 10px;"></div>
      <div id="live-panel-reasoning" style="font-size: 12px; color: var(--dim); font-style: italic; margin-bottom: 10px;"></div>
      <!-- Reviewer objection. Populated by showPanel() when the
           gap.metadata.reviewer_objection field is non-empty. Orange-tinted
           to match the legend's "⚠ reviewer disagreed" marker. Hidden by
           default; showPanel toggles display. -->
      <div id="live-panel-objection" style="display: none; margin-bottom: 10px; padding: 8px 10px; border-left: 3px solid var(--col-instruction); background: var(--disagree-bg); font-size: 12px;"></div>
    </div>
    <div id="live-panel-buttons" style="padding: 10px 14px; border-top: 1px solid var(--grid); display: flex; gap: 8px; flex-wrap: wrap;">
      <!-- buttons injected per-gap by JS (accept / skip / override / abort) -->
    </div>
  </div>
  {% endif %}
  {# Legend is the decoder ring for the report's visual encoding. Grouped
     into four logical concepts (instruction-sourced, model-filled, review
     markers, step-block grounding) so a reader can scan one group at a
     time. The model-filled row shows ▴ + dotted underline + categorical
     color side-by-side so readers see they're three cues for one fact
     (rather than three separate signals to decode). #}
  <div class="legend">
    <span><span class="swatch" style="background: var(--col-instruction)"></span>→ step decomposition · instruction-sourced atoms get per-citation hue (cite ↔ value)</span>

    <span><span class="non-instr-marker">▴</span><span style="text-decoration: underline dotted; text-underline-offset: 2px;">value</span> = model-filled atom (marker + dotted underline + categorical color — three cues for one fact):<span class="swatch" style="background: var(--col-config); margin-left: 8px;"></span>config ·<span class="swatch" style="background: var(--col-domain);"></span>domain ·<span class="swatch" style="background: var(--col-inferred);"></span>inferred</span>

    <span><span style="color: var(--col-instruction); font-weight: 700;">⚠</span> reviewer disagreed (hover for objection) · <span style="color: var(--res-user-edited);">✎</span> user-edited during gap resolution</span>

    <span>step-block left border signals grounding:<span class="swatch" style="background: var(--col-instruction); margin-left: 8px;"></span>grounded ·<span class="swatch" style="background: var(--col-domain);"></span>mixed ·<span class="swatch" style="background: var(--col-inferred);"></span>orphan</span>

    <span><span style="color: var(--res-auto-accepted); font-weight: 700;">→</span> resolution arrow links a cell across extracted ↔ resolved spec — green = auto/user-accepted, blue = user-edited, gray = user-confirmed unchanged</span>
  </div>
</header>

<!-- ───────── ADR-0011 Phase 2c (Group C revision): bar-box panels ─────────
     Lab state + labware-mapping audit views. Repositioned above the grid
     (previously below) since they show pre-grid state — what the user is
     pre-filling and what config the resolver picked. Collapsible side-by-side
     bars: header is always visible; body collapses with a chevron toggle.
     Default state: expanded when populated, collapsed when empty (no
     attention-pull on an empty placeholder). Lab-state surfaces
     initial_contents + prefilled_labware; labware-mapping surfaces
     description → resolved_label. Both share the panel-row hover wiring
     (data-target-cells) so hovering a row still highlights matching
     spec cells across the columns. -->
<section class="panels">
  <div class="panel panel-lab-state is-collapsed{% if not lab_state_rows %} is-empty{% endif %}">
    <div class="panel-header" data-panel-toggle>
      <span class="panel-chevron">▾</span>
      <h3>Lab state before run</h3>
      <span class="panel-count">{{ lab_state_rows|length }} {{ "entry" if lab_state_rows|length == 1 else "entries" }}</span>
    </div>
    <div class="panel-body">
      {% if lab_state_rows %}
        <table>
          <thead>
            <tr>
              <th>labware</th>
              <th>well</th>
              <th>substance</th>
              <th>volume</th>
            </tr>
          </thead>
          <tbody>
            {% for row in lab_state_rows %}
              <tr data-target-cells="{{ row.target_prov_ids|e }}">
                <td class="col-label">{{ row.labware|e }}</td>
                <td>{{ row.well|e if row.kind == "well" else "(all wells)" }}</td>
                <td class="col-substance">{{ row.substance|e }}</td>
                <td class="col-volume">{{ row.volume_ul|round(0)|int ~ " uL" if row.volume_ul is not none else "—" }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="empty">(no initial-state entries)</div>
      {% endif %}
    </div>
  </div>

  <div class="panel panel-labware-mapping is-collapsed{% if not labware_mapping_rows %} is-empty{% endif %}">
    <div class="panel-header" data-panel-toggle>
      <span class="panel-chevron">▾</span>
      <h3>Labware assignments</h3>
      <span class="panel-count">{{ labware_mapping_rows|length }} {{ "mapping" if labware_mapping_rows|length == 1 else "mappings" }}</span>
    </div>
    <div class="panel-body">
      {% if labware_mapping_rows %}
        <table>
          <thead>
            <tr>
              <th>user wording</th>
              <th>config label</th>
            </tr>
          </thead>
          <tbody>
            {% for row in labware_mapping_rows %}
              <tr data-target-cells="{{ row.target_prov_ids|e }}">
                <td class="col-description">"{{ row.description|e }}"</td>
                <td class="col-label">{{ row.resolved_label|e if row.resolved_label else "(unresolved)" }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="empty">(no labware references)</div>
      {% endif %}
    </div>
  </div>
</section>

<div class="grid {% if live_mode %}cols-1{% else %}cols-5{% endif %}">

  <!-- ───────── Column 1: Instruction ───────── -->
  <div class="col">
    <h2>Instruction</h2>
    <div class="instruction-text">{{ instruction_html|safe }}</div>
  </div>

  <!-- ───────── Column 2: Extracted Spec ─────────
       Step blocks no longer print "triggered by:" — the arrow communicates
       the same thing. Hover the block for justification + reasoning. -->
  <div class="col col-extracted-spec{% if live_mode %} is-pending{% endif %}">
    <h2>Extracted Spec</h2>
    {% if spec_steps %}
      {% for step in spec_steps %}
        <div class="step {{ step.step_class }}"
             data-prov-id="{{ step.step_trigger_prov_id }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(extraction did not produce a spec)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 3: Resolved Spec (post-orchestrator) ─────────
       The spec AFTER the orchestrator's gap-resolution loop converges.
       Every Gap that was resolvable is filled; every Provenance carries
       the review_status from ADR-0009. Distinct from column 4 (Validated
       Spec) — column 3 is the orchestrator's output; column 4 is the
       same spec after stage-3.5's labware confirmation panel + stage-4's
       constraint check pass. ADR-0011 Phase 2a introduces the split. -->
  <div class="col col-resolved-spec{% if live_mode %} is-pending{% endif %}">
    <h2>Resolved Spec</h2>
    {% if resolved_steps %}
      {% for step in resolved_steps %}
        <div class="step {{ step.step_class }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(orchestrator stage not reached)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 4: Validated Spec (post-CompleteProtocolSpec) ─────────
       The spec after the stage-3.5 labware-confirm panel (legacy
       _confirm_labware_assignments still serves this until ADR-0011
       Phase 5) AND the stage-4 ConstraintChecker.check_all pass. This
       is the spec that becomes CompleteProtocolSpec at the type-system
       level. Visually similar to column 3 today; Phase 2b's arrows will
       show what changed (labware re-mappings + any constraint clips). -->
  <div id="validated-col" class="col col-validated-spec{% if live_mode %} is-pending{% endif %}">
    <h2>Validated Spec</h2>
    {# P1-8 toggle bar — clicking the button hides every `.inline-check`
       in this column via the `.checks-hidden` class. JS at the bottom
       of the template wires the click + persists state to localStorage. #}
    <div class="checks-toggle-bar">
      <button id="checks-toggle" type="button" class="checks-toggle-btn">Hide inline checks</button>
      <span>each verified value carries a green ✓ tag — click to hide</span>
    </div>
    {# P1-7: column-local legend so the user can decode the constraint-
       summary line below without having to infer from color alone. Inline
       glyph hues track the summary-state colors (var(--col-instruction)
       for violations, var(--warning-accent) for warnings) so the user
       binds definition to visual cue. Always rendered regardless of
       summary state. #}
    <div class="validated-summary-legend" style="font-size: 12px; color: var(--dim); margin: 2px 0 8px; line-height: 1.5;">
      <strong style="color: var(--col-instruction);">✗ violation</strong> = rule the protocol must satisfy — pipeline halts here ·
      <strong style="color: var(--warning-accent);">⚠ warning</strong> = concern flagged for your review; pipeline continues.
    </div>
    <!-- Phase 3i (#72): constraint-check summary. Static path renders
         from constraint_summary; live path's JS replaces #validated-summary's
         content on constraint_check_done. Hidden until populated. -->
    <div id="validated-summary" class="validated-summary{% if not constraint_summary %} is-empty{% endif %}">
      {% if constraint_summary %}
        {% set vc = constraint_summary.violation_count %}
        {% set wc = constraint_summary.warnings|length %}
        <div class="validated-summary-line {% if vc > 0 %}has-errors{% elif wc > 0 %}has-warnings{% else %}all-clear{% endif %}">
          {% if vc > 0 %}
            <strong style="color: var(--col-instruction);">✗ {{ vc }} violation{{ '' if vc == 1 else 's' }}</strong> — protocol does not validate
          {% elif wc > 0 %}
            <strong style="color: var(--warning-accent);">✓ 0 violations, {{ wc }} warning{{ '' if wc == 1 else 's' }}</strong> — protocol validated
          {% else %}
            <strong style="color: var(--check-pill-glyph);">✓ 0 violations</strong> — protocol validated
          {% endif %}
        </div>
        {# P1-9: top list shows only protocol-level (Step 0) or unparseable
           warnings. Step-specific warnings are surfaced inline at their
           step row below via `step.warnings`. Falls back to the flat
           `warnings` list when the splitter wasn't run (older state log
           consumer). #}
        {% set _global_warns = constraint_summary.warnings_global if constraint_summary.warnings_global is defined else constraint_summary.warnings %}
        {% if _global_warns %}
          <ul class="validated-summary-warnings">
            {% for w in _global_warns %}
              <li>{{ w|e }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    </div>
    {% if validated_steps %}
      {% for step in validated_steps %}
        <div class="step {{ step.step_class }}"
             data-step-cited="{{ step.step_cited_text|e }}"
             data-step-palette="{{ step.step_palette_class }}"
             data-script-step="s{{ loop.index0 }}"
             data-step-order="{{ step.order }}"
             {% if step.step_reasoning %}data-step-reasoning="{{ step.step_reasoning|e }}"{% endif %}
             data-params-reasoning="{{ step.parameters_reasoning|e }}"
             data-confidence="{{ step.confidence }}">
          <div class="step-action">Step {{ step.order }}: {{ step.action }}</div>
          {% for line in step.detail_lines %}
            <div class="step-detail">{{ line|safe }}</div>
          {% endfor %}
          {% if step.note_line %}{{ step.note_line|safe }}{% endif %}
          {# P1-9: per-step constraint warnings surface here so the user
             sees them in the same visual context as the step they refer
             to. Tan accent matches the WARNING color used in the
             validated-summary legend (Task #8). Live-mode JS injects
             into the same `.step-warning` shape on `constraint_check_done`. #}
          {% if step.warnings %}
            <div class="step-warning">
              {% for w in step.warnings %}
                <div class="step-warning-line">{{ w|e }}</div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--dim)">(validation stage not reached)</p>
    {% endif %}
  </div>

  <!-- ───────── Column 5: Generated Code ───────── -->
  <div class="col col-generated-code{% if live_mode %} is-pending{% endif %}">
    <h2>Generated Python</h2>
    {% if generated_script_html %}
      <pre class="code">{{ generated_script_html|safe }}</pre>
    {% elif generated_script %}
      <pre class="code">{{ generated_script|e }}</pre>
    {% else %}
      <p style="color: var(--dim)">(script-generation stage not reached)</p>
    {% endif %}
  </div>

</div>

<footer>
  <span>nl2protocol · provenance-traced protocol generation</span>
  <span>Hover any colored value or step block for the original cite + reasoning.</span>
</footer>

<!-- JS hover tooltip — replaces native title= for richer formatting and fade. -->
<div id="hover-tip" role="tooltip"></div>

<!-- SVG overlay for arrows from instruction-cite spans to spec-step blocks.
     The clipPath is rebuilt on every render to match the spec column's
     visible rect — arrows that would extend above/below the column box
     are clipped, preserving their bezier shape but hiding the overflow. -->
<svg id="arrow-overlay" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="arrow-clip"><rect id="arrow-clip-rect" x="0" y="0" width="0" height="0"/></clipPath>
    <!-- Phase 3 fix (P1-10): resolution-arrow clip. Both source + destination
         columns are always in view horizontally, but a bezier curve with
         high vertical sweep (e.g., extracted Step 3 → resolved Step 7) used
         to escape the column box vertically and float over unrelated UI.
         Rect is sized to the resolved column's bounding box on each
         render — see updateResolutionArrowClip() below. -->
    <clipPath id="resolution-arrow-clip"><rect id="resolution-arrow-clip-rect" x="0" y="0" width="0" height="0"/></clipPath>
  </defs>
  <!-- Composite-step arrows (instruction → extracted spec). Clipped to the
       extracted-spec column so off-screen segments don't visually escape. -->
  <g clip-path="url(#arrow-clip)" id="arrow-paths"></g>
  <!-- Resolution arrows (extracted → resolved spec, ADR-0011 Phase 2b).
       Clipped vertically to the resolved-spec column (P1-10 fix); the
       arrow's bezier shape is preserved, only the off-column overflow
       is hidden so when the user scrolls source + destination back into
       view the arrow re-emerges intact. -->
  <g clip-path="url(#resolution-arrow-clip)" id="resolution-arrow-paths"></g>
</svg>

<!-- ADR-0011 Phase 2b: resolution-arrow data embedded as JSON.
     One entry per drawable gap_resolved event. The JS at the end of
     this document parses this on init + on every layout-affecting
     event, then draws an SVG path per entry. -->
<script id="resolution-arrows-data" type="application/json">{{ resolution_arrows_json|default('[]')|safe }}</script>

<script>
(function () {
  // Visual wiring for the report:
  //   1. Composite-step arrows — one SVG bezier per (step, anchor) pair.
  //      A single instruction cite-span can carry MULTIPLE step-trigger
  //      ids (space-separated in data-cite-id) when two step cites
  //      overlap; in that case we draw N arrows fanning out from the
  //      same anchor, producing the "<"-shaped attribution.
  //   2. Hover emphasis — hovering a cite OR a prov target outlines the
  //      pair across all DOM segments sharing the id, and brightens the
  //      matching arrow(s).
  //   3. Q2 cohesion hover — hovering a step block tints every
  //      .cite-q2-cohesion span tagged with that step's id; lit-up
  //      state is the only time Q2 cites become visible.
  //   4. Hover tooltip — replaces native title=. Reads provenance from
  //      data-prov-* attrs on value spans and data-step-* / data-params-*
  //      on step blocks; positions near the cursor with a fade.

  const overlay = document.getElementById("arrow-overlay");
  const tip = document.getElementById("hover-tip");
  // Per ADR-0011 animation-timing addendum (2026-05-06): path maps for
  // the two arrow renderers. Each maps id → SVGPathElement. Path elements
  // SURVIVE across renders — their continued presence in the DOM is the
  // "this id has already traced" signal, replacing the previous
  // seenArrowIds Set. Re-renders mutate `d` to track scrolled cells; the
  // trace state (stroke-dasharray + stroke-dashoffset transition) survives.
  const arrowPathMap = new Map();           // composite-step ids
  const resolutionArrowPathMap = new Map(); // resolution prov_ids
  if (!overlay) return;

  // Token-match selector: a span's data-cite-id may carry multiple
  // ids ("s0-step-trigger s1-step-trigger") so use the ~= attribute
  // selector for whitespace-separated tokens.
  const sel = (attr, token) => `[${attr}~="${CSS.escape(token)}"]`;

  function bezierPath(srcRect, dstRect) {
    // Right edge of source → left edge of destination, smooth horizontal sweep.
    const x1 = srcRect.right;
    const y1 = srcRect.top + srcRect.height / 2;
    const x2 = dstRect.left;
    const y2 = dstRect.top + dstRect.height / 2;
    const dx = Math.max(40, (x2 - x1) * 0.5);
    return `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
  }

  // Auto-scroll helper. Given a step index and one or two columns,
  // ensure the step's `.step` block is fully visible in EACH column.
  // For a single column (red-arrow case) this just scrolls that column.
  // For two columns (green-arrow case) we compute the required scrollTop
  // per column and apply the MAX of the two to BOTH — so step i lands
  // fully visible in extracted AND resolved, and the columns stay in
  // lockstep (source / destination endpoints aligned vertically).
  // Already-visible steps produce a no-op; smooth scroll handles the rest.
  function scrollColumnsForStep(stepIdx, columns) {
    const margin = 16;
    const targets = columns.map((col) => {
      if (!col) return null;
      const stepEl = col.querySelectorAll(".step")[stepIdx];
      if (!stepEl) return null;
      const colH = col.clientHeight;
      const stepTop = stepEl.offsetTop;
      const stepBottom = stepTop + stepEl.offsetHeight;
      const curScroll = col.scrollTop;
      if (stepTop < curScroll + margin) {
        return Math.max(0, stepTop - margin);
      }
      if (stepBottom > curScroll + colH - margin) {
        return stepBottom - colH + margin;
      }
      return curScroll;  // already in view
    });
    const valid = targets.filter((t) => t != null);
    if (valid.length === 0) return;
    // Lockstep: pick the larger target so the step is fully visible in
    // every column even when block heights differ slightly between
    // extracted and resolved (resolved cells often carry an extra
    // `[label]` suffix).
    const targetScroll = Math.max(...valid);
    columns.forEach((col, idx) => {
      if (!col || targets[idx] == null) return;
      if (Math.abs(col.scrollTop - targetScroll) < 4) return;  // already there
      try {
        col.scrollTo({ top: targetScroll, behavior: "smooth" });
      } catch (e) {
        col.scrollTop = targetScroll;  // older browsers
      }
    });
  }

  // Per ADR-0011 animation-timing addendum (strict-serial revision):
  // each per-step slot is TRACE + FADE = 1375ms. Arrow takes the first
  // 770ms of the slot; block takes the next 605ms. The next slot begins
  // exactly when the previous block finishes fading. Both renderers
  // (col 1→2 and col 2→3) use this same slot duration.
  const ARROW_TRACE_MS = 770;
  const COLUMN_FADE_MS = 605;        // matches CSS .step.fade-in transition (0.605s)
  const ARROW_STAGGER_MS = ARROW_TRACE_MS + COLUMN_FADE_MS;   // 1375 — slot duration

  function renderArrows() {
    const arrowGroup = document.getElementById("arrow-paths");
    if (!arrowGroup) return;
    // Update the clip-path rect to match the spec column's visible bounds.
    // Arrows that would extend above/below the column get clipped without
    // changing their bezier shape.
    const specCol = document.querySelector(".col-extracted-spec");
    const clipRect = document.getElementById("arrow-clip-rect");
    if (specCol && clipRect) {
      const r = specCol.getBoundingClientRect();
      // Extend left toward the instruction column so the arrow's starting
      // bezier sweep remains visible — only the destination side needs clipping.
      const leftExtend = window.innerWidth;
      clipRect.setAttribute("x", String(r.left - leftExtend));
      clipRect.setAttribute("y", String(r.top));
      clipRect.setAttribute("width", String(r.right - r.left + leftExtend));
      clipRect.setAttribute("height", String(r.bottom - r.top));
    }
    // Dedupe by step-trigger id: one arrow per (cite-anchor, step) pair.
    // When the same step-trigger id appears across multiple DOM segments
    // (because of overlap segmentation), pick the leftmost segment as anchor.
    const anchorByStepId = new Map();
    document.querySelectorAll(".cite-composite-step[data-cite-id]").forEach((citeEl) => {
      const ids = (citeEl.getAttribute("data-cite-id") || "").split(/\s+/).filter(Boolean);
      const r = citeEl.getBoundingClientRect();
      if (!r.width) return;
      ids.forEach((id) => {
        if (!id.endsWith("-step-trigger")) return;
        const prev = anchorByStepId.get(id);
        if (!prev || r.left < prev.rect.left) {
          anchorByStepId.set(id, { rect: r });
        }
      });
    });
    // Track which mapped ids we resolved this render so we can prune
    // entries whose ids no longer exist (rare — only on re-runs that
    // shrink the spec).
    const resolvedThisRender = new Set();
    anchorByStepId.forEach(({ rect: srcRect }, id) => {
      const target = document.querySelector(`.step${sel("data-prov-id", id)}`);
      if (!target) return;
      const dstRect = target.getBoundingClientRect();
      if (!dstRect.width) return;
      const d = bezierPath(srcRect, dstRect);
      let path = arrowPathMap.get(id);
      if (path && path.parentNode === arrowGroup) {
        // Existing path — mutate `d` to follow scrolled / repositioned
        // cells. Trace state (dasharray, dashoffset transition) survives.
        path.setAttribute("d", d);
      } else {
        // First-sight: create + run the trace. Stagger by step index
        // (ID format "s{idx}-step-trigger") so arrows trace one-by-one
        // in step order at the river-flow cadence.
        path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", d);
        path.dataset.citeId = id;
        arrowGroup.appendChild(path);
        arrowPathMap.set(id, path);
        try {
          const len = path.getTotalLength();
          if (len > 0) {
            path.style.strokeDasharray = String(len);
            path.style.strokeDashoffset = String(len);
            const m = id.match(/^s(\d+)/);
            const stepIdx = m ? parseInt(m[1], 10) : 0;
            const delay = stepIdx * ARROW_STAGGER_MS;
            setTimeout(() => {
              // Bring the destination step block into view in the
              // extracted column before/while the arrow traces. Smooth
              // scroll glides in parallel with the 770ms trace; the
              // scheduleRender attached to column-scroll keeps the arrow
              // path tracking the cell as it moves.
              scrollColumnsForStep(
                stepIdx,
                [document.querySelector(".col-extracted-spec")],
              );
              path.style.transition = `stroke-dashoffset ${ARROW_TRACE_MS}ms ease-out`;
              path.style.strokeDashoffset = "0";
            }, delay);
          }
        } catch (e) { /* defensive — getTotalLength may not be available */ }
      }
      resolvedThisRender.add(id);
    });
    // Prune mapped paths whose ids no longer exist (re-run shrinks).
    arrowPathMap.forEach((path, id) => {
      if (!resolvedThisRender.has(id)) {
        if (path.parentNode === arrowGroup) arrowGroup.removeChild(path);
        arrowPathMap.delete(id);
      }
    });
  }

  function setPairActive(id, active) {
    // Toggle highlight on every cite-segment, prov-target, and arrow sharing one id.
    document.querySelectorAll(sel("data-cite-id", id)).forEach((e) =>
      e.classList.toggle("cite-active", active)
    );
    document.querySelectorAll(sel("data-prov-id", id)).forEach((e) => {
      if (e.classList.contains("step")) {
        e.classList.toggle("step-active", active);
      } else {
        e.classList.toggle("prov-active", active);
      }
    });
    overlay.querySelectorAll(`path[data-cite-id="${CSS.escape(id)}"]`).forEach((p) =>
      p.classList.toggle("arrow-active", active)
    );
  }

  function setQ2Active(stepId, active) {
    document.querySelectorAll(sel("data-q2-step-id", stepId)).forEach((e) =>
      e.classList.toggle("q2-active", active)
    );
  }

  // ────────── Hover tooltip ──────────
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c]));
  }

  function showTip(html, evt) {
    if (!tip) return;
    tip.innerHTML = html;
    tip.classList.add("visible");
    moveTip(evt);
  }
  function hideTip() {
    if (!tip) return;
    tip.classList.remove("visible");
  }
  function moveTip(evt) {
    if (!tip || !tip.classList.contains("visible")) return;
    const pad = 14;
    const w = tip.offsetWidth;
    const h = tip.offsetHeight;
    let x = evt.clientX + pad;
    let y = evt.clientY + pad;
    if (x + w > window.innerWidth - 8) x = evt.clientX - pad - w;
    if (y + h > window.innerHeight - 8) y = evt.clientY - pad - h;
    tip.style.left = `${Math.max(8, x)}px`;
    tip.style.top = `${Math.max(8, y)}px`;
  }

  function tooltipHtmlForValueSpan(el) {
    // Atomic value tooltip:
    //   header line:  "SOURCE: <kind> · CONFIDENCE: <pct> · REVIEW: <state-glyph>"
    //   for instruction-sourced values: cited substring as a quoted line.
    //   for non-instruction values: TWO labeled rows:
    //     [WHY THIS VALUE]      positive_reasoning
    //     [WHY NOT IN INSTR]    why_not_in_instruction
    //   when review_status == 'reviewed_disagree': boxed reviewer objection.
    const source = el.getAttribute("data-prov-source") || "unknown";
    const conf = el.getAttribute("data-prov-confidence") || "";
    const cited = el.getAttribute("data-prov-cited");
    const positiveReasoning = el.getAttribute("data-prov-positive-reasoning")
                              || el.getAttribute("data-prov-reasoning");
    const whyNotInInstruction = el.getAttribute("data-prov-why-not-in-instruction");
    const reviewStatus = el.getAttribute("data-prov-review-status") || "original";
    const reviewerObjection = el.getAttribute("data-prov-reviewer-objection");
    const confPct = conf ? `${Math.round(parseFloat(conf) * 100)}%` : "";

    // Compact glyph + label per review state. 'original' is the default
    // state and gets no extra meta — the source/confidence pair is enough.
    const reviewGlyph = ({
      reviewed_agree:           "✓ reviewer agreed",
      reviewed_disagree:        "✗ reviewer disagreed",
      user_confirmed:           "✓ confirmed",
      user_edited:              "✎ edited by user",
      user_accepted_suggestion: "→ accepted suggestion",
      user_skipped:             "↷ skipped",
    })[reviewStatus] || "";

    let parts = [
      `<div class="tip-meta">source: ${escapeHtml(source)}${confPct ? ` · confidence: ${confPct}` : ""}${reviewGlyph ? ` · ${escapeHtml(reviewGlyph)}` : ""}</div>`,
    ];
    if (cited) {
      parts.push(`<div class="tip-cite">"${escapeHtml(cited)}"</div>`);
    }
    if (positiveReasoning) {
      parts.push(`<div class="tip-section"><div class="tip-meta">why this value</div><div class="tip-reasoning">${escapeHtml(positiveReasoning)}</div></div>`);
    }
    if (whyNotInInstruction) {
      parts.push(`<div class="tip-section"><div class="tip-meta">why not in instruction</div><div class="tip-reasoning">${escapeHtml(whyNotInInstruction)}</div></div>`);
    }
    if (reviewerObjection) {
      parts.push(`<div class="tip-section"><div class="tip-meta">reviewer objection</div><blockquote class="tip-objection">${escapeHtml(reviewerObjection)}</blockquote></div>`);
    }
    return parts.join("");
  }

  function tooltipHtmlForStepBlock(el) {
    // Step block tooltip:
    //   header: "WHY THIS STEP, WITH THESE PARAMS? · <confidence>"
    //   reasoning paragraph (parameters_reasoning)
    //   indented blockquote of step_cited_text with palette-colored left bar
    //   optional "DOMAIN EXPANSION" section when step_reasoning is present
    const cited = el.getAttribute("data-step-cited") || "";
    const paletteCls = el.getAttribute("data-step-palette") || "";
    const stepReasoning = el.getAttribute("data-step-reasoning");
    const paramsReasoning = el.getAttribute("data-params-reasoning");
    const conf = el.getAttribute("data-confidence") || "";
    let parts = [`<div class="tip-meta">why this step, with these params?${conf ? ` · ${escapeHtml(conf)}` : ""}</div>`];
    if (paramsReasoning) {
      parts.push(`<div class="tip-reasoning">${escapeHtml(paramsReasoning)}</div>`);
    }
    if (cited) {
      parts.push(`<blockquote class="tip-quote ${escapeHtml(paletteCls)}">${escapeHtml(cited)}</blockquote>`);
    }
    if (stepReasoning) {
      parts.push(`<div class="tip-section"><div class="tip-meta">domain expansion</div><div class="tip-reasoning">${escapeHtml(stepReasoning)}</div></div>`);
    }
    return parts.join("");
  }

  function wireHover() {
    // Cite ↔ prov pair highlight + cite-segment tooltip (if cite carries
    // any prov metadata via the value side, which it doesn't directly —
    // tooltip wiring lives on prov-id targets and step blocks below).
    document.querySelectorAll("[data-cite-id]").forEach((el) => {
      const ids = (el.getAttribute("data-cite-id") || "").split(/\s+/).filter(Boolean);
      el.addEventListener("mouseenter", () => ids.forEach((id) => setPairActive(id, true)));
      el.addEventListener("mouseleave", () => ids.forEach((id) => setPairActive(id, false)));
    });

    // Atomic value spans (carry data-prov-source) — pair highlight + tooltip.
    document.querySelectorAll("[data-prov-source]").forEach((el) => {
      const id = el.getAttribute("data-prov-id");
      el.addEventListener("mouseenter", (e) => {
        if (id) setPairActive(id, true);
        showTip(tooltipHtmlForValueSpan(el), e);
      });
      el.addEventListener("mousemove", moveTip);
      el.addEventListener("mouseleave", () => {
        if (id) setPairActive(id, false);
        hideTip();
      });
    });

    // Step blocks — Q2 cohesion lighting + step-trigger pair highlight + tooltip.
    document.querySelectorAll(".step[data-prov-id]").forEach((stepEl) => {
      const provId = stepEl.getAttribute("data-prov-id");
      const stepId = provId.replace(/-step-trigger$/, "");
      stepEl.addEventListener("mouseenter", (e) => {
        setPairActive(provId, true);
        setQ2Active(stepId, true);
        showTip(tooltipHtmlForStepBlock(stepEl), e);
      });
      stepEl.addEventListener("mousemove", moveTip);
      stepEl.addEventListener("mouseleave", () => {
        setPairActive(provId, false);
        setQ2Active(stepId, false);
        hideTip();
      });
    });

    // Complete-spec column step blocks (no data-prov-id but still hover tooltip).
    document.querySelectorAll(".step:not([data-prov-id])[data-step-cited]").forEach((stepEl) => {
      stepEl.addEventListener("mouseenter", (e) => showTip(tooltipHtmlForStepBlock(stepEl), e));
      stepEl.addEventListener("mousemove", moveTip);
      stepEl.addEventListener("mouseleave", hideTip);
    });

    // Reverse Q2 wiring: hovering a Q2 cite-span surfaces its step.
    document.querySelectorAll(".cite-q2-cohesion[data-q2-step-id]").forEach((citeEl) => {
      const stepIds = (citeEl.getAttribute("data-q2-step-id") || "").split(/\s+/).filter(Boolean);
      citeEl.addEventListener("mouseenter", () => stepIds.forEach((sid) => {
        setQ2Active(sid, true);
        setPairActive(`${sid}-step-trigger`, true);
      }));
      citeEl.addEventListener("mouseleave", () => stepIds.forEach((sid) => {
        setQ2Active(sid, false);
        setPairActive(`${sid}-step-trigger`, false);
      }));
    });

    // Phase 4 polish: bulk-panel row hover lights up corresponding spec cells.
    // Each row carries `data-target-cells` (space-separated prov-ids); on
    // hover we toggle .prov-active across all cells with matching ids in
    // the spec columns. Reuses the existing setPairActive helper that
    // already drives the cite ↔ value pair highlight.
    document.querySelectorAll(".panel tbody tr[data-target-cells]").forEach((rowEl) => {
      const ids = (rowEl.getAttribute("data-target-cells") || "").split(/\s+/).filter(Boolean);
      if (ids.length === 0) return;
      rowEl.addEventListener("mouseenter", () => ids.forEach((id) => setPairActive(id, true)));
      rowEl.addEventListener("mouseleave", () => ids.forEach((id) => setPairActive(id, false)));
    });
  }

  // ────────── ADR-0011 Phase 2b: resolution arrows ──────────
  // Read the embedded JSON, draw one bezier path per drawable
  // gap_resolved event from extracted-spec column to resolved-spec
  // column. Color encodes resolution_kind via CSS class.
  function readResolutionArrowData() {
    const el = document.getElementById("resolution-arrows-data");
    if (!el) return [];
    try {
      const data = JSON.parse(el.textContent || "[]");
      return Array.isArray(data) ? data : [];
    } catch (e) {
      return [];
    }
  }

  // Per ADR-0011 animation-timing addendum (strict-serial revision):
  // resolution arrows DO NOT auto-trace at path-creation time. Paths are
  // created with an invisible initial state (full strokeDashoffset). The
  // `runResolutionColumnAnimation` function — invoked from the live-mode
  // col 2→3 gate or from init() in static mode — triggers traces grouped
  // by step_order so each step's arrows fire at slot start (i × STAGGER)
  // and the corresponding step block fades in at slot start + TRACE_MS.
  // The previous queue + pump pattern was independent of step ordering,
  // which the user observed as wrong: blocks could appear before their
  // arrows, and arrows for step i+1 could trace before step i's block
  // appeared.

  function triggerResolutionTrace(path, delayMs) {
    if (!path) return;
    if (path.dataset.traced === "1") return;
    path.dataset.traced = "1";
    try {
      const len = path.getTotalLength();
      if (!(len > 0)) return;
      path.style.strokeDasharray = String(len);
      path.style.strokeDashoffset = String(len);
      setTimeout(() => {
        path.style.transition = `stroke-dashoffset ${ARROW_TRACE_MS}ms ease-out`;
        path.style.strokeDashoffset = "0";
      }, delayMs);
    } catch (e) { /* defensive */ }
  }

  function runResolutionColumnAnimation() {
    // Group resolution paths by step_order (1-based); paths missing a
    // step_order land in slot 0. For each step's slot at i × STAGGER,
    // trigger all of that step's arrows in parallel — they share the
    // arrow-trace window and the corresponding step block fades in
    // (via appendStepBlocks's per-step setTimeout) at slot start +
    // TRACE_MS, right when arrows finish.
    const byStep = new Map();
    resolutionArrowPathMap.forEach((path) => {
      const so = parseInt(path.dataset.stepOrder || "0", 10);
      const stepIdx = Math.max(0, so - 1);
      if (!byStep.has(stepIdx)) byStep.set(stepIdx, []);
      byStep.get(stepIdx).push(path);
    });
    const extractedCol = document.querySelector(".col-extracted-spec");
    const resolvedCol  = document.querySelector(".col-resolved-spec");
    byStep.forEach((paths, stepIdx) => {
      const slotStart = stepIdx * ARROW_STAGGER_MS;
      // Scroll both columns in lockstep so step i's source row and
      // destination row are both visible when this step's arrows trace.
      setTimeout(() => {
        scrollColumnsForStep(stepIdx, [extractedCol, resolvedCol]);
      }, slotStart);
      paths.forEach((path) => triggerResolutionTrace(path, slotStart));
    });
  }

  function renderResolutionArrows() {
    const group = document.getElementById("resolution-arrow-paths");
    if (!group) return;
    const arrows = readResolutionArrowData();
    const extractedCol = document.querySelector(".col-extracted-spec");
    const resolvedCol  = document.querySelector(".col-resolved-spec");
    if (!extractedCol || !resolvedCol) {
      // Columns not yet rendered — nothing to anchor against.
      return;
    }
    // P1-10 fix: keep the clip rect in sync with the resolved column's
    // vertical bounds. Horizontal extent stays generous (full window
    // width) so the bezier curve's sweep remains visible even when its
    // mid-point is far from the column edges; only vertical overflow
    // gets hidden. Mirrors the composite-arrow clip-update pattern in
    // renderArrows() above.
    const clipRect = document.getElementById("resolution-arrow-clip-rect");
    if (clipRect) {
      const rRes = resolvedCol.getBoundingClientRect();
      const rExt = extractedCol.getBoundingClientRect();
      const yTop = Math.min(rRes.top, rExt.top);
      const yBot = Math.max(rRes.bottom, rExt.bottom);
      clipRect.setAttribute("x", "0");
      clipRect.setAttribute("y", String(yTop));
      clipRect.setAttribute("width", String(window.innerWidth));
      clipRect.setAttribute("height", String(yBot - yTop));
    }
    const seenThisRender = new Set();
    arrows.forEach((arrow) => {
      const pid = arrow.prov_id;
      if (!pid) return;
      // Source: extracted-spec column cell. Destination: resolved-spec
      // column cell. Same data-prov-id appears in both columns; per-column
      // scoping disambiguates.
      const srcVal = extractedCol.querySelector(sel("data-prov-id", pid));
      const dstVal = resolvedCol.querySelector(sel("data-prov-id", pid));
      if (!srcVal || !dstVal) return;
      // Anchor the arrow to the FIELD ROW (.step-detail div) rather than
      // the value span itself. The arrow then enters/leaves the row from
      // its left/right edge and never overlaps the label or value text.
      // Falls back to the value span if no .step-detail ancestor exists.
      const src = srcVal.closest(".step-detail") || srcVal;
      const dst = dstVal.closest(".step-detail") || dstVal;
      const srcRect = src.getBoundingClientRect();
      const dstRect = dst.getBoundingClientRect();
      if (!srcRect.width || !dstRect.width) return;
      const d = bezierPath(srcRect, dstRect);
      let path = resolutionArrowPathMap.get(pid);
      if (path && path.parentNode === group) {
        // Existing — just refresh geometry. Trace state (dasharray /
        // dashoffset / transition) survives so a partial trace keeps
        // playing toward a moving target without restart.
        path.setAttribute("d", d);
      } else {
        // First-sight: create the path, set it invisible (full dashoffset).
        // Tag it with step_order so runResolutionColumnAnimation can group
        // paths by step and trigger them in step-ordered slots.
        path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", d);
        path.setAttribute("class", `resolution-arrow res-${arrow.resolution_kind}`);
        path.dataset.provId = pid;
        path.dataset.resolutionKind = arrow.resolution_kind;
        path.dataset.stepOrder = String(arrow.step_order || 0);
        group.appendChild(path);
        resolutionArrowPathMap.set(pid, path);
        try {
          const len = path.getTotalLength();
          if (len > 0) {
            path.style.strokeDasharray = String(len);
            path.style.strokeDashoffset = String(len);
          }
        } catch (e) { /* defensive */ }
      }
      seenThisRender.add(pid);
    });
    // Prune mapped paths whose ids no longer appear in the data.
    // (Rare in practice — server emits cumulative arrow set per
    // gap_resolved event; ids only get added.)
    resolutionArrowPathMap.forEach((path, pid) => {
      if (!seenThisRender.has(pid)) {
        if (path.parentNode === group) group.removeChild(path);
        resolutionArrowPathMap.delete(pid);
      }
    });
    // No automatic trace trigger here. runResolutionColumnAnimation is
    // the only thing that starts traces, and it's invoked from the col
    // 2→3 gate (live mode) or init() (static mode).
  }

  function scheduleRender() {
    requestAnimationFrame(() => {
      renderArrows();
      renderResolutionArrows();
    });
  }

  function wireScriptLinkage() {
    // Phase 3i (#72): hover-pair between Validated Spec blocks and
    // <pre.code> lines tagged with a matching data-script-step. Both
    // directions: hovering a step block lights up its emitted lines;
    // hovering a code line lights up its source step. Idempotent — a
    // data-linkage-bound flag prevents double-binding when the script
    // DOM is re-rendered (live mode).
    function setLinkageActive(stepId, active) {
      if (!stepId) return;
      document.querySelectorAll(
        '.col-validated-spec .step[data-script-step="' + stepId + '"]'
      ).forEach((el) => el.classList.toggle("is-script-linked", active));
      document.querySelectorAll(
        '.code-line[data-script-step="' + stepId + '"]'
      ).forEach((el) => el.classList.toggle("is-script-linked", active));
    }
    document.querySelectorAll(
      '.col-validated-spec .step[data-script-step]'
    ).forEach((el) => {
      if (el.dataset.linkageBound === "1") return;
      el.dataset.linkageBound = "1";
      const stepId = el.dataset.scriptStep;
      el.addEventListener("mouseenter", () => setLinkageActive(stepId, true));
      el.addEventListener("mouseleave", () => setLinkageActive(stepId, false));
    });
    document.querySelectorAll('pre.code .code-line[data-script-step]').forEach((el) => {
      if (el.dataset.linkageBound === "1") return;
      el.dataset.linkageBound = "1";
      const stepId = el.dataset.scriptStep;
      el.addEventListener("mouseenter", () => setLinkageActive(stepId, true));
      el.addEventListener("mouseleave", () => setLinkageActive(stepId, false));
    });
  }

  function wirePanelToggles() {
    // Bar-box collapse toggle. Click anywhere on .panel-header flips
    // .is-collapsed on the parent .panel. Idempotent — safe to call
    // multiple times (we use addEventListener with a flag attribute to
    // avoid double-binding on re-wires).
    document.querySelectorAll(".panel-header[data-panel-toggle]").forEach((header) => {
      if (header.dataset.toggleBound === "1") return;
      header.dataset.toggleBound = "1";
      header.addEventListener("click", () => {
        const panel = header.parentElement;
        if (panel) panel.classList.toggle("is-collapsed");
        // Arrow paths anchor to cells inside the columns; the panels
        // are in their own section but layout shifts when collapsing
        // can change column box positions. Reschedule a render so
        // arrows track. Schedule once at click time AND once after the
        // 200ms max-height transition completes so the final geometry
        // is also captured.
        try { scheduleRender(); } catch (e) { /* defensive */ }
        setTimeout(() => {
          try { scheduleRender(); } catch (e) { /* defensive */ }
        }, 240);
      });
    });
  }

  function init() {
    renderArrows();
    renderResolutionArrows();
    // Trigger the resolution arrows' traces grouped by step_order. In
    // static mode this is the only call site; in live mode it's
    // re-triggered from the col 2→3 gate after resolved_spec arrives.
    runResolutionColumnAnimation();
    wireHover();
    wirePanelToggles();
    wireScriptLinkage();
    wireChecksToggle();
    // Re-render on every layout-affecting event so arrows track their anchors.
    window.addEventListener("resize", scheduleRender);
    window.addEventListener("scroll", scheduleRender, { passive: true });
    document.querySelectorAll(".col").forEach((c) =>
      c.addEventListener("scroll", scheduleRender, { passive: true })
    );
  }

  // P1-8: column-level toggle that shows/hides all .inline-check tags
  // in the validated-spec column. Persisted to localStorage so a
  // returning visitor lands on their prior preference automatically.
  // The button + state class live on the column itself, so the
  // injector (`updateValidatedSummary` in live mode) just appends
  // .inline-check spans — the column's class decides visibility.
  function wireChecksToggle() {
    const btn = document.getElementById("checks-toggle");
    const col = document.getElementById("validated-col");
    if (!btn || !col) return;
    const STORAGE_KEY = "nl2protocol.checksHidden";
    let hidden = false;
    try { hidden = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) {}
    if (hidden) col.classList.add("checks-hidden");
    btn.textContent = hidden ? "Show inline checks" : "Hide inline checks";
    btn.addEventListener("click", function () {
      const nowHidden = col.classList.toggle("checks-hidden");
      btn.textContent = nowHidden ? "Show inline checks" : "Hide inline checks";
      try {
        localStorage.setItem(STORAGE_KEY, nowHidden ? "1" : "0");
      } catch (e) {}
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // ────────── ADR-0013 Phase 3b-1: live-mode WebSocket consumer ──────────
  // When the server renders this template with `live_mode=True`, this
  // block opens a WebSocket to /events and dispatches incoming events
  // to DOM-update handlers. Static HTMLReporter renders don't include
  // the live-controls div above, so this code's getElementById calls
  // simply find no button and the WebSocket never opens.
  function initLiveMode() {
    const startBtn = document.getElementById("live-start-btn");
    const status = document.getElementById("live-status");
    if (!startBtn || !status) return;   // not in live mode

    let activeWS = null;   // populated by connectWS so panel button clicks can reach it

    // Read a CSS custom property off :root. Used to keep JS color
    // literals in sync with the design-token palette in <style>:root.
    const cssVar = (name) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    // Status changes are sticky in the failure direction: once we've set
    // "error", `pipeline_done` (which fires unconditionally in the server's
    // finally block) must NOT downgrade the status back to a success-looking
    // "done". Without this, an uncaught exception sequence — error event
    // first, then pipeline_done sentinel — paints the indicator green and
    // makes a real crash look like a clean run.
    //
    // Signature: setStatus(text, tier) where tier ∈
    // {"success", "error", "warn", "neutral"}. The tier resolves to a
    // (--status-{tier}-bg, --status-{tier}-fg) pair on :root so every
    // pill color tracks the central palette tokens.
    let statusIsTerminalError = false;
    function setStatus(text, tier) {
      if (text === "error") {
        statusIsTerminalError = true;
      } else if (statusIsTerminalError && text === "done") {
        return;
      }
      status.textContent = text;
      status.style.background = cssVar(`--status-${tier}-bg`);
      status.style.color = cssVar(`--status-${tier}-fg`);
    }

    // ADR-0013 Phase 3c: gap-prompt modal helpers.
    // Mirrors CLIConfirmationHandler._render_gap + _action_prompt — same
    // information density, same action options, same severity labels.
    const panel = document.getElementById("live-panel");
    let activeReq = null;       // the currently-shown panel_request (drives keyboard)
    let activeKeyHandler = null;

    // Severity → (label, bg, fg). Keys must match GapSeverity literals
    // ("blocker"/"suggestion"/"quality"); CLI maps these same three.
    // Colors come from the central palette tokens via cssVar() so the
    // badges shift automatically when the palette swaps.
    const SEVERITY_TAG = {
      "blocker":    { label: "MUST RESOLVE", bg: cssVar("--status-error-bg"),   fg: cssVar("--status-error-fg") },
      "suggestion": { label: "needs review", bg: cssVar("--status-warn-bg"),    fg: cssVar("--status-warn-fg") },
      "quality":    { label: "optional",     bg: cssVar("--status-neutral-bg"), fg: cssVar("--status-neutral-fg") },
    };

    function showPanel(req) {
      if (!panel) return;
      activeReq = req;
      const gap = req.gap || {};
      const sug = req.suggestion;
      document.getElementById("live-panel-title").textContent =
        gap.kind ? "Gap: " + gap.kind : "Confirm gap";
      const sev = document.getElementById("live-panel-severity");
      const sevTag = SEVERITY_TAG[gap.severity]
                     || { label: gap.severity || "",
                          bg: cssVar("--status-neutral-bg"),
                          fg: cssVar("--status-neutral-fg") };
      sev.textContent = sevTag.label;
      sev.style.background = sevTag.bg;
      sev.style.color = sevTag.fg;
      document.getElementById("live-panel-description").textContent =
        gap.description || "";
      const cur = document.getElementById("live-panel-current");
      cur.textContent = gap.current_value
        ? "Current: " + gap.current_value : "";
      // Suggestion block: value + provenance_source + reasoning +
      // why_not_in_instruction + confidence (CLI _render_gap parity).
      const sugDiv = document.getElementById("live-panel-suggestion");
      const reasoningDiv = document.getElementById("live-panel-reasoning");
      if (sug) {
        sugDiv.innerHTML = '<strong>Suggested:</strong> '
          + escapeHtml(String(sug.value_repr || ""))
          + (sug.provenance_source
              ? ' <span style="color:var(--dim);font-size:11px">('
                + escapeHtml(sug.provenance_source) + ')</span>'
              : "");
        let r = "";
        if (sug.positive_reasoning) {
          r += '<div><strong>Reasoning:</strong> '
            + escapeHtml(sug.positive_reasoning) + '</div>';
        }
        if (sug.why_not_in_instruction) {
          r += '<div style="margin-top:4px"><strong>Why not from instruction:</strong> '
            + escapeHtml(sug.why_not_in_instruction) + '</div>';
        }
        if (typeof sug.confidence === "number") {
          r += '<div style="margin-top:4px"><strong>Confidence:</strong> '
            + Math.round(sug.confidence * 100) + '%</div>';
        }
        reasoningDiv.innerHTML = r;
        reasoningDiv.style.fontStyle = "normal";
      } else {
        sugDiv.innerHTML = '<em style="color:var(--dim)">(no suggestion available)</em>';
        reasoningDiv.innerHTML = "";
      }
      // Reviewer objection. Stamped onto gap.metadata by the orchestrator
      // after the reviewer pass; populated only when the reviewer
      // disagreed with the suggester. Mirrors the CLI handler line
      // "reviewer pushed back: <objection>".
      const objDiv = document.getElementById("live-panel-objection");
      const objection = gap.metadata && gap.metadata.reviewer_objection;
      if (objection) {
        objDiv.innerHTML = '<strong style="color:var(--col-instruction)">⚠ reviewer pushed back:</strong> '
          + escapeHtml(String(objection));
        objDiv.style.display = "block";
      } else {
        objDiv.style.display = "none";
      }
      // Phase 3b-3 (Group C): cross-column spotlight. Orchestrator stamps
      // gap.metadata.spotlight_prov_ids for gaps whose decision touches
      // anchored cells. Pulse those cells while the modal is open so the
      // user sees where in the spec their answer lands.
      const spotlight = gap.metadata && gap.metadata.spotlight_prov_ids;
      applySpotlight(spotlight);
      // Phase 3j (#73): anchor the panel near the first target cell
      // and draw dotted attach arrows to each. Run after panel is
      // visible (display:block above) so getBoundingClientRect is
      // accurate. Falls back to the default bottom-right position
      // (left untouched) when no targets are onscreen.
      // Defensive guard: if something hid the panel between the
      // synchronous show and this rAF callback (e.g. pipeline_done
      // arriving in the same tick and calling hidePanel), bail. Without
      // this, getBoundingClientRect on a display:none panel returns
      // (0,0,0,0), and drawAttachArrows draws orphan arrows from the
      // viewport's top-left corner out to each spotlight cell.
      requestAnimationFrame(() => {
        if (!panel || panel.style.display === "none") return;
        if (activeReq !== req) return;
        if (anchorPanelToTargets(spotlight)) {
          installAnchorListeners();
        }
      });
      // Build the per-gap button row. Mirrors CLI _action_prompt:
      //   - Accept only when a suggestion exists (default action — Enter).
      //   - Edit always shown.
      //   - Override only on kind="fabricated" (ADR-0012).
      //   - Skip only on severity="quality".
      //   - Quit always shown.
      // Keyboard shortcut letters in parens match CLI single-key tokens.
      const btnRow = document.getElementById("live-panel-buttons");
      btnRow.innerHTML = "";
      const buttons = [];
      if (sug) buttons.push({ label: "Accept (a)", action: "accept", primary: true, key: "a" });
      buttons.push({ label: "Edit (e)", action: "edit", key: "e" });
      if (gap.kind === "fabricated") buttons.push({ label: "Override (o)", action: "override", key: "o" });
      if (gap.severity === "quality") buttons.push({ label: "Skip (s)", action: "skip", key: "s" });
      buttons.push({ label: "Quit (q)", action: "abort", key: "q" });
      buttons.forEach((b) => {
        const el = document.createElement("button");
        el.textContent = b.label;
        el.style.cssText = b.primary
          ? "padding:6px 14px;border:1px solid var(--btn-primary);background:var(--btn-primary);color:var(--btn-primary-fg);border-radius:4px;cursor:pointer;font-size:13px;"
          : "padding:6px 14px;border:1px solid var(--btn-secondary-border);background:var(--panel);color:var(--ink);border-radius:4px;cursor:pointer;font-size:13px;";
        el.addEventListener("click", () => triggerAction(b.action));
        btnRow.appendChild(el);
      });
      panel.style.display = "block";
      installKeyboardHandler(buttons, !!sug);
    }
    function triggerAction(action) {
      if (!activeReq) return;
      if (action === "edit") {
        showEditInput(activeReq);
      } else {
        sendPanelResponse(activeReq.request_id, action);
      }
    }
    function installKeyboardHandler(buttons, hasSuggestion) {
      // Single-keystroke shortcuts. Enter = accept (CLI default action)
      // when a suggestion exists. Listener is rebound per-gap so the
      // available shortcuts always match the visible buttons.
      removeKeyboardHandler();
      const allowed = new Set(buttons.map((b) => b.key));
      activeKeyHandler = (ev) => {
        // Don't hijack typing inside the edit input.
        const tag = (ev.target && ev.target.tagName) || "";
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        const k = ev.key.toLowerCase();
        if (k === "enter" && hasSuggestion && allowed.has("a")) {
          ev.preventDefault();
          triggerAction("accept");
          return;
        }
        const match = buttons.find((b) => b.key === k);
        if (match) {
          ev.preventDefault();
          triggerAction(match.action);
        }
      };
      document.addEventListener("keydown", activeKeyHandler);
    }
    function removeKeyboardHandler() {
      if (activeKeyHandler) {
        document.removeEventListener("keydown", activeKeyHandler);
        activeKeyHandler = null;
      }
    }
    function showEditInput(req) {
      // Mirrors CLI sub-prompt: "  new value for <field_path>: ".
      // Shows the field_path so the user knows what they're editing.
      // Pre-fills the suggestion (or current value) for cheap small tweaks.
      // Detach the gap-level keyboard handler — the input owns keyboard
      // until the user submits or cancels.
      removeKeyboardHandler();
      const btnRow = document.getElementById("live-panel-buttons");
      btnRow.innerHTML = "";
      btnRow.style.flexDirection = "column";
      btnRow.style.alignItems = "stretch";
      const sug = req.suggestion;
      const gap = req.gap || {};
      const initial = (sug && sug.value_repr) || gap.current_value || "";
      const label = document.createElement("div");
      label.textContent = "new value for " + (gap.field_path || "<field>") + ":";
      label.style.cssText = "font-size:11px;color:var(--dim);margin-bottom:4px;";
      const inputRow = document.createElement("div");
      inputRow.style.cssText = "display:flex;gap:8px;flex-wrap:wrap;";
      const input = document.createElement("input");
      input.type = "text";
      input.value = String(initial);
      input.style.cssText = "flex:1;min-width:0;padding:6px 8px;border:1px solid var(--btn-secondary-border);border-radius:4px;font-size:13px;";
      const save = document.createElement("button");
      save.textContent = "Save";
      save.style.cssText = "padding:6px 14px;border:1px solid var(--btn-primary);background:var(--btn-primary);color:var(--btn-primary-fg);border-radius:4px;cursor:pointer;font-size:13px;";
      const cancel = document.createElement("button");
      cancel.textContent = "Cancel";
      cancel.style.cssText = "padding:6px 14px;border:1px solid var(--btn-secondary-border);background:var(--panel);color:var(--ink);border-radius:4px;cursor:pointer;font-size:13px;";
      function submit() {
        if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
        activeWS.send(JSON.stringify({
          kind: "panel_response",
          request_id: req.request_id,
          action: "edit",
          new_value: input.value,
        }));
        // Restore button row layout for the next gap before hiding.
        btnRow.style.flexDirection = "row";
        btnRow.style.alignItems = "";
        hidePanel();
      }
      function restore() {
        // Bring the button row back without losing the panel.
        btnRow.style.flexDirection = "row";
        btnRow.style.alignItems = "";
        showPanel(req);
      }
      save.addEventListener("click", submit);
      input.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") { ev.preventDefault(); submit(); }
        if (ev.key === "Escape") { ev.preventDefault(); restore(); }
      });
      cancel.addEventListener("click", restore);
      inputRow.appendChild(input);
      inputRow.appendChild(save);
      inputRow.appendChild(cancel);
      btnRow.appendChild(label);
      btnRow.appendChild(inputRow);
      input.focus();
      input.select();
    }
    function hidePanel() {
      if (panel) {
        panel.style.display = "none";
        // Clear left/top (defensive — in case any future code path
        // sets them) and re-establish the bottom-right corner anchor.
        // The right/bottom literals match the modal's initial inline
        // style at the markup site; setting them back here makes the
        // anchor self-healing across hide/show cycles even if some
        // earlier code wiped or overrode them.
        panel.style.left = "";
        panel.style.top = "";
        panel.style.right = "24px";
        panel.style.bottom = "24px";
      }
      activeReq = null;
      removeKeyboardHandler();
      clearSpotlight();
      clearAttachArrows();
      removeAnchorListeners();
    }

    // Phase 3j (#73): anchor the modal near its target cell with dotted
    // arrows pointing at each spotlighted cell.
    let activeAnchorTargets = [];
    function anchorPanelToTargets(provIdsStr) {
      activeAnchorTargets = [];
      if (!panel || !provIdsStr) return false;
      const ids = String(provIdsStr).split(/\s+/).filter(Boolean);
      ids.forEach((pid) => {
        const els = document.querySelectorAll(sel("data-prov-id", pid));
        els.forEach((el) => {
          const r = el.getBoundingClientRect();
          // Only anchor to onscreen cells. Off-screen → fall back to
          // bottom-right (no anchor target chosen).
          if (r.width === 0 || r.height === 0) return;
          if (r.bottom < 0 || r.top > window.innerHeight) return;
          if (r.right < 0 || r.left > window.innerWidth) return;
          activeAnchorTargets.push(el);
        });
      });
      if (activeAnchorTargets.length === 0) return false;
      // Modal stays pinned at the CSS-default bottom-right corner so it
      // never covers spec content. The cell-side spotlight pulse +
      // bezier attach arrows below preserve the modal ↔ target link.
      drawAttachArrows();
      return true;
    }

    function clearAttachArrows() {
      const overlayEl = document.getElementById("arrow-overlay");
      if (!overlayEl) return;
      overlayEl.querySelectorAll(".modal-attach-arrow").forEach((p) => p.remove());
    }

    function drawAttachArrows() {
      clearAttachArrows();
      const overlayEl = document.getElementById("arrow-overlay");
      if (!overlayEl || !panel || activeAnchorTargets.length === 0) return;
      const panelRect = panel.getBoundingClientRect();
      // Anchor on the panel's nearest edge to each target.
      activeAnchorTargets.forEach((targetEl) => {
        const tRect = targetEl.getBoundingClientRect();
        if (!tRect.width) return;
        const tx = tRect.left + tRect.width / 2;
        const ty = tRect.top + tRect.height / 2;
        // Choose anchor on panel: midpoint of nearest side.
        const panelCx = panelRect.left + panelRect.width / 2;
        const panelCy = panelRect.top + panelRect.height / 2;
        let px, py;
        if (tx < panelRect.left) {
          // target is to the left of panel
          px = panelRect.left;
          py = panelCy;
        } else if (tx > panelRect.right) {
          px = panelRect.right;
          py = panelCy;
        } else if (ty < panelRect.top) {
          px = panelCx;
          py = panelRect.top;
        } else {
          px = panelCx;
          py = panelRect.bottom;
        }
        // Cubic bezier with horizontal/vertical control points so the
        // line curves smoothly toward the target.
        const dx = (tx - px);
        const dy = (ty - py);
        const c1x = px + dx * 0.4;
        const c1y = py;
        const c2x = px + dx * 0.6;
        const c2y = ty;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("class", "modal-attach-arrow");
        path.setAttribute("d", `M${px},${py} C${c1x},${c1y} ${c2x},${c2y} ${tx},${ty}`);
        overlayEl.appendChild(path);
      });
    }

    let anchorScrollHandler = null;
    let anchorResizeHandler = null;
    function installAnchorListeners() {
      removeAnchorListeners();
      anchorScrollHandler = () => {
        if (activeAnchorTargets.length > 0) {
          drawAttachArrows();
        }
      };
      anchorResizeHandler = anchorScrollHandler;
      window.addEventListener("scroll", anchorScrollHandler, { passive: true });
      window.addEventListener("resize", anchorResizeHandler);
      // Spec columns scroll independently — listen on each.
      document.querySelectorAll(".col").forEach((c) =>
        c.addEventListener("scroll", anchorScrollHandler, { passive: true })
      );
    }
    function removeAnchorListeners() {
      if (anchorScrollHandler) {
        window.removeEventListener("scroll", anchorScrollHandler);
        document.querySelectorAll(".col").forEach((c) =>
          c.removeEventListener("scroll", anchorScrollHandler)
        );
      }
      if (anchorResizeHandler) {
        window.removeEventListener("resize", anchorResizeHandler);
      }
      anchorScrollHandler = null;
      anchorResizeHandler = null;
      activeAnchorTargets = [];
    }

    // Phase 3b-3 (Group C): pulsing outline on cells named in
    // gap.metadata.spotlight_prov_ids. Independent from .prov-active
    // (hover-driven fill+flip) so the user can hover-explore other
    // cells while the spotlight plays.
    function applySpotlight(provIdsStr) {
      clearSpotlight();
      if (!provIdsStr) return;
      String(provIdsStr).split(/\s+/).filter(Boolean).forEach((pid) => {
        document.querySelectorAll(sel("data-prov-id", pid)).forEach((el) => {
          el.classList.add("prov-spotlight");
        });
      });
    }
    function clearSpotlight() {
      document.querySelectorAll(".prov-spotlight").forEach((el) => {
        el.classList.remove("prov-spotlight");
      });
    }
    function sendPanelResponse(requestId, action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      activeWS.send(JSON.stringify({
        kind: "panel_response",
        request_id: requestId,
        action: action,
      }));
      hidePanel();
    }

    function appendStepBlocks(colSelector, stepDicts, opts) {
      // Replace the column's "(stage not reached)" placeholder with
      // step blocks. Mirrors the Jinja loop's HTML structure exactly
      // so all existing CSS + hover JS apply unchanged.
      //
      // Per ADR-0011 animation-timing addendum (strict-serial): each
      // step gets a slot of duration `stagger`; its block fades in at
      // `slotStart + fadeOffset`. Defaults match the col 1→2 / col 2→3
      // shape (stagger=ARROW_STAGGER, fadeOffset=ARROW_TRACE) — block
      // appears immediately after its arrow finishes. For columns with
      // no arrows (col 3→4), pass stagger=COLUMN_FADE, fadeOffset=0.
      opts = opts || {};
      const stagger = (opts.stagger != null) ? opts.stagger : ARROW_STAGGER_MS;
      const fadeOffset = (opts.fadeOffset != null) ? opts.fadeOffset : ARROW_TRACE_MS;
      const col = document.querySelector(colSelector);
      if (!col || !stepDicts) return;
      // Drop any "(...) not reached" placeholder paragraph.
      col.querySelectorAll("p").forEach((p) => p.remove());
      // Drop any existing step blocks (so re-runs don't duplicate).
      col.querySelectorAll(".step").forEach((s) => s.remove());
      const isValidatedCol = colSelector.includes("validated");
      stepDicts.forEach((step, idx) => {
        const div = document.createElement("div");
        div.className = "step fade-in " + (step.step_class || "");
        div.dataset.stepCited = step.step_cited_text || "";
        div.dataset.stepPalette = step.step_palette_class || "";
        if (step.step_reasoning) div.dataset.stepReasoning = step.step_reasoning;
        if (step.parameters_reasoning) div.dataset.paramsReasoning = step.parameters_reasoning;
        if (step.confidence) div.dataset.confidence = step.confidence;
        if (step.step_trigger_prov_id) div.dataset.provId = step.step_trigger_prov_id;
        // Phase 3i (#72): tag validated-spec blocks with their script
        // step id so the hover-pair handler can highlight matching
        // .code-line elements (and vice-versa).
        if (isValidatedCol) div.dataset.scriptStep = "s" + idx;
        // P1-9: tag every step block (in any column) with its 1-based
        // step.order so the constraint-warning injector can target
        // `.col-validated-spec .step[data-step-order="N"]`. Mirrors the
        // static template's data-step-order attribute.
        if (step.order != null) div.dataset.stepOrder = String(step.order);
        let html = `<div class="step-action">Step ${step.order}: ${escapeHtml(step.action || "")}</div>`;
        (step.detail_lines || []).forEach((line) => {
          html += `<div class="step-detail">${line}</div>`;
        });
        if (step.note_line) html += step.note_line;
        div.innerHTML = html;
        col.appendChild(div);
        const blockDelay = idx * stagger + fadeOffset;
        setTimeout(() => div.classList.add("is-visible"), blockDelay);
      });
      // Re-wire hover handlers so newly-added cells get listeners.
      // The existing wireHover function is idempotent at the listener
      // level for our use case (extra mouseenter listeners on the same
      // element are harmless cosmetically; minor memory overhead is
      // acceptable for v1 — Phase 3b-2 can refactor to event delegation).
      try { wireHover(); } catch (e) { /* defensive */ }
      // Phase 3i (#72): bind the spec→code linkage handlers on newly-
      // inserted validated-spec blocks. Idempotent (data-linkage-bound
      // guard inside).
      try { wireScriptLinkage(); } catch (e) { /* defensive */ }
    }

    // ────────── ADR-0013 Phase 3f: initial-contents batch modal ──────────
    let activeIcRid = null;
    let activeIcInputs = null;   // [{labware, well, inputEl}, ...] — read at submit time

    function showIcModal(req) {
      const overlay = document.getElementById("live-ic-overlay");
      const body = document.getElementById("live-ic-body");
      if (!overlay || !body) return;
      activeIcRid = req.request_id;
      activeIcInputs = [];
      body.innerHTML = "";
      const table = document.createElement("table");
      table.style.cssText = "width: 100%; border-collapse: collapse;";
      const thead = document.createElement("thead");
      thead.innerHTML = '<tr style="text-align: left; border-bottom: 1px solid var(--grid);">'
        + '<th style="padding: 6px 8px; font-weight: 600;">Labware</th>'
        + '<th style="padding: 6px 8px; font-weight: 600;">Well</th>'
        + '<th style="padding: 6px 8px; font-weight: 600;">Substance</th>'
        + '<th style="padding: 6px 8px; font-weight: 600;">Volume (µL)</th>'
        + '</tr>';
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      // Group rows by labware, preserving order-of-first-appearance.
      // PDF p.1 Diagram 1: rows belonging to the same container should
      // visually cluster under one labware label, with a clear border
      // separating one group from the next, so the user can scan
      // "everything in tube rack" without re-reading the labware name
      // on every line.
      const groupOrder = [];
      const groups = new Map();
      (req.rows || []).forEach((row) => {
        const key = row.labware || "";
        if (!groups.has(key)) {
          groupOrder.push(key);
          groups.set(key, []);
        }
        groups.get(key).push(row);
      });
      groupOrder.forEach((labware, groupIdx) => {
        const members = groups.get(labware);
        members.forEach((row, memberIdx) => {
          const tr = document.createElement("tr");
          tr.style.cssText = "border-bottom: 1px solid var(--grid);";
          // First row of each group after the first carries a thicker
          // top border so the eye registers the group boundary.
          if (memberIdx === 0 && groupIdx > 0) {
            tr.style.borderTop = "2px solid var(--rule, var(--grid))";
          }
          // Labware cell is rendered once per group, spanning every
          // member row via rowspan. Subsequent rows skip the cell
          // entirely so the rowspan visually fills the column.
          if (memberIdx === 0) {
            const tdLabware = document.createElement("td");
            tdLabware.rowSpan = members.length;
            tdLabware.style.cssText = "padding: 6px 8px; vertical-align: top; font-weight: 500;";
            tdLabware.textContent = labware;
            tr.appendChild(tdLabware);
          }
          const tdWell = document.createElement("td");
          tdWell.style.cssText = "padding: 6px 8px; vertical-align: top;";
          tdWell.textContent = row.well || "(all wells)";
          const tdSubstance = document.createElement("td");
          tdSubstance.style.cssText = "padding: 6px 8px; vertical-align: top; font-style: italic; color: var(--dim);";
          tdSubstance.textContent = row.substance || "";
          const tdVol = document.createElement("td");
          tdVol.style.cssText = "padding: 6px 8px; vertical-align: top;";
          const input = document.createElement("input");
          input.type = "number";
          input.step = "any";
          input.min = "0";
          input.style.cssText = "width: 100%; padding: 4px 6px; font-size: 13px; border: 1px solid var(--btn-secondary-border); border-radius: 4px; font-family: var(--font-mono);";
          // Pre-fill: extracted current value wins; else suggester output;
          // else empty for the user to type.
          const initial = (row.current_volume_ul !== null && row.current_volume_ul !== undefined)
            ? row.current_volume_ul
            : (row.suggested_volume_ul !== null && row.suggested_volume_ul !== undefined)
                ? row.suggested_volume_ul
                : "";
          input.value = initial === "" ? "" : String(initial);
          // Visual hint: italic + dim for suggester defaults so user sees
          // they were filled by the system, not the instruction.
          const isDefault = (
            (row.current_volume_ul === null || row.current_volume_ul === undefined)
            && row.suggested_volume_ul !== null
            && row.suggested_volume_ul !== undefined
          );
          if (isDefault) {
            input.style.color = "var(--col-inferred)";
            input.style.fontStyle = "italic";
            input.addEventListener("input", () => {
              input.style.color = "var(--ink)";
              input.style.fontStyle = "normal";
            }, { once: true });
          }
          tdVol.appendChild(input);
          // Per-row caption. Two mutually-exclusive branches:
          //   (a) Suggester-defaulted rows: surface the suggester's own
          //       positive_reasoning so different rows can carry different
          //       explanations (capacity default vs carryover vs config
          //       lookup) instead of identical boilerplate.
          //   (b) User-stated rows: surface the verbatim instruction
          //       substring the LLM cited when extracting volume_ul, so
          //       the user can cross-check the system's reading against
          //       their own wording (CARRY-B1, PDF p.1 "1C of 50 — nothing
          //       for user to cross-check"). Falls back to no caption if
          //       the LLM didn't populate volume_ul_provenance.
          if (isDefault && row.provenance_reasoning) {
            const hint = document.createElement("div");
            hint.style.cssText = "margin-top: 4px; font-size: 11px; font-style: italic; color: var(--dim); line-height: 1.4;";
            hint.textContent = row.provenance_reasoning;
            tdVol.appendChild(hint);
          } else if (!isDefault && row.user_cited_text) {
            const hint = document.createElement("div");
            hint.style.cssText = "margin-top: 4px; font-size: 11px; font-style: italic; color: var(--dim); line-height: 1.4;";
            hint.textContent = "from your instruction: \u201C" + row.user_cited_text + "\u201D";
            tdVol.appendChild(hint);
          }
          tr.appendChild(tdWell);
          tr.appendChild(tdSubstance);
          tr.appendChild(tdVol);
          tbody.appendChild(tr);
          activeIcInputs.push({
            labware: row.labware,
            well: row.well,
            inputEl: input,
          });
        });
      });
      table.appendChild(tbody);
      body.appendChild(table);
      overlay.style.display = "flex";
    }
    function hideIcModal() {
      const overlay = document.getElementById("live-ic-overlay");
      if (overlay) overlay.style.display = "none";
      activeIcRid = null;
      activeIcInputs = null;
    }
    function sendIcResponse(action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      if (!activeIcRid) return;
      const volumes = [];
      if (action === "confirm" && activeIcInputs) {
        for (const row of activeIcInputs) {
          const raw = row.inputEl.value.trim();
          if (raw === "") {
            alert('Enter a volume for "' + row.labware + ' / ' + row.well + '" before confirming.');
            return;
          }
          const v = parseFloat(raw);
          if (Number.isNaN(v) || v < 0) {
            alert('Invalid volume for "' + row.labware + ' / ' + row.well + '": ' + raw);
            return;
          }
          volumes.push({ labware: row.labware, well: row.well, volume_ul: v });
        }
      }
      activeWS.send(JSON.stringify({
        kind: "initial_contents_response",
        request_id: activeIcRid,
        action: action,
        volumes: volumes,
      }));
      hideIcModal();
    }

    // ────────── ADR-0013 Phase 3e: binary-confirm modal ──────────
    let activeBinaryRid = null;
    function showBinaryModal(req) {
      const overlay = document.getElementById("live-binary-overlay");
      const title = document.getElementById("live-binary-title");
      const body = document.getElementById("live-binary-body");
      const yes = document.getElementById("live-binary-yes");
      const no = document.getElementById("live-binary-no");
      if (!overlay || !title || !body || !yes || !no) return;
      activeBinaryRid = req.request_id;
      title.textContent = req.title || "Confirm";
      body.innerHTML = "";
      const ul = document.createElement("ul");
      ul.style.cssText = "margin: 0 0 4px 0; padding-left: 18px;";
      (req.items || []).forEach((item) => {
        const li = document.createElement("li");
        li.style.cssText = "margin: 2px 0;";
        li.textContent = String(item);
        ul.appendChild(li);
      });
      body.appendChild(ul);
      yes.textContent = req.yes_label || "Yes";
      no.textContent = req.no_label || "No";
      overlay.style.display = "flex";
    }
    function hideBinaryModal() {
      const overlay = document.getElementById("live-binary-overlay");
      if (overlay) overlay.style.display = "none";
      activeBinaryRid = null;
    }
    function sendBinaryResponse(action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      if (!activeBinaryRid) return;
      activeWS.send(JSON.stringify({
        kind: "binary_confirm_response",
        request_id: activeBinaryRid,
        action: action,
      }));
      hideBinaryModal();
    }

    // ────────── ADR-0013 Phase 3d: labware-assignments modal ──────────
    // Single in-flight request per pipeline run, so this just tracks the
    // current request_id + a {description: <select-element>} map for
    // reading user picks at submit time.
    let activeAssignmentsRid = null;
    let activeAssignmentsSelects = null;

    function showAssignmentsModal(req) {
      const overlay = document.getElementById("live-assignments-overlay");
      const body = document.getElementById("live-assignments-body");
      if (!overlay || !body) return;
      activeAssignmentsRid = req.request_id;
      activeAssignmentsSelects = {};
      body.innerHTML = "";
      const table = document.createElement("table");
      table.style.cssText = "width: 100%; border-collapse: collapse;";
      const thead = document.createElement("thead");
      thead.innerHTML = '<tr style="text-align: left; border-bottom: 1px solid var(--grid);">'
        + '<th style="padding: 6px 8px; font-weight: 600;">Description (from instruction)</th>'
        + '<th style="padding: 6px 8px; font-weight: 600;">Config label</th>'
        + '</tr>';
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      (req.assignments || []).forEach((row) => {
        const tr = document.createElement("tr");
        tr.style.cssText = "border-bottom: 1px solid var(--grid);";
        const descCell = document.createElement("td");
        descCell.style.cssText = "padding: 8px 8px; vertical-align: top;";
        descCell.textContent = row.description;
        const labelCell = document.createElement("td");
        labelCell.style.cssText = "padding: 6px 8px; vertical-align: top;";
        const select = document.createElement("select");
        select.style.cssText = "width: 100%; padding: 4px 6px; font-size: 13px; border: 1px solid var(--btn-secondary-border); border-radius: 4px;";
        // Empty option for unresolved; only used when no candidates match.
        if (!row.suggested_label) {
          const opt = document.createElement("option");
          opt.value = "";
          opt.textContent = "??? (no match)";
          opt.selected = true;
          select.appendChild(opt);
        }
        (row.candidates || []).forEach((label) => {
          const opt = document.createElement("option");
          opt.value = label;
          opt.textContent = label;
          if (label === row.suggested_label) opt.selected = true;
          select.appendChild(opt);
        });
        labelCell.appendChild(select);
        // Per-row reasoning hint surfacing the resolver's positive_reasoning.
        // Only rendered when the resolver had a suggestion (no reasoning to
        // show when the user is picking from scratch). Mirrors the IC
        // modal's per-row hint shape so the two modals feel coherent.
        if (row.positive_reasoning) {
          const hint = document.createElement("div");
          hint.style.cssText = "margin-top: 4px; font-size: 11px; font-style: italic; color: var(--dim); line-height: 1.4;";
          hint.textContent = row.positive_reasoning;
          labelCell.appendChild(hint);
        }
        tr.appendChild(descCell);
        tr.appendChild(labelCell);
        tbody.appendChild(tr);
        activeAssignmentsSelects[row.description] = select;
      });
      table.appendChild(tbody);
      body.appendChild(table);
      overlay.style.display = "flex";
    }
    function hideAssignmentsModal() {
      const overlay = document.getElementById("live-assignments-overlay");
      if (overlay) overlay.style.display = "none";
      activeAssignmentsRid = null;
      activeAssignmentsSelects = null;
    }
    function sendAssignmentsResponse(action) {
      if (!activeWS || activeWS.readyState !== WebSocket.OPEN) return;
      if (!activeAssignmentsRid) return;
      const assignments = {};
      if (action === "confirm" && activeAssignmentsSelects) {
        // Block confirm if any row is still unresolved (empty value).
        for (const [desc, sel] of Object.entries(activeAssignmentsSelects)) {
          if (!sel.value) {
            alert("Assign every row before confirming. \"" + desc + "\" is unresolved.");
            return;
          }
          assignments[desc] = sel.value;
        }
      }
      activeWS.send(JSON.stringify({
        kind: "labware_assignments_response",
        request_id: activeAssignmentsRid,
        action: action,
        assignments: assignments,
      }));
      hideAssignmentsModal();
    }

    function updatePanelMeta(panel, rows, singularLabel, pluralLabel) {
      // Refresh the count badge + is-empty class. Per ADR-0011
      // animation-timing addendum (2026-05-06), panels stay collapsed
      // by default regardless of populated state — auto-expanding on
      // first-row arrival shifts the column grid downward and offsets
      // any arrows already drawn against the pre-shift layout. The
      // user can still expand manually via chevron toggle.
      if (!panel) return;
      const count = rows ? rows.length : 0;
      const countEl = panel.querySelector(".panel-count");
      if (countEl) {
        const word = count === 1 ? singularLabel : pluralLabel;
        countEl.textContent = count + " " + word;
      }
      if (count === 0) {
        panel.classList.add("is-empty");
      } else {
        panel.classList.remove("is-empty");
      }
    }

    function updateLabStatePanel(rows) {
      // Phase 3b-3 (Group C, revised): rebuild the lab-state panel's
      // BODY to match the static-path Jinja loop exactly so existing
      // CSS + panel-row hover JS (data-target-cells) work unchanged.
      // Header + chevron + count badge stay; only the table content
      // inside .panel-body gets swapped.
      const panel = document.querySelector(".panels .panel-lab-state");
      if (!panel) return;
      const body = panel.querySelector(".panel-body");
      if (!body) return;
      body.querySelectorAll("table, .empty").forEach((el) => el.remove());
      if (!rows || rows.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = "(no initial-state entries)";
        body.appendChild(empty);
        updatePanelMeta(panel, rows, "entry", "entries");
        return;
      }
      const table = document.createElement("table");
      const thead = document.createElement("thead");
      thead.innerHTML = '<tr><th>labware</th><th>well</th><th>substance</th><th>volume</th></tr>';
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      rows.forEach((row) => {
        const tr = document.createElement("tr");
        if (row.target_prov_ids) tr.dataset.targetCells = row.target_prov_ids;
        const wellText = row.kind === "well" ? (row.well || "") : "(all wells)";
        const volText = (row.volume_ul !== null && row.volume_ul !== undefined)
          ? Math.round(row.volume_ul) + " uL" : "—";
        const tdLabware = document.createElement("td");
        tdLabware.className = "col-label";
        tdLabware.textContent = row.labware || "";
        const tdWell = document.createElement("td");
        tdWell.textContent = wellText;
        const tdSubstance = document.createElement("td");
        tdSubstance.className = "col-substance";
        tdSubstance.textContent = row.substance || "";
        const tdVol = document.createElement("td");
        tdVol.className = "col-volume";
        tdVol.textContent = volText;
        tr.appendChild(tdLabware);
        tr.appendChild(tdWell);
        tr.appendChild(tdSubstance);
        tr.appendChild(tdVol);
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      body.appendChild(table);
      updatePanelMeta(panel, rows, "entry", "entries");
    }

    function updateLabwareMappingPanel(rows) {
      // Phase 3b-3 (Group C, revised): rebuild the labware-mapping
      // panel's BODY to match the static-path Jinja loop exactly.
      const panel = document.querySelector(".panels .panel-labware-mapping");
      if (!panel) return;
      const body = panel.querySelector(".panel-body");
      if (!body) return;
      body.querySelectorAll("table, .empty").forEach((el) => el.remove());
      if (!rows || rows.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty";
        empty.textContent = "(no labware references)";
        body.appendChild(empty);
        updatePanelMeta(panel, rows, "mapping", "mappings");
        return;
      }
      const table = document.createElement("table");
      const thead = document.createElement("thead");
      thead.innerHTML = '<tr><th>user wording</th><th>config label</th></tr>';
      table.appendChild(thead);
      const tbody = document.createElement("tbody");
      rows.forEach((row) => {
        const tr = document.createElement("tr");
        if (row.target_prov_ids) tr.dataset.targetCells = row.target_prov_ids;
        const tdDesc = document.createElement("td");
        tdDesc.className = "col-description";
        tdDesc.textContent = '"' + (row.description || "") + '"';
        const tdLabel = document.createElement("td");
        tdLabel.className = "col-label";
        tdLabel.textContent = row.resolved_label || "(unresolved)";
        tr.appendChild(tdDesc);
        tr.appendChild(tdLabel);
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      body.appendChild(table);
      updatePanelMeta(panel, rows, "mapping", "mappings");
    }

    // P1-9: parse "[WARN] Step N: ..." prefix client-side. Mirrors the
    // Python `_split_warnings_by_step` helper so live + static paths route
    // warnings identically.
    const WARN_STEP_RE = /^\s*\[WARN\]\s+Step\s+(\d+)\s*:/i;
    function splitWarningsByStep(warnings) {
      const perStep = new Map();  // step_order(int) -> [warning, ...]
      const globalWarns = [];
      warnings.forEach((w) => {
        const m = WARN_STEP_RE.exec(String(w));
        if (m) {
          const n = parseInt(m[1], 10);
          if (n >= 1) {
            if (!perStep.has(n)) perStep.set(n, []);
            perStep.get(n).push(w);
            return;
          }
        }
        globalWarns.push(w);
      });
      return { perStep, globalWarns };
    }

    function updateValidatedSummary(data) {
      // Phase 3i (#72): mirror the static-path Jinja render exactly so
      // the banner reads the same in live + archived reports. Three
      // states: clean (green), warnings only (tan), errors (red).
      // P1-9: route per-step warnings inline into the matching step
      // row; only Step 0 / unparseable warnings remain in the top list.
      const banner = document.getElementById("validated-summary");
      if (!banner || !data) return;
      const vc = data.violation_count || 0;
      const warnings = Array.isArray(data.warnings) ? data.warnings : [];
      const wc = warnings.length;
      const { perStep, globalWarns } = splitWarningsByStep(warnings);
      banner.classList.remove("is-empty");
      let lineClass, html;
      if (vc > 0) {
        lineClass = "has-errors";
        html = '<strong style="color: var(--col-instruction);">✗ ' + vc + ' violation' + (vc === 1 ? '' : 's') + '</strong> — protocol does not validate';
      } else if (wc > 0) {
        lineClass = "has-warnings";
        html = '<strong style="color: var(--warning-accent);">✓ 0 violations, ' + wc + ' warning' + (wc === 1 ? '' : 's') + '</strong> — protocol validated';
      } else {
        lineClass = "all-clear";
        html = '<strong style="color: var(--check-pill-glyph);">✓ 0 violations</strong> — protocol validated';
      }
      let body = '<div class="validated-summary-line ' + lineClass + '">' + html + '</div>';
      if (globalWarns.length > 0) {
        body += '<ul class="validated-summary-warnings">';
        globalWarns.forEach((w) => {
          body += '<li>' + escapeHtml(String(w)) + '</li>';
        });
        body += '</ul>';
      }
      banner.innerHTML = body;

      // P1-9: inject per-step warnings into their step rows. Clears any
      // prior .step-warning blocks first so re-runs don't duplicate.
      const col = document.querySelector(".col-validated-spec");
      if (!col) return;
      col.querySelectorAll(".step-warning").forEach((el) => el.remove());
      perStep.forEach((stepWarnings, stepOrder) => {
        const stepEl = col.querySelector('.step[data-step-order="' + stepOrder + '"]');
        if (!stepEl) return;
        const wrap = document.createElement("div");
        wrap.className = "step-warning";
        stepWarnings.forEach((w) => {
          const line = document.createElement("div");
          line.className = "step-warning-line";
          line.textContent = String(w);
          wrap.appendChild(line);
        });
        stepEl.appendChild(wrap);
      });
    }

    function updateBulkPanels(data) {
      if (!data) return;
      if (Array.isArray(data.lab_state_rows)) {
        updateLabStatePanel(data.lab_state_rows);
      }
      if (Array.isArray(data.labware_mapping_rows)) {
        updateLabwareMappingPanel(data.labware_mapping_rows);
      }
      // Re-wire the panel-row hover handlers (data-target-cells) and
      // the panel-header collapse handlers so newly-inserted rows /
      // re-rendered sections pick up listeners.
      try { wireHover(); } catch (e) { /* defensive */ }
      try { wirePanelToggles(); } catch (e) { /* defensive */ }
    }

    // ────────── ADR-0013 Phase 3g (Group B): stage indicator + column gating ──────────
    // Per-stage "what's currently happening" sub-line catalogs. Real
    // events drive sub-line where they exist (orchestrator iterations,
    // LLM calls, modal sequence). For deterministic stages with no
    // natural sub-events (constraint check, build/sim) we cycle through
    // the catalog every ~900ms so the user sees the work even though
    // the underlying function ran end-to-end.
    const STAGE_CATALOGS = {
      6: ["checking pipette capacity",
           "checking labware resolution",
           "checking well validity",
           "checking module availability",
           "checking labware-on-module compatibility",
           "checking tip sufficiency"],
    };
    let activeStageNumber = null;
    let catalogIntervalId = null;

    function setIndicatorMain(text) {
      const el = document.getElementById("indicator-stage-text");
      if (el) el.textContent = text;
    }
    function setIndicatorSub(text) {
      const el = document.getElementById("indicator-substep");
      if (el) el.textContent = text || "";
    }
    function startCatalogCycle(stageNumber) {
      stopCatalogCycle();
      const catalog = STAGE_CATALOGS[stageNumber];
      if (!catalog || catalog.length === 0) return;
      let idx = 0;
      setIndicatorSub(catalog[idx]);
      catalogIntervalId = setInterval(() => {
        idx = (idx + 1) % catalog.length;
        setIndicatorSub(catalog[idx]);
      }, 900);
    }
    function stopCatalogCycle() {
      if (catalogIntervalId) {
        clearInterval(catalogIntervalId);
        catalogIntervalId = null;
      }
    }
    function handleStageStarted(data) {
      if (!data) return;
      activeStageNumber = data.number;
      const total = data.total || 7;
      const name = data.name || "";
      setIndicatorMain("Stage " + data.number + " of " + total + " — " + name);
      // Real progress events take precedence; if a stage has a catalog
      // and no real event arrives first, we cycle.
      stopCatalogCycle();
      setIndicatorSub("");
      if (STAGE_CATALOGS[data.number]) {
        startCatalogCycle(data.number);
      }
    }
    function handlePipelineProgress(data) {
      if (!data || !data.message) return;
      // Real event arrived — drop any catalog cycle.
      stopCatalogCycle();
      setIndicatorSub(data.message);
    }
    function markIndicatorDone() {
      stopCatalogCycle();
      const indicator = document.getElementById("live-stage-indicator");
      if (indicator) indicator.classList.add("is-done");
      setIndicatorMain("Run complete");
      setIndicatorSub("");
    }

    // Column-gating helpers. Each spec column starts hidden in live
    // mode; reveal on the event that produces its content. Grid template
    // adapts via the .cols-N class on the parent .grid.
    function revealCol(selector) {
      const col = document.querySelector(selector);
      if (!col || !col.classList.contains("is-pending")) return;
      col.classList.remove("is-pending");
      const grid = document.querySelector(".grid");
      if (!grid) return;
      const visible = grid.querySelectorAll(".col:not(.is-pending)").length;
      grid.classList.remove("cols-1", "cols-2", "cols-3", "cols-4", "cols-5");
      grid.classList.add("cols-" + Math.max(1, Math.min(5, visible)));
      try { scheduleRender(); } catch (e) { /* defensive */ }
    }

    function updateInstructionColumn(html) {
      // Phase 3b-2: replace the instruction column's content with the
      // server-rendered cite-marked HTML. Anchor spans (data-cite-id)
      // are now in the DOM so step-trigger arrows have something to
      // point from. Re-wires hover handlers since we mutated the
      // listeners' targets.
      const el = document.querySelector(".col .instruction-text");
      if (!el || !html) return;
      el.innerHTML = html;
      try { wireHover(); } catch (e) { /* defensive */ }
    }

    function updateResolutionArrows(arrows) {
      // Phase 3b-2: replace the embedded JSON the static path uses so
      // the existing renderResolutionArrows() reads the new set on the
      // next scheduleRender() tick.
      const el = document.getElementById("resolution-arrows-data");
      if (!el || !Array.isArray(arrows)) return;
      el.textContent = JSON.stringify(arrows);
    }

    // Column-animation gate. Per ADR-0011 strict-serial spec: each
    // spec/script event triggering a column animation queues behind
    // the previous one. `columnAnimationDoneAt` is the performance.now()
    // timestamp when the most-recently-scheduled column finishes; the
    // next column's animation starts at exactly that time (or now, if
    // the previous already finished).
    let columnAnimationDoneAt = 0;

    function gateColumn(fn, durationMs) {
      const now = performance.now();
      const startAt = Math.max(now, columnAnimationDoneAt);
      const wait = startAt - now;
      setTimeout(fn, wait);
      columnAnimationDoneAt = startAt + durationMs;
    }

    // Modal gating: defer a modal show until the most-recent spec
    // column has finished animating. The pipeline thread on the server
    // is already blocked waiting for the user's response — the modal
    // arrives over the WebSocket as soon as the pipeline emits it,
    // but if column N is still mid-animation we hold the modal back
    // so the user can finish reading the column first. Avoids
    // confusion where a modal asks about cells that haven't rendered
    // yet (e.g. IC volumes referencing labware whose step block is
    // still 5 slots away from fading in).
    function gateModal(showFn) {
      const delay = Math.max(0, columnAnimationDoneAt - performance.now());
      if (delay <= 0) {
        showFn();
      } else {
        setTimeout(showFn, delay);
      }
    }

    // Per-column duration formula. Slot is per-step time; tail is the
    // last block's fade. For col 3→4 (no arrows) callers pass smaller
    // slot via opts to appendStepBlocks AND a matching duration here.
    function colDurationMs(stepCount, slotMs) {
      const slot = (slotMs != null) ? slotMs : ARROW_STAGGER_MS;
      return Math.max(0, stepCount) * slot + COLUMN_FADE_MS;
    }

    function handleEvent(e) {
      switch (e.kind) {
        case "raw_instruction":
          // Plain-text preview while we wait for the first spec event.
          // Once the spec arrives, updateInstructionColumn replaces this
          // with the cite-marked HTML.
          const instrCol = document.querySelector(".col .instruction-text");
          if (instrCol && e.data && e.data.instruction) {
            instrCol.textContent = e.data.instruction;
          }
          break;
        case "stage_started":
          handleStageStarted(e.data);
          break;
        case "pipeline_progress":
          handlePipelineProgress(e.data);
          break;
        case "extracted_spec": {
          const data = e.data || {};
          const steps = data.steps || [];
          gateColumn(() => {
            revealCol(".col-extracted-spec");
            appendStepBlocks(".col-extracted-spec", steps);
            if (data.instruction_html) updateInstructionColumn(data.instruction_html);
            updateBulkPanels(data);
            try { scheduleRender(); } catch (err) { /* defensive */ }
          }, colDurationMs(steps.length));
          break;
        }
        case "resolved_spec": {
          const data = e.data || {};
          const steps = data.steps || [];
          gateColumn(() => {
            revealCol(".col-resolved-spec");
            appendStepBlocks(".col-resolved-spec", steps);
            if (data.instruction_html) updateInstructionColumn(data.instruction_html);
            updateBulkPanels(data);
            // Schedule a render + step-keyed arrow trigger on next rAF
            // so the just-appended blocks have layout positions before
            // we anchor + start arrow traces.
            requestAnimationFrame(() => {
              try { renderArrows(); } catch (err) {}
              try { renderResolutionArrows(); } catch (err) {}
              try { runResolutionColumnAnimation(); } catch (err) {}
            });
          }, colDurationMs(steps.length));
          break;
        }
        case "completed_spec": {
          const data = e.data || {};
          const steps = data.steps || [];
          // Col 3→4 has no arrows. Compress the slot to just the fade
          // duration so blocks reveal one-by-one without the dead
          // arrow-trace gap.
          gateColumn(() => {
            revealCol(".col-validated-spec");
            appendStepBlocks(".col-validated-spec", steps,
              { stagger: COLUMN_FADE_MS, fadeOffset: 0 });
            if (data.instruction_html) updateInstructionColumn(data.instruction_html);
            updateBulkPanels(data);
            try { scheduleRender(); } catch (err) { /* defensive */ }
          }, colDurationMs(steps.length, COLUMN_FADE_MS));
          break;
        }
        case "gap_resolved":
          if (e.data && Array.isArray(e.data.resolution_arrows)) {
            updateResolutionArrows(e.data.resolution_arrows);
          }
          break;
        case "constraint_check_done":
          updateValidatedSummary(e.data);
          break;
        case "generated_script": {
          const data = e.data || {};
          gateColumn(() => {
            revealCol(".col-generated-code");
            const codeCol = document.querySelector(".col-generated-code")
                           || document.querySelectorAll(".col")[4];
            if (codeCol && (data.script_html || data.script)) {
              codeCol.querySelectorAll("p").forEach((p) => p.remove());
              codeCol.querySelectorAll("pre.code").forEach((p) => p.remove());
              const pre = document.createElement("pre");
              pre.className = "code";
              if (data.script_html) {
                pre.innerHTML = data.script_html;
              } else {
                pre.textContent = data.script;
              }
              codeCol.appendChild(pre);
              try { wireScriptLinkage(); } catch (err) { /* defensive */ }
            }
            try { scheduleRender(); } catch (err) { /* defensive */ }
          }, COLUMN_FADE_MS + 200);
          break;
        }
        case "panel_request":
          if (e.data) gateModal(() => showPanel(e.data));
          break;
        case "labware_assignments_request":
          if (e.data) gateModal(() => showAssignmentsModal(e.data));
          break;
        case "binary_confirm_request":
          if (e.data) gateModal(() => showBinaryModal(e.data));
          break;
        case "initial_contents_request":
          if (e.data) gateModal(() => showIcModal(e.data));
          break;
        case "pipeline_done":
          setStatus("done", "success");
          startBtn.disabled = false;
          hidePanel();
          markIndicatorDone();
          break;
        case "error":
          setStatus("error", "error");
          break;
      }
      // After any DOM mutation, re-render arrows so existing red
      // composite-step arrows track their new anchors. Note: gated
      // events do their own scheduleRender inside the gate's fn; this
      // trailing call only matters for non-gated events (gap_resolved,
      // panel_request, etc.).
      try { scheduleRender(); } catch (err) { /* defensive */ }
    }

    function connectWS() {
      const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
      const url = proto + "//" + window.location.host + "/events";
      const ws = new WebSocket(url);
      activeWS = ws;
      ws.onopen = () => { /* connection established; no-op */ };
      ws.onmessage = (msg) => {
        try {
          handleEvent(JSON.parse(msg.data));
        } catch (err) { /* parse error — skip */ }
      };
      ws.onerror = () => { setStatus("ws error", "error"); };
      ws.onclose = () => { activeWS = null; };
    }

    // Assignments-modal button handlers (set up once; the buttons live
    // for the lifetime of the page).
    const assignConfirm = document.getElementById("live-assignments-confirm");
    const assignAbort = document.getElementById("live-assignments-abort");
    if (assignConfirm) assignConfirm.addEventListener("click", () => sendAssignmentsResponse("confirm"));
    if (assignAbort) assignAbort.addEventListener("click", () => sendAssignmentsResponse("abort"));
    // Binary-confirm button handlers (also set up once).
    const binYes = document.getElementById("live-binary-yes");
    const binNo = document.getElementById("live-binary-no");
    if (binYes) binYes.addEventListener("click", () => sendBinaryResponse("yes"));
    if (binNo) binNo.addEventListener("click", () => sendBinaryResponse("no"));
    // Initial-contents modal button handlers.
    const icConfirm = document.getElementById("live-ic-confirm");
    const icAbort = document.getElementById("live-ic-abort");
    if (icConfirm) icConfirm.addEventListener("click", () => sendIcResponse("confirm"));
    if (icAbort) icAbort.addEventListener("click", () => sendIcResponse("abort"));

    // Populate examples dropdown on load.
    const exampleSelect = document.getElementById("live-example-select");
    fetch("/examples").then(r => r.json()).then(data => {
      (data.examples || []).forEach(name => {
        const opt = document.createElement("option");
        opt.value = name;
        opt.textContent = name;
        exampleSelect.appendChild(opt);
      });
    }).catch(() => { /* non-fatal */ });

    // Toggle upload group; mutually exclusive with example pick.
    const uploadToggle = document.getElementById("live-upload-toggle");
    const uploadGroup = document.getElementById("live-upload-group");
    let uploadMode = false;
    if (uploadToggle) {
      uploadToggle.addEventListener("click", () => {
        uploadMode = !uploadMode;
        uploadGroup.style.display = uploadMode ? "flex" : "none";
        uploadToggle.textContent = uploadMode ? "Use an example instead" : "Upload your own…";
        if (uploadMode) exampleSelect.value = "";
      });
    }
    if (exampleSelect) {
      exampleSelect.addEventListener("change", () => {
        if (exampleSelect.value && uploadMode) {
          uploadMode = false;
          uploadGroup.style.display = "none";
          uploadToggle.textContent = "Upload your own…";
        }
      });
    }

    async function readFileText(input) {
      if (!input || !input.files || !input.files[0]) return null;
      return await input.files[0].text();
    }

    const LOCAL_DEV_MODE = {{ local_dev_mode|tojson if local_dev_mode is defined else 'false' }};

    startBtn.addEventListener("click", async () => {
      const apiKey = (document.getElementById("live-api-key").value || "").trim();
      if (!apiKey && !LOCAL_DEV_MODE) {
        setStatus("API key required", "error");
        return;
      }

      let instruction, config;
      try {
        if (uploadMode) {
          const instText = await readFileText(document.getElementById("live-instruction-file"));
          const configText = await readFileText(document.getElementById("live-config-file"));
          if (!instText) { setStatus("instruction file required", "error"); return; }
          if (!configText) { setStatus("config file required", "error"); return; }
          instruction = instText;
          try { config = JSON.parse(configText); }
          catch (e) { setStatus("invalid config JSON", "error"); return; }
        } else if (exampleSelect.value) {
          const [instResp, configResp] = await Promise.all([
            fetch("/examples/" + encodeURIComponent(exampleSelect.value) + "/instruction"),
            fetch("/examples/" + encodeURIComponent(exampleSelect.value) + "/config"),
          ]);
          if (!instResp.ok || !configResp.ok) {
            setStatus("failed to load example", "error");
            return;
          }
          instruction = await instResp.text();
          config = await configResp.json();
        } else {
          setStatus("pick an example or upload files", "error");
          return;
        }
      } catch (err) {
        setStatus("input read error", "error");
        return;
      }

      startBtn.disabled = true;
      setStatus("starting...", "warn");
      try {
        const r = await fetch("/start", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ instruction, config, api_key: apiKey }),
        });
        const j = await r.json();
        if (j.status === "started") {
          setStatus("running", "warn");
        } else if (j.status === "already_running") {
          setStatus("demo busy — try again in a few minutes", "warn");
          startBtn.disabled = false;
        } else {
          setStatus("error: " + (j.message || "start failed"), "error");
          startBtn.disabled = false;
        }
      } catch (err) {
        setStatus("network error", "error");
        startBtn.disabled = false;
      }
    });

    connectWS();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLiveMode);
  } else {
    initLiveMode();
  }
})();
</script>

</body>
</html>
